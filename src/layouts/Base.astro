---
import '../styles/global.css';
import '../styles/figures.css';
import '../styles/chips.css';
import Icon from '../components/Icon.astro';
import Head from '../components/Head.astro';
import '../styles/tokens.css';
import type { IconName } from '../lib/icons';

import type { Props as HeadProps } from '../components/Head.astro';
type Props = HeadProps;

const mainNav: { href: string; label: string; icon: IconName }[] = [
  { href: '/posts/',    label: 'Posts',    icon: 'writing' },
  { href: '/work/',     label: 'Work',     icon: 'work' },
  { href: '/projects/', label: 'Projects', icon: 'projects' },
  { href: '/about/',    label: 'About',    icon: 'about' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const n = href.replace(/\/$/, '') || '/';
  return current === n || (n !== '/' && current.startsWith(n));
};

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <div class="app-window">
      <div class="frame">
        <header class="site-header">
          <a href="/" class="site-brand" aria-label="Derek Castelli — Home" data-url-chip="Derek Castelli">
            <img src="/assets/brand/signature.svg" alt="" class="site-brand__sig" />
            <span class="site-brand__text">
              <span class="site-brand__name">Derek Castelli</span>
            </span>
          </a>
          <nav class="site-nav" aria-label="Primary">
            {mainNav.map(({ href, label, icon }) => (
              <a
                href={href}
                class={isActive(href) ? 'active' : ''}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                <Icon name={icon} />
                {label}
              </a>
            ))}
          </nav>
        </header>

        <main class="main">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="footer-links">
            <a href="mailto:derekj@hey.com">Email</a>
            <a href="https://x.com/heyderekj" target="_blank" rel="noopener">X.com</a>
            <a href="https://github.com/heyderekj" target="_blank" rel="noopener">GitHub</a>
            <a href="/rss.xml">RSS</a>
            <a href="/colophon/">Colophon</a>
          </div>
          <div class="footer-version">&copy; {year}</div>
        </footer>
      </div>
    </div>
  <script src="../client/url-chip.ts"></script>
  <script src="../client/easter-egg.ts"></script>
  <script src="../client/plyr-init.ts"></script>
  <script src="../client/zoom.ts"></script>
  <script src="../client/figures.ts"></script>
  <script src="../client/accordion.ts"></script>
  <script src="../client/copy.ts"></script>
  <script src="../client/media-prefetch.ts"></script>
  <script src="../client/reveal.ts"></script>
  <script src="../client/icon-morph.ts"></script>
</body>
</html>
