---
import PostTypePage from '../../../components/site/PostTypePage.astro';
import { getPublishedPosts, TYPE_LABELS, type PostType } from '../../../lib/posts';

// Notes and links; the long-form posts live at /posts/ (pages/posts/index.astro)
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return (Object.keys(TYPE_LABELS) as PostType[])
    .filter((type) => type !== 'essay' && posts.some((p) => p.data.type === type))
    .map((type) => ({ params: { type: TYPE_LABELS[type].path }, props: { type } }));
}

interface Props {
  type: PostType;
}
---
<PostTypePage type={Astro.props.type} />
