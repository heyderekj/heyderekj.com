---
import Site from '../../layouts/Site.astro';
import Signature from '../../components/Signature.astro';
import KeepReading from '../../components/site/KeepReading.astro';
import Icon from '../../components/Icon.astro';
import Callout from '../../components/post/Callout.astro';
import { postComponents } from '../../components/post';
import { schemaPersonId } from '../../lib/schemaIds';
import {
  adjacentPosts,
  getPublishedPosts,
  postHref,
  postTitle,
  relatedPosts,
  TYPE_LABELS,
  typeHref,
  type Post,
} from '../../lib/posts';
import { getRevisions } from '../../lib/revisions';
import { figuresIn } from '../../lib/figures';
import { readingMinutes } from '../../lib/pullquote';
import { paraNotesFor } from '../../lib/paraNotes';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const all = await getPublishedPosts();
const revisions = getRevisions(post);
const { newer, older } = adjacentPosts(post, all);
const related = relatedPosts(post, all);
const superseding = d.supersededBy ? all.find((p) => p.slug === d.supersededBy) : undefined;

const title = postTitle(post);
const hasTitle = Boolean(d.title?.trim());
const figures = figuresIn(post.body);
const mins = readingMinutes(post);
// Paragraphs changed by a counted revision, with their earlier wording, for the margin notes
const revNotes = d.type === 'essay' ? paraNotesFor(`src/content/posts/${post.id}`, d.date, revisions.revisions.map((x) => x.sha).filter((s): s is string => Boolean(s))) : [];
const barLink = (p?: Post) => (p ? { href: postHref(p), title: postTitle(p) } : undefined);

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const defaultDesc =
  'Agentic design engineer, still making sites full-time. Writing on faith and technology.';
const postDescription = d.description ?? defaultDesc;
const postUrl = new URL(postHref(post), `${siteOrigin}/`).toString();
/** Its share card, drawn at build time (pages/og/[...slug].png.ts) */
const ogImage = `/og/posts/${post.slug}.png`;
const published = d.date.toISOString();
const modified = revisions.updated?.toISOString();
const postJsonLd = {
  '@type': d.type === 'note' ? 'SocialMediaPosting' : 'BlogPosting',
  headline: title,
  description: postDescription,
  datePublished: published,
  ...(modified ? { dateModified: modified } : {}),
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  publisher: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  ...(d.type === 'link' && d.link ? { isBasedOn: d.link } : {}),
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  image: new URL(ogImage, `${siteOrigin}/`).toString(),
};

const fmtDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<Site
  title={`${title} — Derek Castelli`}
  description={postDescription}
  ogType="article"
  articlePublishedTime={published}
  articleModifiedTime={modified}
  jsonLd={postJsonLd}
  canonical={postUrl}
  ogImage={ogImage}
  bar={{ kind: 'essay', title, figures, newer: barLink(newer), older: barLink(older) }}
>
  <article class={`essay post post--${d.type}`} data-bar-progress data-select>
    <div class="essay__meta">
      {d.type !== 'essay' && <a class="post-kind" href={typeHref(d.type)}>{TYPE_LABELS[d.type].one}</a>}
      <time datetime={published}>{fmtDate(d.date)}</time>
      {d.type === 'essay' && <span>· {mins} min read</span>}
      {d.type === 'link' && d.link && (
        <span class="post-link-host">
          · {host(d.link)}
          {d.via && (
            <> · via <a href={d.via.url} rel="noopener">{d.via.name}</a></>
          )}
        </span>
      )}
      {figures.length > 0 && <span class="badge"><Icon name="spark" /> {figures.length} {figures.length === 1 ? 'figure' : 'figures'}</span>}
    </div>

    {d.type === 'link' && d.link ? (
      <h1 class="post-title--link">
        <a href={d.link} class="post-link-out" rel="noopener">
          {title}<span class="post-link-out__arrow" aria-hidden="true">↗</span>
        </a>
      </h1>
    ) : d.type === 'note' && !hasTitle ? (
      <h1 class="visually-hidden">{title}</h1>
    ) : (
      <h1>{title}</h1>
    )}
    {d.type === 'essay' && d.description && <p class="lede">{d.description}</p>}

    {d.draft && (
      <Callout kind="note" title="Draft preview">
        <p>Only visible in local dev — <code>draft: true</code> keeps this out of the build.</p>
      </Callout>
    )}

    {d.status === 'outdated' && (
      <Callout kind="outdated">
        <p>
          This no longer reflects how I think about this.
          {superseding && (
            <> Read <a href={postHref(superseding)}>{postTitle(superseding)}</a> instead.</>
          )}
        </p>
      </Callout>
    )}

    {d.audience && (
      <Callout kind="audience"><p>{d.audience}</p></Callout>
    )}

    <div class="prose post-content">
      <Content components={postComponents} />
    </div>

    {d.type === 'essay' && <div class="essay__sign"><Signature /></div>}
    <KeepReading posts={related} tags={d.tags} />
  </article>
  <div class="selbar" id="selbar" hidden></div>
  {revNotes.length > 0 && <script type="application/json" id="revNotes" set:html={JSON.stringify(revNotes).replace(/</g, '\\u003c')} />}
  <script src="../../client/select-menu.ts"></script>
  <script src="../../client/rev-notes.ts"></script>
</Site>
