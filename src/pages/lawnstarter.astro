---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import BragClippingFeed from '../components/BragClippingFeed.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { testimonials } from '../data/about';
import { lawnstarterMeta, lawnstarterLetter, lawnstarterClippings } from '../data/lawnstarter';

const letter = lawnstarterLetter;
---

<Base
  title={lawnstarterMeta.title}
  description={lawnstarterMeta.description}
  ogImage={lawnstarterMeta.ogImage}
  noindex={true}
>
  <PageTitle path="/lawnstarter" />

  <section class="lawnstarter-letter" aria-label="Cover letter" tabindex="0" data-lawnstarter-letter>
    <div class="lawnstarter-letter__sheet">
      <header class="lawnstarter-letter__address">
        <p>
          <span class="lawnstarter-letter__label">To:</span>
          {letter.to}
        </p>
        <p>
          <span class="lawnstarter-letter__label">From:</span>
          {letter.from}
        </p>
      </header>

      <hr class="lawnstarter-letter__rule" aria-hidden="true" />

      <p class="lawnstarter-letter__salutation">{letter.salutation}</p>

      {letter.paragraphs.map((paragraph) => (
        <p class="lawnstarter-letter__paragraph">{paragraph}</p>
      ))}
    </div>
  </section>

  <BragClippingFeed clippings={lawnstarterClippings} />

  <TestimonialCarousel testimonials={testimonials} headingId="lawnstarter-testimonials-heading" />

  <nav class="lawnstarter-footer intro-links" aria-label="More on this site">
    <a href="/work/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Work
    </a>
    <a href="/projects/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Projects
    </a>
    <a href="/posts/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Posts
    </a>
  </nav>
</Base>

<script>
  function initLawnstarterLetter() {
    document.querySelectorAll('[data-lawnstarter-letter]').forEach((section) => {
      if (!(section instanceof HTMLElement) || section.dataset.lsLetterInit) return;
      section.dataset.lsLetterInit = '1';

      section.addEventListener('click', (e) => {
        if (window.matchMedia('(hover: hover)').matches) return;
        const target = e.target;
        if (!(target instanceof Node) || !section.contains(target)) return;
        if (target instanceof Element && target.closest('a')) return;
        section.classList.toggle('is-open');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') section.classList.remove('is-open');
      });
    });
  }

  initLawnstarterLetter();
  document.addEventListener('astro:page-load', initLawnstarterLetter);
</script>

<style>
  .lawnstarter-letter {
    --letter-frame: color-mix(in srgb, #5a5a5a 10%, var(--border-strong));
    --letter-rule: color-mix(in srgb, #5a5a5a 8%, var(--border));
    --letter-surface-top: color-mix(in srgb, #f2f2f2 55%, var(--bg-elevated));
    --letter-surface-bottom: color-mix(in srgb, #e0e0e0 35%, var(--bg));
    --letter-collapsed-max: 26rem;
    --letter-expanded-max: 55rem;
    margin-bottom: var(--space-5);
    max-width: 100%;
    cursor: default;
  }

  .lawnstarter-letter__sheet {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--letter-surface-top), var(--letter-surface-bottom));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 1px 3px color-mix(in srgb, var(--fg) 5%, transparent);
    overflow: hidden;
    max-height: var(--letter-collapsed-max);
    transition:
      max-height 0.45s var(--easing),
      box-shadow 0.3s ease;
  }

  .lawnstarter-letter:is(:hover, :focus-within, .is-open) .lawnstarter-letter__sheet {
    max-height: var(--letter-expanded-max);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 2px 12px color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .lawnstarter-letter__sheet::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4.5rem;
    border-radius: 0 0 calc(var(--radius-sm) - 1px) calc(var(--radius-sm) - 1px);
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--letter-surface-bottom) 55%, transparent) 35%,
      var(--letter-surface-bottom)
    );
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.35s ease;
  }

  .lawnstarter-letter:is(:hover, :focus-within, .is-open) .lawnstarter-letter__sheet::after {
    opacity: 0;
  }

  .lawnstarter-letter__sheet::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--letter-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.65;
    z-index: 1;
  }

  .lawnstarter-letter__address {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    line-height: 1.65;
    color: var(--fg-soft);
  }

  .lawnstarter-letter__address p {
    margin: 0;
  }

  .lawnstarter-letter__address p + p {
    margin-top: 0.15em;
  }

  .lawnstarter-letter__label {
    display: inline-block;
    min-width: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lawnstarter-letter__rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--letter-rule);
  }

  .lawnstarter-letter__salutation,
  .lawnstarter-letter__paragraph {
    margin: 0 0 var(--space-3);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .lawnstarter-letter__salutation {
    margin-bottom: var(--space-2);
  }

  .lawnstarter-letter__paragraph:last-of-type {
    margin-bottom: 0;
  }

  @media (prefers-color-scheme: dark) {
    .lawnstarter-letter {
      --letter-frame: color-mix(in srgb, #a8a8a8 8%, var(--border-strong));
      --letter-rule: color-mix(in srgb, #a8a8a8 6%, var(--border));
      --letter-surface-top: color-mix(in srgb, #a8a8a8 4%, var(--bg-elevated));
      --letter-surface-bottom: color-mix(in srgb, #5a5a5a 6%, #0a0a0a);
    }

    .lawnstarter-letter:is(:hover, :focus-within, .is-open) .lawnstarter-letter__sheet {
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, white 8%, transparent),
        0 2px 12px color-mix(in srgb, black 45%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lawnstarter-letter__sheet {
      max-height: none;
      transition: none;
    }

    .lawnstarter-letter__sheet::after {
      display: none;
    }
  }

  .lawnstarter-footer {
    margin-top: var(--space-5);
    margin-bottom: var(--space-4);
  }
</style>
