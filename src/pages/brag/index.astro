---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { bragMeta, bragIntro, bragEpigraphNote, bragCredit, bragClippings } from '../../data/brag';
import type { BragPreview } from '../../data/brag';
import { projectStartTime } from '../../lib/projectStart';
import { computeBragStatCycles } from '../../lib/bragProjectTrend';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projectCount = allProjects.length;
const projectStartYear = allProjects.reduce((min, project) => {
  const t = projectStartTime(project);
  if (!t) return min;
  const y = new Date(t).getUTCFullYear();
  return y < min ? y : min;
}, new Date().getUTCFullYear());
const projectStatCycles = computeBragStatCycles(allProjects, projectCount, projectStartYear);
const projectStatCyclesJson = JSON.stringify(projectStatCycles);

const previewsFor = (clip: (typeof bragClippings)[number]): BragPreview[] => {
  if (!clip.preview) return [];
  return Array.isArray(clip.preview) ? clip.preview : [clip.preview];
};

const isImagePreview = (preview: BragPreview) => !preview.variant || preview.variant === 'image';

const imagePreviewCount = (previews: BragPreview[]) =>
  previews.filter(isImagePreview).length;

const fmtPostDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Base title={bragMeta.title} description={bragMeta.description}>
  <article class="prose brag-page">

    <PageTitle path="/brag">
      <span class="brag-credit-wrap">
        <button
          type="button"
          class="brag-credit-trigger"
          aria-expanded="false"
          aria-controls="brag-credit-popover"
          aria-label="Episode credit"
        >
          <i class="ph-bold ph-info" aria-hidden="true"></i>
        </button>
        <div id="brag-credit-popover" class="brag-credit-popover" role="tooltip" hidden>
          <p>
            This page is brought to you by{' '}
            <a href={bragCredit.episodeUrl} target="_blank" rel="noopener noreferrer">{bragCredit.episodeLabel}</a>
          </p>
        </div>
      </span>
    </PageTitle>
    <p class="brag-intro">{bragIntro}</p>

    <div class="brag-epigraph-wrap" tabindex="0">
      <blockquote class="brag-epigraph-plaque">
        <p class="brag-epigraph-plaque__quote">
          You’re only given a little spark of madness.<br />
          You mustn’t lose it.
        </p>
        <footer class="brag-epigraph-plaque__attrib">
          <span class="brag-epigraph-plaque__rule" aria-hidden="true"></span>
          <cite>Robin Williams</cite>
        </footer>
      </blockquote>
      <aside class="brag-epigraph-note" data-brag-epigraph-note aria-label="Personal note about Robin Williams">
        <p id="brag-epigraph-note-text" class="brag-epigraph-note__text">{bragEpigraphNote}</p>
      </aside>
    </div>

    <ol class="brag-feed" role="list">
      {bragClippings.map((clip) => {
        const previews = previewsFor(clip);
        return (
          <li class="brag-item">
            <div class="brag-item-copy">
              <p class="brag-item-kicker">
                <span class="brag-item-pub">{clip.publication}</span>
                <span class="brag-item-kicker-dot" aria-hidden="true">·</span>
                <time class="brag-item-date" datetime={clip.dateline}>{clip.dateline}</time>
              </p>

              {clip.href ? (
                <h2 class="brag-item-title">
                  <a href={clip.href}>{clip.headline}</a>
                </h2>
              ) : (
                <h2 class="brag-item-title">{clip.headline}</h2>
              )}

              <p class="brag-item-summary">{clip.summary}</p>

              {(clip.relatedLinks?.length ?? 0) > 0 && (
                <p class="brag-item-links">
                  {clip.relatedLinks!.map((link, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true"> · </span>}
                      <a href={link.href}>{link.label}</a>
                    </>
                  ))}
                </p>
              )}
            </div>

            {previews.length > 0 && (
              <div
                class:list={[
                  'brag-item-previews',
                  imagePreviewCount(previews) > 1 && 'brag-item-previews--multi',
                ]}
                aria-label="Related work preview"
              >
                {previews.map((preview) => {
                  const href = preview.href ?? clip.href;

                  if (preview.variant === 'posts' && preview.favoritePosts?.length) {
                    return (
                      <div class="brag-preview brag-preview--posts">
                        <ul class="entries" role="list">
                          {preview.favoritePosts.map((post) => (
                            <li>
                              <a
                                href={post.href}
                                class="entry-link"
                                {...(post.external
                                  ? { target: '_blank', rel: 'noopener noreferrer' }
                                  : {})}
                              >
                                {post.date ? (
                                  <time datetime={post.date} class="entry-date">
                                    {fmtPostDate(post.date)}
                                  </time>
                                ) : post.likes ? (
                                  <span class="entry-date">{post.likes} likes on X</span>
                                ) : null}
                                <span class="entry-title">{post.title}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    );
                  }

                  if (
                    preview.variant === 'stats' &&
                    (preview.aggregateProjects || (preview.projectStats?.length ?? 0) > 0)
                  ) {
                    return (
                      <div class="brag-preview brag-preview--stats">
                        <div
                          class:list={[
                            'brag-stats-panel',
                            preview.aggregateProjects && 'brag-stats-panel--aggregate',
                          ]}
                        >
                          {preview.caption && (
                            <p class="brag-stats-panel__label">{preview.caption}</p>
                          )}
                          {preview.aggregateProjects ? (
                            <div class="brag-stat-aggregate">
                              <div
                                class="brag-stat-hero-wrap"
                                data-brag-stat-cycler
                                data-slides={projectStatCyclesJson}
                                aria-live="polite"
                                aria-label={`${projectCount} side projects since ${projectStartYear}`}
                              >
                                <div class="brag-stat-hero">
                                  <p class="brag-stat-hero__value">{projectStatCycles[0]!.value}</p>
                                  <div class="brag-stat-hero__copy">
                                    <p class="brag-stat-hero__kicker">{projectStatCycles[0]!.kicker}</p>
                                    <p class="brag-stat-hero__title">{projectStatCycles[0]!.title}</p>
                                    <p
                                      class="brag-stat-hero__since"
                                      hidden={!projectStatCycles[0]!.subtitle}
                                    >
                                      {projectStatCycles[0]!.subtitle}
                                    </p>
                                  </div>
                                </div>
                                {projectStatCycles.length > 1 && (
                                  <button
                                    type="button"
                                    class="brag-stat-cycle"
                                    aria-label="Next project stat"
                                  >
                                    <i class="ph-bold ph-arrows-clockwise" aria-hidden="true" />
                                  </button>
                                )}
                              </div>
                              {preview.linkLabel && preview.href && (
                                <a class="about-exp-pill brag-stats-more" href={preview.href}>
                                  <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                  {preview.linkLabel}
                                </a>
                              )}
                            </div>
                          ) : (
                            <ul class="entries brag-stats" role="list">
                              {preview.projectStats!.map((project) => (
                                <li>
                                  <a href={project.href} class="entry-link">
                                    <span class="entry-date brag-stat-name">{project.name}</span>
                                    <span class="entry-title">{project.metrics}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                          {!preview.aggregateProjects &&
                            preview.linkLabel &&
                            preview.href && (
                              <a class="about-exp-pill brag-stats-more" href={preview.href}>
                                <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                {preview.linkLabel}
                              </a>
                            )}
                        </div>
                      </div>
                    );
                  }

                  if (preview.variant === 'link' && preview.href && preview.linkLabel) {
                    return (
                      <div class="brag-preview brag-preview--link">
                        <a
                          class="about-exp-pill brag-link-pill"
                          href={preview.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                          {preview.linkLabel}
                        </a>
                      </div>
                    );
                  }

                  if (preview.variant === 'experience') {
                    return (
                      <a class="brag-preview brag-preview--experience" href={href}>
                        <div class="about-exp-group">
                          <ul class="about-exp-group__list">
                            <li class="about-exp-item">
                              {preview.range && (
                                <p class="about-exp-item__range">{preview.range}</p>
                              )}
                              <p class="about-exp-item__name">{preview.name ?? clip.headline}</p>
                              {preview.description && (
                                <p class="about-exp-item__desc">{preview.description}</p>
                              )}
                              {preview.linkLabel && (
                                <span class="about-exp-pill">
                                  <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                  {preview.linkLabel}
                                </span>
                              )}
                            </li>
                          </ul>
                        </div>
                      </a>
                    );
                  }

                  const media = preview.src ? (
                    <div class="brag-preview-media">
                      <img
                        class="brag-preview-img"
                        src={preview.src}
                        alt={preview.alt}
                        width={320}
                        height={200}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="brag-preview-media brag-preview-media--icon" aria-hidden="true">
                      <i class={`ph-bold ph-${preview.icon}`} />
                    </div>
                  );
                  const caption = preview.caption ? (
                    <span class="brag-preview-caption">{preview.caption}</span>
                  ) : null;

                  return href ? (
                    <a class="brag-preview" href={href}>
                      {media}
                      {caption}
                    </a>
                  ) : (
                    <div class="brag-preview">
                      {media}
                      {caption}
                    </div>
                  );
                })}
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </article>

  <script>
    function initBragStatCyclers() {
      document.querySelectorAll('[data-brag-stat-cycler]').forEach((root) => {
        if (root.dataset.bragStatInit) return;
        root.dataset.bragStatInit = '1';

        const raw = root.getAttribute('data-slides');
        if (!raw) return;
        let slides;
        try {
          slides = JSON.parse(raw);
        } catch {
          return;
        }
        if (!Array.isArray(slides) || slides.length < 2) return;

        const btn = root.querySelector('.brag-stat-cycle');
        const valueEl = root.querySelector('.brag-stat-hero__value');
        const kickerEl = root.querySelector('.brag-stat-hero__kicker');
        const titleEl = root.querySelector('.brag-stat-hero__title');
        const sinceEl = root.querySelector('.brag-stat-hero__since');
        if (!btn || !valueEl || !kickerEl || !titleEl || !sinceEl) return;

        let i = 0;
        const show = (idx) => {
          const s = slides[idx];
          valueEl.textContent = s.value;
          kickerEl.textContent = s.kicker;
          titleEl.textContent = s.title;
          if (s.subtitle) {
            sinceEl.textContent = s.subtitle;
            sinceEl.hidden = false;
          } else {
            sinceEl.textContent = '';
            sinceEl.hidden = true;
          }
          root.setAttribute(
            'aria-label',
            [s.kicker, s.value, s.title, s.subtitle].filter(Boolean).join(' '),
          );
        };

        btn.addEventListener('click', () => {
          i = (i + 1) % slides.length;
          show(i);
        });
      });
    }

    initBragStatCyclers();
    document.addEventListener('astro:page-load', initBragStatCyclers);

    function initBragCreditPopover() {
      const trigger = document.querySelector('.brag-credit-trigger');
      const popover = document.getElementById('brag-credit-popover');
      if (!trigger || !popover || trigger.dataset.bragCreditInit) return;

      trigger.dataset.bragCreditInit = '1';

      const close = () => {
        popover.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      };

      const open = () => {
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (popover.hidden) open();
        else close();
      });

      document.addEventListener('click', (e) => {
        if (popover.hidden) return;
        const target = e.target;
        if (target instanceof Node && !popover.contains(target) && !trigger.contains(target)) close();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }

    initBragCreditPopover();
    document.addEventListener('astro:page-load', initBragCreditPopover);

    function initBragEpigraphNote() {
      document.querySelectorAll('[data-brag-epigraph-note]').forEach((note) => {
        if (!(note instanceof HTMLElement) || note.dataset.bragEpigraphNoteInit) return;

        const wrap = note.closest('.brag-epigraph-wrap');
        if (!(wrap instanceof HTMLElement)) return;

        note.dataset.bragEpigraphNoteInit = '1';

        const setOpen = (open) => note.classList.toggle('is-open', open);

        wrap.addEventListener('click', (e) => {
          if (window.matchMedia('(hover: hover)').matches) return;
          const target = e.target;
          if (!(target instanceof Node) || !wrap.contains(target)) return;
          if (target instanceof Element && target.closest('a')) return;
          setOpen(!note.classList.contains('is-open'));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      });
    }

    initBragEpigraphNote();
    document.addEventListener('astro:page-load', initBragEpigraphNote);
  </script>
</Base>

<style>
  .brag-epigraph-wrap {
    --brag-plaque-frame: color-mix(in srgb, #6b5a45 8%, var(--border-strong));
    --brag-plaque-rule: color-mix(in srgb, #6b5a45 6%, var(--border));
    --brag-plaque-surface-top: color-mix(in srgb, #8b7355 7%, var(--bg-elevated));
    --brag-plaque-surface-bottom: color-mix(in srgb, #6b5a45 5%, var(--bg-elevated));
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: 0 0 var(--space-5);
    max-width: 100%;
  }

  .brag-epigraph-plaque {
    position: relative;
    width: 100%;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    text-align: center;
    border: 1px solid var(--brag-plaque-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(
      180deg,
      var(--brag-plaque-surface-top),
      var(--brag-plaque-surface-bottom)
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 35%, transparent),
      0 1px 2px color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .brag-epigraph-plaque::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--brag-plaque-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
  }

  .brag-epigraph-plaque__quote {
    margin: 0;
    max-width: 36ch;
    margin-inline: auto;
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(1.125rem, 2.5vw, 1.3125rem);
    line-height: 1.5;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .brag-epigraph-plaque__attrib {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-style: normal;
  }

  .brag-epigraph-plaque__rule {
    display: block;
    width: 2.25rem;
    height: 1px;
    background: var(--brag-plaque-rule);
  }

  .brag-epigraph-plaque__attrib cite {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  @media (prefers-color-scheme: dark) {
    .brag-epigraph-wrap {
      --brag-plaque-frame: color-mix(in srgb, #c9a86c 7%, var(--border-strong));
      --brag-plaque-rule: color-mix(in srgb, #c9a86c 5%, var(--border));
      --brag-plaque-surface-top: color-mix(in srgb, #c9a86c 5%, var(--bg-elevated));
      --brag-plaque-surface-bottom: color-mix(in srgb, #8b7355 4%, #0a0a0a);
    }

    .brag-epigraph-plaque {
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, white 8%, transparent),
        0 2px 12px color-mix(in srgb, black 45%, transparent);
    }
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-plaque,
  .brag-epigraph-wrap:has(.brag-epigraph-note.is-open) .brag-epigraph-plaque {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-plaque::before,
  .brag-epigraph-wrap:has(.brag-epigraph-note.is-open) .brag-epigraph-plaque::before {
    border-bottom: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .brag-epigraph-note {
    --brag-note-surface: color-mix(in srgb, #8b7355 5%, var(--bg-elevated));
    width: 100%;
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-note,
  .brag-epigraph-note.is-open {
    position: relative;
    border: 1px solid var(--brag-plaque-frame);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--brag-note-surface);
    pointer-events: auto;
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-note::before,
  .brag-epigraph-note.is-open::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--brag-plaque-frame);
    border-top: none;
    border-radius: 0 0 calc(var(--radius-sm) - 3px) calc(var(--radius-sm) - 3px);
    pointer-events: none;
  }

  .brag-epigraph-note__text {
    max-width: 22rem;
    margin: 0 auto;
    padding: 0 var(--space-3);
    min-width: 0;
    max-height: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    text-align: center;
    color: var(--fg-soft);
    text-wrap: pretty;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.45s var(--easing),
      opacity 0.3s ease,
      padding 0.45s var(--easing);
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-note__text,
  .brag-epigraph-note.is-open .brag-epigraph-note__text {
    max-height: 8rem;
    padding-block: var(--space-2);
    opacity: 0.92;
  }

  @media (prefers-color-scheme: dark) {
    .brag-epigraph-note {
      --brag-note-surface: color-mix(in srgb, #c9a86c 4%, #0a0a0a);
    }
  }

  .brag-credit-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .brag-credit-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted-strong);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .brag-credit-trigger i {
    font-size: 15px;
  }

  .brag-credit-trigger:hover,
  .brag-credit-trigger[aria-expanded='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .brag-credit-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .brag-credit-popover {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 20;
    width: max-content;
    max-width: min(22rem, calc(100vw - 2.5rem));
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--fg) 12%, transparent);
  }

  .brag-credit-popover p {
    margin: 0;
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--fg-soft);
  }

  .brag-credit-popover a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    border-bottom: none;
  }

  .brag-credit-popover a:hover {
    color: var(--accent-hover);
  }

  .brag-intro {
    color: var(--fg-soft);
    margin-bottom: var(--space-4);
  }

  .brag-feed {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: brag;
  }

  .brag-item {
    counter-increment: brag;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-3);
    align-items: start;
  }

  .brag-item::before {
    content: counter(brag, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 700;
    color: var(--muted);
    line-height: 1.6;
    padding-top: 2px;
  }

  .brag-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .brag-item-copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .brag-item-previews {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    min-width: 0;
    overflow: visible;
  }

  .brag-item-previews--multi {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .brag-item-previews .brag-preview--posts {
    grid-column: 1 / -1;
  }

  .brag-preview {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: visible;
    border: 1px solid var(--border);
    background: var(--bg);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .brag-preview:hover {
