---
import Site from '../../../layouts/Site.astro';
import PageHead from '../../../components/site/PageHead.astro';
import WorkIndex from '../../../components/site/WorkIndex.astro';
import { getPublishedWork, partnersOf, partnerSlug, PARTNER_SITES, type Partner } from '../../../lib/work';

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return partnersOf(work).map((partner) => ({ params: { partner: partner.slug }, props: { partner } }));
}

interface Props { partner: Partner }
const { partner } = Astro.props;
const entries = (await getPublishedWork()).filter((w) => w.data.partnership && partnerSlug(w.data.partnership) === partner.slug);
const site = PARTNER_SITES[partner.name];
---
<Site
  title={`Work with ${partner.name} — Derek Castelli`}
  description={`Sites Derek Castelli designed and built in partnership with ${partner.name}.`}
  bar={{ kind: 'page', title: `With ${partner.name}` }}
>
  <main class="home">
    <PageHead title={`With ${partner.name}`} meta={`Work · ${entries.length} write-ups`}><Fragment slot="lede">Sites I've built in partnership with {site ? <a href={site} target="_blank" rel="noopener">{partner.name}</a> : partner.name}.</Fragment></PageHead>
    <WorkIndex work={entries} active={partner.slug} />
  </main>
</Site>
