---
/**
 * A website write-up, in the same voice and layout as an essay: what they needed, the problem,
 * what I built, with the site in a browser window and its pages on a rail beside it.
 */
import { type CollectionEntry } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import MediaStepper from '../../components/MediaStepper.astro';
import Browser from '../../components/site/Browser.astro';
import Signature from '../../components/Signature.astro';
import { schemaPersonId } from '../../lib/schemaIds';
import { mdStringToHtml } from '../../lib/mdString';
import { imgSrc } from '../../lib/img';
import { getPublishedWork } from '../../lib/work';
import { host, shot, workDate } from '../../lib/deck';

export async function getStaticPaths() {
  const items = await getPublishedWork();
  return items.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<'work'> }
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const postDescription = d.description ?? 'Agentic design engineer, still making sites full-time. Writing on faith and technology.';
const postUrl = new URL(`/work/${post.slug}/`, `${siteOrigin}/`).toString();
const published = d.date.toISOString();
const industryOrTags = d.industry?.length ? d.industry : d.tags ?? [];
const postJsonLd = {
  '@type': 'BlogPosting',
  headline: d.title,
  description: postDescription,
  datePublished: published,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  publisher: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  ...(industryOrTags.length ? { keywords: industryOrTags.join(', ') } : {}),
  ...(d.thumbnail ? { image: new URL(d.thumbnail.replace(/\.webp$/i, '.png'), `${siteOrigin}/`).toString() } : {}),
};
/** Open Graph wants PNG; site thumbs are often WebP. Prefer the thumbnail's sibling `.png`. */
const ogImage = d.thumbnail?.startsWith('/') ? d.thumbnail.replace(/\.webp$/i, '.png') : '/derekj-og.png';

// Newer and older write-ups, by when the work was done
const all = (await getPublishedWork()).sort((a, b) => workDate(b).valueOf() - workDate(a).valueOf());
const at = all.findIndex((w) => w.slug === post.slug);
const newer = all[at - 1], older = all[at + 1];
const link = (w?: CollectionEntry<'work'>) => (w ? { href: `/work/${w.slug}/`, title: w.data.title } : undefined);

const MON = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const done = workDate(post);
const weeks = typeof d.weeksToComplete === 'number' ? `${d.weeksToComplete} week${d.weeksToComplete === 1 ? '' : 's'}` : d.weeksToComplete || '';
const meta = [d.partnership ? `With ${d.partnership}` : 'Solo', d.workType, `${MON[done.getUTCMonth()]} ${done.getUTCFullYear()}`, weeks].filter(Boolean) as string[];

const pages = [...new Set([d.thumbnail, ...(d.gallery ?? []), d.desktop].filter(Boolean))].map((s) => ({ src: shot(s as string) }));
const live = d.liveLink ?? d.waybackUrl;
const sections = ([
  ['What they needed', d.brief],
  ['The problem', d.problem],
  ['What I built', d.solution],
  ['The work', d.specificWork],
] as const).map(([h, md]) => [h, mdStringToHtml(md)] as const).filter(([, html]) => html);
const prior = {
  html: ([['What they needed', d.priorBrief], ['The problem', d.priorProblem], ['What I built', d.priorSolution]] as const)
    .map(([h, md]) => [h, mdStringToHtml(md)] as const).filter(([, html]) => html),
  shots: (d.priorGallery ?? []).map((src) => ({ src, alt: `${d.title}, the earlier version` })),
};
const posterSrc = d.videoPoster ? imgSrc(d.videoPoster, 1280) : undefined;
---
<Site
  title={`${d.title} — Derek Castelli`}
  description={postDescription}
  ogType="article"
  articlePublishedTime={published}
  jsonLd={postJsonLd}
  canonical={postUrl}
  ogImage={ogImage}
  preloadImages={pages[0] ? [pages[0].src] : []}
  bar={{ kind: 'writeup', title: d.title, newer: link(newer), older: link(older) }}
>
  <article class="essay writeup" data-bar-progress data-select>
    <div class="essay__meta">{meta.map((m, i) => <>{i > 0 && <span>·</span>}<span>{m}</span></>)}{d.archived && <span class="badge">Archived</span>}</div>
    <h1>{d.title}</h1>
    {d.description && <p class="lede">{d.description}</p>}

    <div class="prose post-content">
      {pages.length > 0 && (
        <figure class="fig sq">
          <div class="fig__head"><span class="fig__no">FIG 1</span><span class="fig__title">The site</span>{live && <a class="fig__reset" href={live} target="_blank" rel="noopener">Visit ↗</a>}</div>
          <div class="fig__stage">
            <div class="wslide wslide--solo" data-rail data-drawer="closed">
              <Browser pages={pages} url={host(live)} deck drawer eager />
              {pages.length > 1 && (
                <div class="pages" role="group" aria-label="Pages">
                  {pages.map((p, n) => <button class="sq" data-page-to={n} aria-current={n === 0 ? 'true' : 'false'} aria-label={`Page ${n + 1}`}><img src={p.src} alt="" loading="lazy" decoding="async" /></button>)}
                </div>
              )}
            </div>
          </div>
        </figure>
      )}

      {d.video && (
        <figure class="fig sq">
          <div class="fig__head"><span class="fig__no">FIG 2</span><span class="fig__title">A tour</span></div>
          <div class="fig__stage">
            <video class="writeup__video sq" data-plyr data-autoplay muted loop playsinline preload="metadata" poster={posterSrc} style={d.videoAspect ? `aspect-ratio: ${d.videoAspect}` : undefined} aria-label={d.videoCaption ?? `${d.title} site tour`}>
              <source src={d.video} type={d.video.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
            </video>
          </div>
          {d.videoCaption && <p class="fig__cap">{d.videoCaption}</p>}
        </figure>
      )}

      {sections.map(([h, html]) => <><h2>{h}</h2><Fragment set:html={html} /></>)}
      <Content />

      {(prior.html.length > 0 || prior.shots.length > 0) && (
        <>
          <h2>The version before</h2>
          {(d.priorVersionLabel || d.priorEstimatedTimeSpent) && <p class="writeup__note">{[d.priorVersionLabel, d.priorEstimatedTimeSpent].filter(Boolean).join(' · ')}</p>}
          {prior.html.map(([h, html]) => <><h3>{h}</h3><Fragment set:html={html} /></>)}
          {prior.shots.length > 0 && <MediaStepper items={prior.shots} label={`${d.title}, the earlier version`} aspect="16 / 10" fit="contain" />}
        </>
      )}

      <p class="visit">
        {d.liveLink && <a class="btn" href={d.liveLink} target="_blank" rel="noopener">Visit {host(d.liveLink)} <Icon name="arrow-up-right" /></a>}
        {d.waybackUrl && <a class="btn" href={d.waybackUrl} target="_blank" rel="noopener">On the Wayback Machine <Icon name="arrow-up-right" /></a>}
        {d.proposalLink && <a class="btn" href={d.proposalLink} target="_blank" rel="noopener">{d.proposalLinkLabel?.trim() || 'Proposed redesign'} <Icon name="arrow-up-right" /></a>}
        {d.partnershipWorkLink && <a class="btn" href={d.partnershipWorkLink} target="_blank" rel="noopener">{d.partnership ? `${d.partnership}'s write-up` : 'Partner case study'} <Icon name="arrow-up-right" /></a>}
      </p>
      {d.liveLinkNote && <p class="writeup__note">{d.liveLinkNote}</p>}
    </div>

    <div class="essay__sign"><Signature /></div>
    <nav class="pager" aria-label="More write-ups">
      {newer ? <a class="sq" href={`/work/${newer.slug}/`}><small>Newer</small><b>{newer.data.title}</b></a> : <span></span>}
      {older && <a class="sq" href={`/work/${older.slug}/`}><small>Older</small><b>{older.data.title}</b></a>}
    </nav>
  </article>
  <div class="selbar" id="selbar" hidden></div>
  <script src="../../client/rail.ts"></script>
  <script src="../../client/select-menu.ts"></script>
</Site>
