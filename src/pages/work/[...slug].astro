---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaStepper from '../../components/MediaStepper.astro';
import { schemaPersonId } from '../../lib/schemaIds';
import { mdStringToHtml } from '../../lib/mdString';

export async function getStaticPaths() {
  const items = await getCollection('work', ({ data }) => !data.draft);
  return items.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'work'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const defaultDesc =
  'Agentic design engineer, still making websites full-time. Writing on faith and technology.';
const postDescription = post.data.description ?? defaultDesc;
const postPath = `/work/${post.slug}/`;
const postUrl = new URL(postPath, `${siteOrigin}/`).toString();
const published = post.data.date.toISOString();
const d = post.data;

const industryOrTags = d.industry?.length ? d.industry : d.tags ?? [];
const priorImages = d.priorGallery ?? [];
const priorStepperItems = priorImages.map((src) => ({ src, alt: `${d.title} earlier version` }));
const workFactCount = [
  d.workType,
  d.soloOrAgency,
  d.partnership,
  d.estimatedTimeSpent,
  d.weeksToComplete !== undefined && d.weeksToComplete !== null && String(d.weeksToComplete) !== ''
    ? d.weeksToComplete
    : null,
].filter(Boolean).length;
const hasMetaChips = Boolean(
  d.workType ||
    industryOrTags.length ||
    d.soloOrAgency ||
    d.estimatedTimeSpent ||
    d.partnership ||
    d.weeksToComplete !== undefined,
);

const briefHtml = mdStringToHtml(d.brief);
const problemHtml = mdStringToHtml(d.problem);
const solutionHtml = mdStringToHtml(d.solution);
const specificWorkHtml = mdStringToHtml(d.specificWork);

const hasDeviceRow = Boolean(d.desktop || d.mobile);
/** Hero + gallery, deduped — thumbs swap the main stage; only the stage zooms. */
const stageImages = [...new Set([d.thumbnail, ...(d.gallery ?? [])].filter(Boolean))] as string[];
const hasStage = stageImages.length > 0;
const hasGallery = stageImages.length > 1;
const hasVideo = Boolean(d.video);

const postJsonLd = {
  '@type': 'BlogPosting',
  headline: d.title,
  description: postDescription,
  datePublished: published,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  publisher: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
  ...(industryOrTags.length ? { keywords: industryOrTags.join(', ') } : {}),
  ...(d.thumbnail
    ? {
        image: (() => {
          const src = d.thumbnail.replace(/\.webp$/i, '.png');
          return src.startsWith('http') ? src : new URL(src, `${siteOrigin}/`).toString();
        })(),
      }
    : {}),
};

const fmtDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

/** Open Graph wants PNG; site thumbs are often WebP. Prefer sibling `.png` of the thumbnail. */
const ogImage =
  d.thumbnail && d.thumbnail.startsWith('/')
    ? d.thumbnail.replace(/\.webp$/i, '.png')
    : '/derekj-og.png';
/** Kick off first media early: poster + stage (or stage alone when no video). */
const preloadImages = [d.videoPoster, stageImages[0]].filter(Boolean) as string[];
---
<Base
  title={`${d.title} — Derek Castelli`}
  description={postDescription}
  ogType="article"
  articlePublishedTime={published}
  jsonLd={postJsonLd}
  canonical={postUrl}
  ogImage={ogImage}
  preloadImages={preloadImages}
>
  <article class="prose work-casestudy">
    <header class="post-header work-post-header">
      <div class="work-title-block">
        <h1>{d.title}</h1>
        {d.highlight && (
          <span class="work-favorite" title="A personal favorite">
            <i class="ph-fill ph-star" aria-hidden="true" />
          </span>
        )}
      </div>
      <div class="meta work-meta-line">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.dateCompleted && d.dateCompleted.getTime() !== d.date.getTime() && (
          <span> · completed {fmtDate(d.dateCompleted)}</span>
        )}
        {industryOrTags.length > 0 && <span> · {industryOrTags.join(', ')}</span>}
      </div>
    </header>

    {d.archived && (
      <p class="work-flags" aria-label="Status">
        <span class="work-flag work-flag-archived">Archived</span>
      </p>
    )}

    {hasMetaChips && (
      <dl class="work-facts" data-fact-count={workFactCount}>
        {d.workType && (
          <div class="work-fact">
            <dt>Type</dt>
            <dd>{d.workType}</dd>
          </div>
        )}
        {d.soloOrAgency && (
          <div class="work-fact">
            <dt>Context</dt>
            <dd>{d.soloOrAgency}</dd>
          </div>
        )}
        {d.partnership && (
          <div class="work-fact">
            <dt>Partner</dt>
            <dd>{d.partnership}</dd>
          </div>
        )}
        {d.estimatedTimeSpent && (
          <div class="work-fact">
            <dt>Time</dt>
            <dd>{d.estimatedTimeSpent}</dd>
          </div>
        )}
        {d.weeksToComplete !== undefined && d.weeksToComplete !== null && String(d.weeksToComplete) !== '' && (
          <div class="work-fact">
            <dt>Duration</dt>
            <dd>
              {typeof d.weeksToComplete === 'number'
                ? `${d.weeksToComplete} week${d.weeksToComplete === 1 ? '' : 's'}`
                : d.weeksToComplete}
            </dd>
          </div>
        )}
      </dl>
    )}

    {hasVideo && (
      <figure class="pvideo zoomable">
        <div
          class="zoom-trigger pvideo-shell"
          role="button"
          tabindex="0"
          aria-label="Zoom video"
          aria-expanded="false"
          style={[
            d.videoAspect ? `--pvideo-ar: ${d.videoAspect}` : null,
            '--pvideo-window-radius: 0.01',
          ]
            .filter(Boolean)
            .join('; ')}
        >
          <span class="pvideo-clip">
            <video
              class="pvideo-el"
              data-plyr
              data-autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={d.videoPoster}
              aria-label={d.videoCaption ?? `${d.title} site tour`}
            >
              <source
                src={d.video}
                type={d.video!.endsWith('.webm') ? 'video/webm' : 'video/mp4'}
              />
            </video>
          </span>
        </div>
        {d.videoCaption && <figcaption>{d.videoCaption}</figcaption>}
      </figure>
    )}

    {hasStage && (
      <div
        class="work-stage"
        data-work-stage
        data-prefetch-images={JSON.stringify(stageImages)}
        data-prefetch-idle
      >
        <figure class="work-hero-figure zoomable">
          <button type="button" class="zoom-trigger" aria-label="Zoom image" aria-expanded="false">
            <img
              class="work-hero"
              data-stage-img
              src={stageImages[0]}
              alt=""
              width="1200"
              height="675"
              loading="eager"
              fetchpriority={hasVideo ? 'low' : 'high'}
              decoding="async"
            />
          </button>
        </figure>

        {hasGallery && (
          <div class="work-gallery" role="list" aria-label="Choose image">
            {stageImages.map((src, i) => (
              <button
                type="button"
                class="work-gallery-item"
                role="listitem"
                data-stage-thumb
                data-src={src}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={`Show image ${i + 1} of ${stageImages.length}`}
              >
                <img
                  src={src}
                  alt=""
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </button>
            ))}
          </div>
        )}
      </div>
    )}

    {hasDeviceRow && (
      <div class="work-devices" aria-label="Desktop and mobile">
        {d.desktop && (
          <figure class="zoomable">
            <button type="button" class="zoom-trigger" aria-label="Zoom desktop image" aria-expanded="false">
              <img src={d.desktop} alt="Desktop" loading="lazy" decoding="async" />
            </button>
            <figcaption>Desktop</figcaption>
          </figure>
        )}
        {d.mobile && (
          <figure class="zoomable">
            <button type="button" class="zoom-trigger" aria-label="Zoom mobile image" aria-expanded="false">
              <img src={d.mobile} alt="Mobile" loading="lazy" decoding="async" />
            </button>
            <figcaption>Mobile</figcaption>
          </figure>
        )}
      </div>
    )}

    {briefHtml && (
      <section class="work-section" aria-labelledby="work-brief">
        <h2 id="work-brief" class="work-section-title">Brief</h2>
        <div class="work-md post-content" set:html={briefHtml} />
      </section>
    )}

    {problemHtml && (
      <section class="work-section" aria-labelledby="work-problem">
        <h2 id="work-problem" class="work-section-title">Problem</h2>
        <div class="work-md post-content" set:html={problemHtml} />
      </section>
    )}

    {solutionHtml && (
      <section class="work-section" aria-labelledby="work-solution">
        <h2 id="work-solution" class="work-section-title">Solution</h2>
        <div class="work-md post-content" set:html={solutionHtml} />
      </section>
    )}

    {specificWorkHtml && (
      <section class="work-section" aria-labelledby="work-specific">
        <h2 id="work-specific" class="work-section-title">Specific work</h2>
        <div class="work-md post-content" set:html={specificWorkHtml} />
      </section>
    )}

    <div class="post-content work-body">
      <Content />
    </div>

    {priorStepperItems.length > 0 && (
      <section class="work-section work-prior" aria-labelledby="work-prior">
        <hr class="work-prior-rule" />
        <h2 id="work-prior" class="work-section-title">Earlier version</h2>
        {d.priorVersionLabel && (
          <p class="work-prior-label">{d.priorVersionLabel}</p>
        )}
        <MediaStepper
          items={priorStepperItems}
          label={`${d.title} earlier version`}
          aspect="16 / 10"
          fit="contain"
        />
      </section>
    )}

    {d.legacyUrl && (
      <p class="work-legacy">
        <a href={d.legacyUrl}>Previously published at a legacy URL</a>
      </p>
    )}

    {(d.liveLink || d.waybackUrl || d.partnershipWorkLink) && (
      <ul class="work-links" aria-label="Project links">
        {d.liveLink ? (
          <li>
            <a class="work-link-pill" href={d.liveLink} rel="noopener noreferrer" target="_blank">
              <span>Live site</span>
              <i class="ph-bold ph-arrow-up-right work-link-pill__icon" aria-hidden="true" />
            </a>
          </li>
        ) : d.waybackUrl ? (
          <li>
            <a class="work-link-pill" href={d.waybackUrl} rel="noopener noreferrer" target="_blank">
              <span>Wayback Machine</span>
              <i class="ph-bold ph-arrow-up-right work-link-pill__icon" aria-hidden="true" />
            </a>
          </li>
        ) : null}
        {d.partnershipWorkLink && (
          <li>
            <a
              class="work-link-pill"
              href={d.partnershipWorkLink}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span>Partner case study</span>
              <i class="ph-bold ph-arrow-up-right work-link-pill__icon" aria-hidden="true" />
            </a>
          </li>
        )}
      </ul>
    )}

    <p class="back-link">
      <a href="/work/"><span class="arrow">&larr;</span> all work</a>
    </p>
  </article>

  <script>
    function initWorkStages() {
      document.querySelectorAll<HTMLElement>('[data-work-stage]').forEach((root) => {
        const stage = root.querySelector<HTMLImageElement>('[data-stage-img]');
        const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage-thumb]'));
        if (!stage || thumbs.length < 2) return;

        thumbs.forEach((thumb) => {
          if (thumb.dataset.stageBound === '1') return;
          thumb.dataset.stageBound = '1';
          thumb.addEventListener('click', () => {
            const src = thumb.dataset.src;
            if (!src || stage.getAttribute('src') === src) return;
            stage.src = src;
            thumbs.forEach((t) => t.setAttribute('aria-pressed', t === thumb ? 'true' : 'false'));
          });
        });
      });
    }

    function initWorkVideos() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
        if (reduceMotion) {
          video.controls = true;
        } else {
          video.autoplay = true;
          const p = video.play();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        }
      });
    }

    initWorkStages();
    initWorkVideos();
    document.addEventListener('astro:page-load', initWorkStages);
    document.addEventListener('astro:page-load', initWorkVideos);
  </script>
</Base>
