---
import Site from '../../layouts/Site.astro';
import WorkIndex from '../../components/site/WorkIndex.astro';
import Elsewhere from '../../components/site/Elsewhere.astro';
import { getPublishedWork } from '../../lib/work';
import { testimonials } from '../../data/about';

const entries = await getPublishedWork();
---
<Site
  title="Work — Derek Castelli"
  description="Write-ups from the websites I've designed and built, on my own and with studios like Kem Design."
  bar={{ kind: 'page', title: 'Work' }}
>
  <main class="home">
    <h1 class="page-h">Websites</h1>
    <p class="page-lede">Write-ups from the sites I've designed and built, on my own and with studios. My apps live at <a href="https://testamentmade.com" target="_blank" rel="noopener">testamentmade.com</a>.</p>
    <WorkIndex work={entries} />

    <h2 class="h">What people say</h2>
    <div class="quotes">
      {testimonials.map((t) => (
        <figure class="qcard sq">
          <p>{t.quote}</p>
          <span><b>{t.author}</b>, {t.role}{t.context && ` · ${t.context}`}</span>
        </figure>
      ))}
    </div>
    <Elsewhere />
  </main>
  <script src="../../client/chips.ts"></script>
</Site>
