---
import Site from '../../layouts/Site.astro';
import PageHead from '../../components/site/PageHead.astro';
import WorkIndex from '../../components/site/WorkIndex.astro';
import { getPublishedWork } from '../../lib/work';
import Said from '../../components/site/Said.astro';

const entries = await getPublishedWork();
---
<Site
  title="Work — Derek Castelli"
  description="Write-ups from the sites I've designed and built, on my own and with studios like Kem Design."
  bar={{ kind: 'page', title: 'Work' }}
>
  <main class="home">
    <PageHead title="Sites" meta={`Work · ${entries.length} write-ups`}><Fragment slot="lede">The sites I've designed and built, on my own and with studios I love working alongside.</Fragment></PageHead>
    <WorkIndex work={entries} />

    <h2 class="h">What people say</h2>
    <Said />
  </main>
  <script src="../../client/chips.ts"></script>
</Site>
