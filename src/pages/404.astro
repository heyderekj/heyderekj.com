---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import PostIndex from '../components/site/PostIndex.astro';
import { getPublishedPosts } from '../lib/posts';

const siteUrl = (Astro.site?.toString() ?? 'https://heyderekj.com').replace(/\/$/, '');
const canonical = `${siteUrl}/404/`;
const title = 'Page not found — Derek Castelli';
const description = 'This URL does not exist on heyderekj.com.';
const latest = (await getPublishedPosts()).slice(0, 3);
---
<Site title={title} description={description} canonical={canonical} noindex includeAnalytics={false} bar={{ kind: 'page', title: 'Not found' }}>
  <main class="home">
    <PageHead meta="404" title="Not found">
      <Fragment slot="lede">This page isn’t here: maybe a broken link, a typo, or an old bookmark. Head <a href="/">home</a>, or press / to search for something that is.</Fragment>
    </PageHead>
    <h2 class="h h--quiet">The latest writing</h2>
    <PostIndex posts={latest} show={Infinity} />
  </main>
  <script src="../client/peek.ts"></script>
  <script src="../client/chips.ts"></script>
</Site>
