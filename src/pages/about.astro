---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import ApplicationToc from '../components/ApplicationToc.astro';
import BragSkillsList from '../components/BragSkillsList.astro';
import {
  bragMeta,
  bragHero,
  bragEpigraphNote,
  bragClippings,
  bragRightNow,
  bragSkills,
  bragConnect,
  sortBragFavoritePosts,
} from '../data/brag';
import type { BragPreview } from '../data/brag';
import { aboutExperienceGroups } from '../data/about';
import { projectStartTime } from '../lib/projectStart';
import { computeBragStatCycles } from '../lib/bragProjectTrend';

const tocItems = [
  { id: 'now', label: 'Right now' },
  { id: 'highlights', label: 'Highlights' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Experience' },
  { id: 'connect', label: 'Connect' },
];

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projectCount = allProjects.length;
const projectStartYear = allProjects.reduce((min, project) => {
  const t = projectStartTime(project);
  if (!t) return min;
  const y = new Date(t).getUTCFullYear();
  return y < min ? y : min;
}, new Date().getUTCFullYear());
const projectStatCycles = computeBragStatCycles(allProjects, projectCount, projectStartYear);
const projectStatCyclesJson = JSON.stringify(projectStatCycles);

const previewsFor = (clip: (typeof bragClippings)[number]): BragPreview[] => {
  if (!clip.preview) return [];
  return Array.isArray(clip.preview) ? clip.preview : [clip.preview];
};

const isImagePreview = (preview: BragPreview) => !preview.variant || preview.variant === 'image';

const imagePreviewCount = (previews: BragPreview[]) =>
  previews.filter(isImagePreview).length;

const fmtPostDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Base title="About — Derek Castelli" description={bragMeta.description}>
  <article class="prose brag-page about-page">

    <PageTitle path="/about" />

    <ApplicationToc items={tocItems} />

    <header class="brag-hero">
      <img
        class="brag-hero__photo"
        src={bragHero.photoSrc}
        alt={bragHero.photoAlt}
        width={112}
        height={112}
        decoding="async"
      />
      <div class="brag-hero__copy">
        <h2 class="brag-hero__headline">{bragHero.headline}</h2>
        <p class="brag-hero__role">
          <i class="ph-bold ph-map-pin" aria-hidden="true"></i>
          {bragHero.location}
        </p>
        <p class="brag-hero__bio">{bragHero.bio}</p>
      </div>
    </header>

    <section id="now" class="brag-now about-anchor" aria-labelledby="brag-now-heading">
      <h2 id="brag-now-heading" class="brag-now__heading">Right now</h2>
      <ol class="brag-now__list" role="list">
        {bragRightNow.map((item) => (
          <li class="brag-now__item">
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              item.label
            )}
          </li>
        ))}
      </ol>
    </section>

    <section id="highlights" class="about-anchor about-highlights" aria-labelledby="about-highlights-heading">
      <h2 id="about-highlights-heading" class="sr-only">Highlights</h2>
      <ol class="brag-feed" role="list">
      {bragClippings.map((clip) => {
        const previews = previewsFor(clip);
        return (
          <li class="brag-item">
            <div class="brag-item-copy">
              <p class="brag-item-kicker">
                <span class="brag-item-pub">{clip.publication}</span>
                <span class="brag-item-kicker-dot" aria-hidden="true">·</span>
                <time class="brag-item-date" datetime={clip.dateline}>{clip.dateline}</time>
              </p>

              {clip.href ? (
                <h2 class="brag-item-title">
                  <a href={clip.href}>{clip.headline}</a>
                </h2>
              ) : (
                <h2 class="brag-item-title">{clip.headline}</h2>
              )}

              <p class="brag-item-summary">{clip.summary}</p>
            </div>

            {previews.length > 0 && (
              <div
                class:list={[
                  'brag-item-previews',
                  imagePreviewCount(previews) > 1 && 'brag-item-previews--multi',
                ]}
                aria-label="Related work preview"
              >
                {previews.map((preview) => {
                  const href = preview.href ?? clip.href;

                  if (preview.variant === 'posts' && preview.favoritePosts?.length) {
                    return (
                      <div class="brag-preview brag-preview--posts">
                        <ul class="entries" role="list">
                          {sortBragFavoritePosts(preview.favoritePosts).map((post) => (
                            <li>
                              <a
                                href={post.href}
                                class="entry-link"
                                {...(post.external
                                  ? { target: '_blank', rel: 'noopener noreferrer' }
                                  : {})}
                              >
                                {post.date ? (
                                  <time datetime={post.date} class="entry-date">
                                    {fmtPostDate(post.date)}
                                  </time>
                                ) : post.likes ? (
                                  <span class="entry-date">{post.likes} likes on X</span>
                                ) : null}
                                <span class="entry-title">{post.title}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    );
                  }

                  if (
                    preview.variant === 'stats' &&
                    (preview.aggregateProjects || (preview.projectStats?.length ?? 0) > 0)
                  ) {
                    return (
                      <div class="brag-preview brag-preview--stats">
                        <div
                          class:list={[
                            'brag-stats-panel',
                            preview.aggregateProjects && 'brag-stats-panel--aggregate',
                          ]}
                        >
                          {preview.caption && (
                            <p class="brag-stats-panel__label">{preview.caption}</p>
                          )}
                          {preview.aggregateProjects ? (
                            <div class="brag-stat-aggregate">
                              <div
                                class="brag-stat-hero-wrap"
                                data-brag-stat-cycler
                                data-slides={projectStatCyclesJson}
                                aria-live="polite"
                                aria-label={`${projectCount} side projects since ${projectStartYear}`}
                              >
                                <div class="brag-stat-hero">
                                  <p class="brag-stat-hero__value">{projectStatCycles[0]!.value}</p>
                                  <p class="brag-stat-hero__label" data-brag-stat-label>
                                    <span class="brag-stat-hero__label-line" data-brag-stat-label-primary>
                                      {[projectStatCycles[0]!.kicker, projectStatCycles[0]!.title]
                                        .filter(Boolean)
                                        .join(' ')}
                                    </span>
                                    <span class="brag-stat-hero__label-line" data-brag-stat-label-secondary>
                                      {projectStatCycles[0]!.subtitle ?? ' '}
                                    </span>
                                  </p>
                                </div>
                                {projectStatCycles.length > 1 && (
                                  <button
                                    type="button"
                                    class="brag-stat-cycle"
                                    aria-label="Next project stat"
                                  >
                                    <i class="ph-bold ph-arrows-clockwise" aria-hidden="true" />
                                  </button>
                                )}
                              </div>
                              {preview.linkLabel && preview.href && (
                                <a class="about-exp-pill about-exp-pill--link brag-stats-more" href={preview.href}>
                                  <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                  {preview.linkLabel}
                                </a>
                              )}
                            </div>
                          ) : (
                            <ul class="entries brag-stats" role="list">
                              {preview.projectStats!.map((project) => (
                                <li>
                                  <a href={project.href} class="entry-link">
                                    <span class="entry-date brag-stat-name">{project.name}</span>
                                    <span class="entry-title">{project.metrics}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                          {!preview.aggregateProjects &&
                            preview.linkLabel &&
                            preview.href && (
                              <a class="about-exp-pill about-exp-pill--link brag-stats-more" href={preview.href}>
                                <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                {preview.linkLabel}
                              </a>
                            )}
                        </div>
                      </div>
                    );
                  }

                  if (preview.variant === 'link' && preview.href && preview.linkLabel) {
                    return (
                      <div class="brag-preview brag-preview--link">
                        <a
                          class="about-exp-pill about-exp-pill--link brag-link-pill"
                          href={preview.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                          {preview.linkLabel}
                        </a>
                      </div>
                    );
                  }

                  if (preview.variant === 'experience') {
                    return (
                      <a class="brag-preview brag-preview--experience" href={href}>
                        <div class="about-exp-group">
                          <ul class="about-exp-group__list">
                            <li class="about-exp-item">
                              {preview.range && (
                                <p class="about-exp-item__range">{preview.range}</p>
                              )}
                              <p class="about-exp-item__name">{preview.name ?? clip.headline}</p>
                              {preview.description && (
                                <p class="about-exp-item__desc">{preview.description}</p>
                              )}
                              {preview.linkLabel && (
                                <span class="about-exp-pill">
                                  <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                                  {preview.linkLabel}
                                </span>
                              )}
                            </li>
                          </ul>
                        </div>
                      </a>
                    );
                  }

                  const media = preview.src ? (
                    <div class:list={['brag-preview-media', preview.variant === 'video' && 'brag-preview-media--video']}>
                      <img
                        class="brag-preview-img"
                        src={preview.src}
                        alt={preview.alt}
                        width={320}
                        height={preview.variant === 'video' ? 180 : 320}
                        loading="lazy"
                        decoding="async"
                      />
                      {preview.variant === 'video' && (
                        <span class="brag-preview-play" aria-hidden="true">
                          <i class="ph-fill ph-play" />
                        </span>
                      )}
                    </div>
                  ) : (
                    <div class="brag-preview-media brag-preview-media--icon" aria-hidden="true">
                      <i class={`ph-bold ph-${preview.icon}`} />
                    </div>
                  );
                  const caption = preview.caption ? (
                    <span class="brag-preview-caption">{preview.caption}</span>
                  ) : null;

                  if (preview.variant === 'video' && preview.youtubeId) {
                    return (
                      <a
                        class="brag-preview"
                        href={href}
                        data-video-modal-trigger
                        data-youtube-id={preview.youtubeId}
                        aria-haspopup="dialog"
                      >
                        {media}
                        {caption}
                      </a>
                    );
                  }

                  return href ? (
                    <a class="brag-preview" href={href}>
                      {media}
                      {caption}
                    </a>
                  ) : (
                    <div class="brag-preview">
                      {media}
                      {caption}
                    </div>
                  );
                })}
              </div>
            )}

            {clip.testimonial && (
              <figure class="brag-item-testimonial">
                <blockquote class="work-testimonial-quote">{clip.testimonial.quote}</blockquote>
                <figcaption class="work-testimonial-footer">
                  <p class="work-testimonial-name">{clip.testimonial.author}</p>
                  <p class="work-testimonial-role">{clip.testimonial.role}</p>
                  <p class="work-testimonial-context">{clip.testimonial.context}</p>
                </figcaption>
              </figure>
            )}
          </li>
        );
      })}
      </ol>
    </section>

    <div class="brag-epigraph-wrap" tabindex="0">
      <blockquote class="brag-epigraph-plaque">
        <p class="brag-epigraph-plaque__quote">
          You’re only given a little spark of madness.<br />
          You mustn’t lose it.
        </p>
        <footer class="brag-epigraph-plaque__attrib">
          <span class="brag-epigraph-plaque__rule" aria-hidden="true"></span>
          <cite>Robin Williams</cite>
        </footer>
      </blockquote>
      <aside class="brag-epigraph-note" data-brag-epigraph-note aria-label="Personal note about Robin Williams">
        <p id="brag-epigraph-note-text" class="brag-epigraph-note__text">{bragEpigraphNote}</p>
      </aside>
    </div>

    <section id="skills" class="about-anchor">
      <BragSkillsList skills={bragSkills} label="Skills" />
    </section>

    <section id="experience" class="about-experience about-anchor" aria-labelledby="about-exp-heading">
      <h2 id="about-exp-heading">Experience</h2>
      <div class="about-exp-stack">
        {aboutExperienceGroups.map((group) => (
          <div class="about-exp-group">
            <h3 class="about-exp-group__title">{group.title}</h3>
            <ul class="about-exp-group__list">
              {group.items.map((item) => (
                <li class="about-exp-item">
                  <p class="about-exp-item__range">{item.range}</p>
                  <p class="about-exp-item__name">{item.name}</p>
                  <p class="about-exp-item__desc">{item.description}</p>
                  {item.link && (
                    <a
                      class="about-exp-pill about-exp-pill--link"
                      href={item.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.link.icon === 'newspaper' ? (
                        <i class="ph-bold ph-newspaper" aria-hidden="true" />
                      ) : (
                        <i class="ph-bold ph-arrow-right" aria-hidden="true" />
                      )}
                      {item.link.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <nav id="connect" class="brag-connect about-anchor" aria-label="Connect">
      {bragConnect.map((link) => (
        <a
          class="about-exp-pill about-exp-pill--link"
          href={link.href}
          {...(link.href.startsWith('mailto:')
            ? {}
            : { target: '_blank', rel: 'noopener noreferrer' })}
        >
          <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
          {link.label}
        </a>
      ))}
    </nav>

    <dialog class="video-modal" data-video-modal aria-label="Video player">
      <button type="button" class="video-modal__close" data-video-modal-close aria-label="Close video">
        <i class="ph-bold ph-x" aria-hidden="true"></i>
      </button>
      <div class="video-modal__frame">
        <iframe
          data-video-modal-iframe
          src=""
          title="Video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </dialog>
  </article>

  <script>
    function initBragStatCyclers() {
      document.querySelectorAll('[data-brag-stat-cycler]').forEach((root) => {
        if (root.dataset.bragStatInit) return;
        root.dataset.bragStatInit = '1';

        const raw = root.getAttribute('data-slides');
        if (!raw) return;
        let slides;
        try {
          slides = JSON.parse(raw);
        } catch {
          return;
        }
        if (!Array.isArray(slides) || slides.length < 2) return;

        const btn = root.querySelector('.brag-stat-cycle');
        const valueEl = root.querySelector('.brag-stat-hero__value');
        const primaryEl = root.querySelector('[data-brag-stat-label-primary]');
        const secondaryEl = root.querySelector('[data-brag-stat-label-secondary]');
        if (!btn || !valueEl || !primaryEl || !secondaryEl) return;

        const formatLabel = (s) => ({
          primary: [s.kicker, s.title].filter(Boolean).join(' '),
          secondary: s.subtitle || ' ',
          spoken: [s.kicker, s.title, s.subtitle].filter(Boolean).join(' '),
        });

        let i = 0;
        const show = (idx) => {
          const s = slides[idx];
          const label = formatLabel(s);
          valueEl.textContent = s.value;
          primaryEl.textContent = label.primary;
          secondaryEl.textContent = label.secondary;
          root.setAttribute('aria-label', [s.value, label.spoken].filter(Boolean).join(' '));
        };

        btn.addEventListener('click', () => {
          i = (i + 1) % slides.length;
          show(i);
        });
      });
    }

    initBragStatCyclers();
    document.addEventListener('astro:page-load', initBragStatCyclers);

function initBragEpigraphNote() {
      document.querySelectorAll('[data-brag-epigraph-note]').forEach((note) => {
        if (!(note instanceof HTMLElement) || note.dataset.bragEpigraphNoteInit) return;

        const wrap = note.closest('.brag-epigraph-wrap');
        if (!(wrap instanceof HTMLElement)) return;

        note.dataset.bragEpigraphNoteInit = '1';

        const setOpen = (open) => note.classList.toggle('is-open', open);

        wrap.addEventListener('click', (e) => {
          if (window.matchMedia('(hover: hover)').matches) return;
          const target = e.target;
          if (!(target instanceof Node) || !wrap.contains(target)) return;
          if (target instanceof Element && target.closest('a')) return;
          setOpen(!note.classList.contains('is-open'));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      });
    }

    initBragEpigraphNote();
    document.addEventListener('astro:page-load', initBragEpigraphNote);

    function initBragVideoModal() {
      const dialog = document.querySelector('[data-video-modal]');
      if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.videoModalInit) return;
      dialog.dataset.videoModalInit = '1';

      const iframe = dialog.querySelector('[data-video-modal-iframe]');
      const closeBtn = dialog.querySelector('[data-video-modal-close]');
      if (!(iframe instanceof HTMLIFrameElement)) return;

      const stop = () => {
        iframe.src = '';
      };
      const close = () => {
        dialog.close();
        stop();
      };

      // Escape triggers the browser's native close path, bypassing `close()` above.
      dialog.addEventListener('close', stop);

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) close();
      });

      closeBtn?.addEventListener('click', close);

      document.querySelectorAll('[data-video-modal-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          if (!(e instanceof MouseEvent)) return;
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const id = trigger.getAttribute('data-youtube-id');
          if (!id) return;
          e.preventDefault();
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&cc_load_policy=0`;
          dialog.showModal();
        });
      });
    }

    initBragVideoModal();
    document.addEventListener('astro:page-load', initBragVideoModal);
  </script>
</Base>

<style>
  .about-anchor {
    scroll-margin-top: var(--space-4);
  }

  /* Reserve space so the floating TOC pill doesn't cover Connect */
  .brag-connect {
    padding-bottom: 4.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .brag-connect {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .brag-epigraph-wrap {
    --brag-plaque-frame: color-mix(in srgb, #5a5a5a 8%, var(--border-strong));
    --brag-plaque-rule: color-mix(in srgb, #5a5a5a 6%, var(--border));
    --brag-plaque-surface-top: color-mix(in srgb, #6e6e6e 7%, var(--bg-elevated));
    --brag-plaque-surface-bottom: color-mix(in srgb, #5a5a5a 5%, var(--bg-elevated));
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin: var(--space-5) 0 0;
    max-width: 100%;
  }

  .brag-epigraph-plaque {
    position: relative;
    width: 100%;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    text-align: center;
    border: 1px solid var(--brag-plaque-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(
      180deg,
      var(--brag-plaque-surface-top),
      var(--brag-plaque-surface-bottom)
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 35%, transparent),
      0 1px 2px color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .brag-epigraph-plaque::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--brag-plaque-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.35;
  }

  .brag-epigraph-plaque__quote {
    margin: 0;
    max-width: 36ch;
    margin-inline: auto;
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(1.125rem, 2.5vw, 1.3125rem);
    line-height: 1.5;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .brag-epigraph-plaque__attrib {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-style: normal;
  }

  .brag-epigraph-plaque__rule {
    display: block;
    width: 2.25rem;
    height: 1px;
    background: var(--brag-plaque-rule);
  }

  .brag-epigraph-plaque__attrib cite {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  @media (prefers-color-scheme: dark) {
    .brag-epigraph-wrap {
      --brag-plaque-frame: color-mix(in srgb, #a8a8a8 7%, var(--border-strong));
      --brag-plaque-rule: color-mix(in srgb, #a8a8a8 5%, var(--border));
      --brag-plaque-surface-top: color-mix(in srgb, #a8a8a8 5%, var(--bg-elevated));
      --brag-plaque-surface-bottom: color-mix(in srgb, #6e6e6e 4%, #0a0a0a);
    }

    .brag-epigraph-plaque {
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, white 8%, transparent),
        0 2px 12px color-mix(in srgb, black 45%, transparent);
    }
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-plaque,
  .brag-epigraph-wrap:has(.brag-epigraph-note.is-open) .brag-epigraph-plaque {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-plaque::before,
  .brag-epigraph-wrap:has(.brag-epigraph-note.is-open) .brag-epigraph-plaque::before {
    border-bottom: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .brag-epigraph-note {
    --brag-note-surface: color-mix(in srgb, #6e6e6e 5%, var(--bg-elevated));
    width: 100%;
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
  }

  .brag-epigraph-wrap:is(:hover, :focus-within) .brag-epigraph-note,
  .brag-epigraph-note.is-open {
    position: relative;
    border: 1px solid var(--brag-plaque-frame);
    border-top: none;
