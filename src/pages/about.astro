---
/**
 * About, as a short letter: the byline and who I am, my story in six small chapters with the year
 * in the margin, what I'm doing now, three highlights, the signature, and the résumé folded away.
 */
import Site from '../layouts/Site.astro';
import Byline from '../components/site/Byline.astro';
import Signature from '../components/Signature.astro';
import Icon from '../components/Icon.astro';
import { bragClippings, bragHero, bragMeta, bragRightNow, bragSkills, type BragPreview } from '../data/brag';
import { aboutChapters, aboutExperienceGroups } from '../data/about';
import { imgSrc } from '../lib/img';

const previewsOf = (clip: (typeof bragClippings)[number]): BragPreview[] => !clip.preview ? [] : Array.isArray(clip.preview) ? clip.preview : [clip.preview];
const external = (href?: string) => Boolean(href && /^https?:/.test(href));
// The three highlights worth leading with: the podcast, the Mac apps, the faith-tech apps
const highlights = bragClippings.slice(0, 3).map((clip) => {
  const previews = previewsOf(clip);
  const video = previews.find((p) => p.variant === 'video');
  const image = previews.find((p) => p.src && p.variant !== 'video');
  return { clip, video, href: clip.href, peek: image?.src ? imgSrc(image.src, 640) : undefined };
});
const roles = aboutExperienceGroups.filter((g) => g.title !== 'Education').reduce((n, g) => n + g.items.length, 0);

// The résumé's timeline: every role and school as a bar on one axis, overlaps on their own lanes
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const now = new Date(), nowY = now.getUTCFullYear() + now.getUTCMonth() / 12;
const at = (s: string) => { const [m, y] = s.trim().split(/\s+/); return /present/i.test(s) ? nowY : Number(y) + Math.max(0, MONTHS.indexOf(m)) / 12; };
const spans = aboutExperienceGroups.flatMap((g) => g.items.map((it) => { const [a, b] = it.range.split('—'); return { name: it.name.replace(/ Co\.$/, ''), from: at(a), to: at(b ?? 'Present'), current: /present/i.test(b ?? ''), school: g.title === 'Education' }; }))
  .sort((x, y) => x.from - y.from);
const lanes: number[] = [];
const bars = spans.map((s) => { let lane = lanes.findIndex((end) => end <= s.from + 0.01); if (lane < 0) lane = lanes.length; lanes[lane] = s.to; return { ...s, lane }; });
const t0 = Math.floor(Math.min(...spans.map((s) => s.from))), t1 = Math.ceil(nowY);
const pct = (y: number) => `${(((y - t0) / (t1 - t0)) * 100).toFixed(2)}%`;
const ticks = Array.from({ length: t1 - t0 + 1 }, (_, i) => t0 + i).filter((y) => (y - t0) % 4 === 0 || y === t1);
---
<Site title="About — Derek Castelli" description={bragMeta.description} bar={{ kind: 'page', title: 'About' }}>
  <article class="essay about" data-select>
    <Byline />
    <h1 class="visually-hidden">About Derek Castelli</h1>
    <p class="lede">{bragHero.bio}</p>

    <ol class="story" id="story" data-bar-section="My story">
      {aboutChapters.map((c) => (
        <li class="story__ch"><span class="story__when">{c.when}</span><p><b>{c.title}</b> {c.text}</p></li>
      ))}
    </ol>

    <div class="prose">
      <h2 id="now" data-bar-section="Right now">Right now</h2>
      <div class="list"><section class="list__year">
        {bragRightNow.map((n) => n.href
          ? <a class="row sq" href={n.href} {...(external(n.href) ? { target: '_blank', rel: 'noopener' } : {})}><span class="row__title">{n.label}</span><span class="row__date"><Icon name="arrow-up-right" /></span></a>
          : <div class="row sq"><span class="row__title">{n.label}</span></div>)}
      </section></div>

      <h2 id="highlights" data-bar-section="Highlights">Highlights</h2>
      <div class="list"><section class="list__year">
        {highlights.map(({ clip, video, href, peek }) => <Fragment>{video?.youtubeId ? (
          <a class="vidcard" href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener">
            <span class="vidcard__still sq">
              {video.src && <img src={imgSrc(video.src, 1280)} alt={video.alt ?? ''} loading="lazy" decoding="async" />}
              <span class="vidcard__play"><Icon name="play" loop={false} /> Watch on YouTube</span>
            </span>
            <span class="vidcard__cap"><b>{clip.publication} · {clip.headline}</b><time>{clip.dateline}</time></span>
            <small>{clip.summary}</small>
          </a>
        ) : (
          <a class="row sq" href={href} data-peek-img={peek} {...(external(href) ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="row__kicker">{clip.publication}</span>
            <span class="row__title">{clip.headline}</span>
            <span class="row__date">{clip.dateline}</span>
            <span class="row__desc">{clip.summary}</span>
          </a>
        )}</Fragment>)}
      </section></div>
    </div>

    <div class="essay__sign"><Signature /></div>

    <details class="resume">
      <summary>
        <span class="resume__head"><span>Résumé</span><small>{roles} roles · {t0} to now</small><Icon name="chevron-down" /></span>
        <span class="tl" style={`--lanes:${lanes.length}`} aria-hidden="true">
          {ticks.map((y) => <i class="tl__tick" style={`left:${pct(y)}`}><em>{y === t1 ? 'Now' : y}</em></i>)}
          {bars.map((b) => <b class:list={['tl__bar', b.current && 'is-now', b.school && 'is-school']} style={`left:${pct(b.from)};width:calc(${pct(b.to)} - ${pct(b.from)});--lane:${b.lane}`} title={b.name}><span>{b.name}</span></b>)}
        </span>
      </summary>
      <div class="list">
        {aboutExperienceGroups.map((g) => (
          <section class="list__year">
            <h3>{g.title}</h3>
            {g.items.map((it) => it.link
              ? <a class="row sq" href={it.link.href} target="_blank" rel="noopener"><span class="row__title">{it.name}</span><span class="row__date">{it.range}</span><span class="row__desc">{it.description}</span></a>
              : <div class="row sq"><span class="row__title">{it.name}</span><span class="row__date">{it.range}</span><span class="row__desc">{it.description}</span></div>)}
          </section>
        ))}
      </div>
      <p class="resume__skills"><b>Good at:</b> {bragSkills.join(', ')}.</p>
    </details>
  </article>
  <div class="peek sq" id="peek" aria-hidden="true"></div>
  <div class="selbar" id="selbar" hidden></div>
  <script src="../client/peek.ts"></script>
  <script src="../client/select-menu.ts"></script>
  <script src="../client/chips.ts"></script>
</Site>
