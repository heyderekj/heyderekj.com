---
/*
  `/greptile/` — Brand Designer application page.

  Shares the `cio-` class namespace with `/customerio/` on purpose: it's this
  site's application-page namespace, and `src/client/reveal.ts` + `global.css`
  both key off those names (`.cio-proof`, `.cio-shots`, `.cio-shot-video-clip`).
  Renaming would mean editing shared files for zero visual gain.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import ApplicationToc from '../components/ApplicationToc.astro';
import FeaturedWorkGrid from '../components/FeaturedWorkGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { testimonials } from '../data/about';
import {
  greptileMeta,
  greptileIntro,
  greptileLetter,
  greptileBrandLead,
  greptileBrandBlocks,
  greptileLaunchLead,
  greptileLaunchBlocks,
  greptileWebLead,
  greptileWebParagraphs,
  greptileWhyParagraphs,
} from '../data/greptile';

const letter = greptileLetter;

const workSlugs = ['claimable', 'care-continuity'] as const;
const allWork = await getCollection('work', ({ data }) => !data.draft);
const craftWork = workSlugs
  .map((slug) => allWork.find((entry) => entry.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry != null);

/* Brand + launches render identical block markup — one map, two sections. */
const blockSections = [
  {
    id: 'brand',
    heading: '/ brand',
    headingHref: '/work/',
    lead: greptileBrandLead,
    blocks: greptileBrandBlocks,
  },
  {
    id: 'launches',
    heading: '/ launches',
    headingHref: '/projects/',
    lead: greptileLaunchLead,
    blocks: greptileLaunchBlocks,
  },
];

const tocItems = [
  { id: 'letter', label: 'Letter to Christine' },
  { id: 'brand', label: 'Brand' },
  { id: 'launches', label: 'Launches' },
  { id: 'web', label: 'Web craft' },
  { id: 'why-greptile', label: 'Why Greptile' },
  { id: 'recommendations', label: 'Recommendations' },
  { id: 'connect', label: 'Connect' },
];
---

<Base
  title={greptileMeta.title}
  description={greptileMeta.description}
  ogImage={greptileMeta.ogImage}
  noindex={true}
>
  <PageTitle path="/greptile" />

  <ApplicationToc items={tocItems} />

  <p class="cio-intro">
    Hey, I'm <span class="cio-chip"><img class="cio-chip__avatar" src={greptileIntro.photoSrc} alt={greptileIntro.photoAlt} width={18} height={18} decoding="async" /><span class="cio-chip__label">Derek</span></span>, a designer in Des Moines, IA. I've made brands and websites full-time since 2018, and for the past two years I've been designing, shipping, and launching my own developer tools. I'm applying for <strong>Brand Designer</strong> at <span class="cio-chip cio-chip--brand"><i class="ph-bold ph-git-branch" aria-hidden="true"></i><span class="cio-chip__label">Greptile</span></span>
  </p>

  <section id="letter" class="cio-letter" aria-label="Cover letter">
    <div class="cio-letter__fold" data-letter-fold>
      <div class="cio-letter__sheet" id="cio-letter-sheet">
        <header class="cio-letter__address">
          <p>
            <span class="cio-letter__label">To:</span>
            {letter.to}
          </p>
          <p>
            <span class="cio-letter__label">From:</span>
            {letter.from}
          </p>
        </header>

        <hr class="cio-letter__rule" aria-hidden="true" />

        <p class="cio-letter__salutation">{letter.salutation}</p>

        {letter.paragraphs.map((paragraph) => (
          <p class="cio-letter__paragraph">{paragraph}</p>
        ))}

        <p class="cio-letter__signoff">{letter.signoff}</p>
      </div>

      <button
        type="button"
        class="cio-letter__more"
        data-letter-more
        aria-expanded="false"
        aria-controls="cio-letter-sheet"
      >
        Read the full letter
      </button>
    </div>
  </section>

  {blockSections.map((section) => (
    <section id={section.id} class="cio-proof" aria-labelledby={`${section.id}-heading`}>
      <h2 id={`${section.id}-heading`} class="section-title">
        <a href={section.headingHref}>{section.heading}</a>
      </h2>
      <p class="cio-section-lead">{section.lead}</p>

      {section.blocks.map((block) => (
        <article
          class:list={[
            'cio-proof-block',
            block.shots.some((s) => s.type === 'video') && 'cio-proof-block--media-first',
          ]}
        >
          {(Array.isArray(block.html) ? block.html : [block.html]).map((p) => (
            <p class="cio-body" set:html={p} />
          ))}

          {block.shots.length > 0 && (
            <figure class="cio-shots">
              {block.shots.map((shot) =>
                shot.type === 'video' ? (
                  <div class="zoomable zoom-cell zoom-cell--video">
                    {/*
                      Div trigger (not <button>): native video controls are invalid
                      / broken inside a button once expanded.
                    */}
                    <div
                      class="zoom-trigger cio-shot-video-shell"
                      role="button"
                      tabindex="0"
                      aria-label="Zoom video"
                      aria-expanded="false"
                      style={[
                        shot.width && shot.height
                          ? `--cio-video-ar: ${shot.width} / ${shot.height}`
                          : null,
                        shot.width != null ? `--cio-video-w: ${shot.width}` : null,
                        shot.windowRadius != null
                          ? `--cio-window-radius: ${shot.windowRadius}`
                          : null,
                      ]
                        .filter(Boolean)
                        .join('; ')}
                    >
                      {/*
                        Clip wrapper: overflow+radius is more reliable on <video>
                        than border-radius on the media element itself (WebKit).
                        Radius is width-based (cqw) so corners stay circular.
                      */}
                      <span class="cio-shot-video-clip">
                        <video
                          class="cio-shot-video"
                          data-plyr
                          data-autoplay
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          poster={shot.poster}
                          width={shot.width}
                          height={shot.height}
                          aria-label={shot.alt}
                        >
                          <source src={shot.src} type="video/mp4" />
                        </video>
                      </span>
                    </div>
                  </div>
                ) : (
                  <div class:list={['zoomable', 'zoom-cell', shot.full && 'zoom-cell--full']}>
                    <button
                      type="button"
                      class="zoom-trigger"
                      aria-label="Zoom image"
                      aria-expanded="false"
                    >
                      <img
                        src={shot.src}
                        alt={shot.alt}
                        loading="lazy"
                        decoding="async"
                        class:list={[shot.full && 'cio-shot--wide']}
                      />
                    </button>
                  </div>
                ),
              )}
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          )}

          {block.posts && block.posts.length > 0 && (
            <ul class="entries cio-posts" role="list">
              {block.posts.map((post) => (
                <li>
                  <a
                    href={post.href}
                    class="entry-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="entry-date">{post.likes} likes on X</span>
                    <span class="entry-title">{post.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {block.more && (
            <a href={block.more.href} class="cio-more">
              More on {block.more.label}
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          )}
        </article>
      ))}
    </section>
  ))}

  <section id="web" class="cio-craft" aria-labelledby="greptile-web-heading">
    <h2 id="greptile-web-heading" class="section-title">/ web craft</h2>
    <p class="cio-section-lead">{greptileWebLead}</p>
    {greptileWebParagraphs.map((p) => (
      <p class="cio-body" set:html={p} />
    ))}
    {craftWork.length > 0 && <FeaturedWorkGrid work={craftWork} preserveOrder />}
  </section>

  <section id="why-greptile" class="cio-why" aria-labelledby="greptile-why-heading">
    <h2 id="greptile-why-heading" class="section-title">/ why greptile</h2>
    {greptileWhyParagraphs.map((p) => (
      <p class="cio-body" set:html={p} />
    ))}
  </section>

  <div id="recommendations">
    <TestimonialCarousel testimonials={testimonials} headingId="greptile-testimonials-heading" />
  </div>

  <nav id="connect" class="cio-footer intro-links" aria-label="More on this site">
    <a href="mailto:derekj@hey.com" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      derekj@hey.com
    </a>
    <a href="/work/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Work
    </a>
    <a href="/projects/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Projects
    </a>
    <a href="/posts/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Posts
    </a>
  </nav>

  <script is:inline>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const fold = document.querySelector('[data-letter-fold]');
    const more = document.querySelector('[data-letter-more]');
    if (fold && more) {
      more.addEventListener('click', () => {
        const open = fold.classList.toggle('is-open');
        more.setAttribute('aria-expanded', open ? 'true' : 'false');
        more.textContent = open ? 'Show less' : 'Read the full letter';
        if (!open) {
          fold.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });
    }
  </script>
</Base>

<style is:global>
  /* Chips must be global: block chips arrive via set:html and never get
     Astro's scoped attribute. One definition covers intro + block chips. */
  .cio-chip,
  main.main a.cio-chip {
    --cio-chip-pad-y: 0.32em;
    display: inline-flex;
    /* Baseline from the label text — not the avatar (replaced elems baseline
       at their bottom edge and lift the whole chip vs surrounding copy). */
    align-items: baseline;
    gap: 0.28em;
    padding: var(--cio-chip-pad-y) 0.65em var(--cio-chip-pad-y) 0.45em;
    /* Pull the taller chip out of the line box so paragraph leading stays put */
    margin-block: calc(var(--cio-chip-pad-y) * -1);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-size: 0.94em;
    font-weight: 600;
    line-height: 1.15;
    color: var(--fg);
    white-space: nowrap;
    text-decoration: none;
    vertical-align: baseline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Beat `main.main a` hairline / color: inherit on linked chips */
  main.main a.cio-chip {
    border: 1px solid var(--border);
    border-bottom-style: solid;
    color: var(--chip-color, var(--fg));
  }

  main.main a.cio-chip:hover {
    border-color: color-mix(in srgb, var(--chip-color, var(--fg)) 55%, var(--border));
    background: color-mix(in srgb, var(--chip-color, var(--fg)) 12%, var(--bg-elevated));
  }

  .cio-chip[href] {
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cio-chip__label {
    display: inline;
    line-height: 1.15;
  }

  .cio-chip i {
    font-size: 0.85em;
    margin: 0;
    line-height: 1;
    align-self: center;
    transform: translateY(0.06em);
  }

  .cio-chip__avatar {
    display: block;
    width: 1em;
    height: 1em;
    margin: 0;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    align-self: center;
  }

  /* Greptile chip stays neutral on purpose — this page is my site making a
     case, not wearing their brand. Project chips keep their own colors. */
  .cio-chip--brand,
  main.main a.cio-chip--brand {
    padding-left: 0.5em;
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .cio-chip--scenery,
  main.main a.cio-chip--scenery {
    --chip-color: #d97706;
  }

  .cio-chip--eternity,
  main.main a.cio-chip--eternity {
    --chip-color: #0f766e;
  }

  .cio-chip--ducker,
  main.main a.cio-chip--ducker {
    --chip-color: #6366f1;
  }

  .cio-chip--binky,
  main.main a.cio-chip--binky {
    --chip-color: #e11d48;
  }

  .cio-chip--dinky,
  main.main a.cio-chip--dinky {
    --chip-color: #3b82f6;
  }

  .cio-chip--harvous,
  main.main a.cio-chip--harvous {
    --chip-color: #006eff;
  }

  .cio-chip--hmc,
  main.main a.cio-chip--hmc {
    --chip-color: #a855f7;
  }

  .cio-chip--scenery,
  .cio-chip--eternity,
  .cio-chip--ducker,
  .cio-chip--binky,
  .cio-chip--dinky,
  .cio-chip--harvous,
  .cio-chip--hmc,
  main.main a.cio-chip--scenery,
  main.main a.cio-chip--eternity,
  main.main a.cio-chip--ducker,
  main.main a.cio-chip--binky,
  main.main a.cio-chip--dinky,
  main.main a.cio-chip--harvous,
  main.main a.cio-chip--hmc {
    color: var(--chip-color);
    border-color: color-mix(in srgb, var(--chip-color) 35%, var(--border));
    background: color-mix(in srgb, var(--chip-color) 12%, var(--bg-elevated));
  }

  @media (prefers-color-scheme: dark) {
    .cio-chip--scenery,
    main.main a.cio-chip--scenery {
      --chip-color: #fbbf24;
    }

    .cio-chip--eternity,
    main.main a.cio-chip--eternity {
      --chip-color: #5eead4;
    }

    .cio-chip--ducker,
    main.main a.cio-chip--ducker {
      --chip-color: #a5b4fc;
    }

    .cio-chip--binky,
    main.main a.cio-chip--binky {
      --chip-color: #fda4af;
    }

    .cio-chip--dinky,
    main.main a.cio-chip--dinky {
      --chip-color: #93c5fd;
    }

    .cio-chip--harvous,
    main.main a.cio-chip--harvous {
      --chip-color: #60a5fa;
    }

    .cio-chip--hmc,
    main.main a.cio-chip--hmc {
      --chip-color: #d8b4fe;
    }
  }
</style>

<style>
  .cio-intro {
    margin: 0 0 var(--space-4);
    max-width: 93%;
    font-size: var(--size-lead);
    line-height: 1.75;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cio-intro strong {
    color: var(--fg);
    font-weight: 600;
  }

  /* Neutral letter: site tokens only, no borrowed brand palette. */
  .cio-letter {
    --letter-frame: var(--border-strong);
    --letter-rule: var(--border);
    --letter-surface-top: var(--bg-elevated);
    --letter-surface-bottom: var(--bg);
    --letter-ink-soft: var(--fg-soft);
    --letter-ink-muted: var(--muted);
    --letter-fold-max: min(26rem, 48dvh);
    margin-bottom: var(--space-5);
    max-width: 100%;
  }

  .cio-letter__fold {
    position: relative;
  }

  .cio-letter__sheet {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--letter-surface-top), var(--letter-surface-bottom));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 1px 3px color-mix(in srgb, var(--fg) 5%, transparent);
  }

  .cio-letter__fold:not(.is-open) .cio-letter__sheet {
    max-height: var(--letter-fold-max);
    overflow: hidden;
    border-bottom: 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  /* Keep the inner frame, but fade its rails with the fold so sides don’t stub out */
  .cio-letter__fold:not(.is-open) .cio-letter__sheet::before {
    bottom: 0;
    border-bottom: 0;
    border-radius: calc(var(--radius-sm) - 3px) calc(var(--radius-sm) - 3px) 0 0;
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 92%);
  }

  /* Fade lives on the sheet (not the fold) so it covers flush to the clip edge */
  .cio-letter__fold:not(.is-open) .cio-letter__sheet::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8.5rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--letter-surface-bottom) 0%, transparent) 0%,
      color-mix(in srgb, var(--letter-surface-bottom) 55%, transparent) 45%,
      var(--letter-surface-bottom) 78%,
      var(--letter-surface-bottom) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .cio-letter__more {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--letter-frame);
    border-top: 0;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--letter-surface-bottom);
    color: var(--letter-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .cio-letter__more:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--letter-surface-bottom) 70%, var(--bg-elevated));
  }

  .cio-letter__more:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .cio-letter__fold.is-open .cio-letter__more {
    margin-top: var(--space-2);
    border-top: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
  }

  .cio-letter__sheet::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--letter-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.35;
    z-index: 1;
  }

  .cio-letter__address {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    line-height: 1.65;
    color: var(--letter-ink-soft);
  }

  .cio-letter__address p {
    margin: 0;
  }

  .cio-letter__address p + p {
    margin-top: 0.15em;
  }

  .cio-letter__label {
    display: inline-block;
    min-width: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--letter-ink-muted);
  }

  .cio-letter__rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--letter-rule);
  }

  .cio-letter__salutation,
  .cio-letter__paragraph {
    margin: 0 0 var(--space-3);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--letter-ink-soft);
    text-wrap: pretty;
  }

  .cio-letter__salutation {
    margin-bottom: var(--space-2);
  }

  .cio-letter__signoff {
    margin: var(--space-4) 0 0;
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--letter-ink-soft);
  }

  .cio-proof,
  .cio-craft,
  .cio-why {
    margin-bottom: var(--space-5);
  }

  .cio-section-lead,
  .cio-body {
    margin: 0 0 var(--space-3);
    max-width: 93%;
    font-size: 16px;
    line-height: 1.8;
    color: var(--fg);
    text-wrap: pretty;
  }

  .cio-body:last-of-type {
    margin-bottom: 0;
  }

  /* Each block reads as one unit: story, its own shots, a way in. */
  .cio-proof-block {
    margin: 0 0 var(--space-6);
  }

  .cio-proof-block:last-of-type {
    margin-bottom: 0;
  }

  /* Tour video leads, then the written beat */
  .cio-proof-block--media-first {
    display: flex;
    flex-direction: column;
  }

  .cio-proof-block--media-first .cio-shots {
    order: -1;
    margin: 0 0 var(--space-3);
  }

  .cio-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-items: start;
    margin: var(--space-3) 0 0;
  }

  .cio-shots .zoom-cell {
    margin: 0;
    min-width: 0;
  }

  .cio-shots .zoom-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cio-shots .zoom-cell.is-zoomed > .zoom-trigger {
    cursor: zoom-out;
  }

  .cio-shots .zoom-cell.is-zoomed .cio-shot-video,
  .cio-shots .zoom-cell.is-zoomed .cio-shot-video-clip,
  .cio-shots .zoom-cell.is-zoomed .cio-shot-video-clip :global(.plyr) {
    cursor: default;
  }

  .cio-shots img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    padding: 14px;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  /* Wide artifacts (sites, splash pages) lead the block across both columns —
     a 16:10 screenshot in a square half-width cell is unreadably small. */
  .cio-shots > .zoom-cell--full {
    grid-column: 1 / -1;
  }

  .cio-shots img.cio-shot--wide {
    aspect-ratio: 16 / 10;
    padding: clamp(14px, 3vw, 28px);
  }

  .cio-shots .cio-shot-video-shell {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 18px 22px;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

