---
import Base from '../../layouts/Base.astro';
import { peopleMeta, people } from '../../data/people';
---
<Base title={peopleMeta.title} description={peopleMeta.description}>
  <article class="prose">
    <h1>People I'd like to meet IRL</h1>
    <p style="color: var(--fg-soft);">This is a list of people who have helped me and ones I admire and would love to meet in real life, someday.</p>

    <ul class="people-list">
      {people.map((person) => (
        <li class={person.met ? 'is-met' : ''}>
          <i
            class={person.met ? 'ph-bold ph-check-square-offset' : 'ph-bold ph-square'}
            aria-hidden="true"
          />
          <a href={person.xUrl} target="_blank" rel="noopener noreferrer" class="person-name">
            {person.name}
          </a>
          <span class="person-line" aria-hidden="true"></span>
          <span class="person-handle">{person.handle}</span>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .people-list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .people-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .people-list i {
    font-size: 1.1em;
    flex-shrink: 0;
    color: var(--muted-strong);
  }

  .is-met i {
    color: var(--accent);
  }

  .person-name {
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    border-bottom: none;
    white-space: nowrap;
    padding-inline-end: var(--space-2);
  }

  .people-list li:hover i {
    color: var(--accent);
  }

  .person-name:hover {
    color: var(--accent);
  }

  .is-met .person-name {
    color: var(--accent);
  }

  .person-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    padding-inline-start: var(--space-2);
  }

  .person-handle {
    font-size: var(--size-meta);
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-inline-start: var(--space-2);
  }
</style>
