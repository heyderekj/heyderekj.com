---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { peopleMeta, people } from '../../data/people';
---
<Base title={peopleMeta.title} description={peopleMeta.description}>
  <article class="prose">
    <PageTitle path="/people" />
    <p style="color: var(--fg-soft);">This is a list of people who have helped me and ones I admire and would love to meet in real life, someday.</p>

    <ul class="people-list">
      {people.map((person) => (
        <li class:list={[person.met && !person.remembered && 'is-met', person.remembered && 'is-remembered']}>
          {person.remembered ? (
            <>
              <span class="people-sr-only">Remembered — </span>
              <span class="memorial-icon-wrap" aria-hidden="true">
                <i class="ph-bold ph-heart" />
              </span>
            </>
          ) : (
            <i
              class={person.met ? 'ph-bold ph-check-square-offset' : 'ph-bold ph-square'}
              aria-hidden="true"
            />
          )}
          <a href={person.xUrl} target="_blank" rel="noopener noreferrer" class="person-name">
            {person.name}
          </a>
          <span class="person-line" aria-hidden="true"></span>
          <span class="person-handle">{person.handle}</span>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .people-list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .people-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: relative;
  }

  .people-list i {
    font-size: 1.1em;
    flex-shrink: 0;
    color: var(--muted-strong);
  }

  .memorial-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
  }

  .memorial-icon-wrap i {
    font-size: 1.1em;
    color: var(--muted-strong);
    opacity: 0.85;
  }

  .is-remembered .person-name {
    font-style: italic;
  }

  .is-remembered:hover .memorial-icon-wrap i {
    color: var(--accent);
    opacity: 1;
  }

  .people-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .is-met i {
    color: var(--accent);
  }

  .person-name {
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    border-bottom: none;
    white-space: nowrap;
    padding-inline-end: var(--space-2);
  }

  .people-list li:hover i {
    color: var(--accent);
  }

  .person-name:hover {
    color: var(--accent);
  }

  .is-met .person-name {
    color: var(--accent);
  }

  .person-line {
    flex: 1;
    height: 1px;
    background: var(--border);
    padding-inline-start: var(--space-2);
  }

  .person-handle {
    font-size: var(--size-meta);
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-inline-start: var(--space-2);
  }
</style>
