---
import Site from '../../layouts/Site.astro';
import PostIndex from '../../components/site/PostIndex.astro';
import { getPublishedPosts, tagCounts, type Post } from '../../lib/posts';
import { topicLabel, topics } from '../../data/topics';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const unknown = tagCounts(posts).filter(({ tag }) => !topics[tag]);
  if (unknown.length) {
    console.warn(`[topics] tags missing from src/data/topics.ts: ${unknown.map((u) => u.tag).join(', ')}`);
  }
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, entries: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  entries: Post[];
}

const { tag, entries } = Astro.props;
const label = topicLabel(tag);
const description = topics[tag]?.description;
---
<Site bar={{ kind: 'page', title: label }} title={`${label} — Derek Castelli`} description={description ?? `Posts about ${label}.`}>
  <main class="home">
    <h1 class="page-h">{label}</h1>
    <p class="page-lede">{description ?? `Posts about ${label}.`} <a href="/topics/">All topics</a></p>
    <PostIndex posts={entries} show={Infinity} />
  </main>
  <script src="../../client/peek.ts"></script>
</Site>
