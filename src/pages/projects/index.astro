---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import FeaturedProjectGrid from '../../components/FeaturedProjectGrid.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projectStartTime } from '../../lib/projectStart';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const activeProjects = projects
  .filter((p) => p.data.status === 'active')
  .sort((a, b) => projectStartTime(b) - projectStartTime(a));
const maintainedProjects = projects
  .filter((p) => p.data.status === 'maintained')
  .sort((a, b) => projectStartTime(b) - projectStartTime(a));
const pausedProjects = projects
  .filter((p) => p.data.status === 'paused')
  .sort((a, b) => projectStartTime(b) - projectStartTime(a));
const retiredProjects = projects
  .filter((p) => p.data.status === 'retired')
  .sort((a, b) => projectStartTime(b) - projectStartTime(a));
---
<Base title="Projects — Derek Castelli" description="Apps and sites built by Derek Castelli.">
  <PageTitle path="/projects" />
  <p style="color: var(--fg-soft); max-width: var(--max-prose);">
    Apps and experiments—design, code, and AI.
  </p>

  {activeProjects.length > 0 && (
    <>
      <h2 class="projects-section-title" id="front-burner">Front Burner</h2>
      <p class="projects-section-lede">Current focus—shipping and active builds.</p>
      <FeaturedProjectGrid projects={activeProjects} preserveOrder variant="work" />
    </>
  )}

  {maintainedProjects.length > 0 && (
    <>
      <h2 class="projects-section-title" id="simmering">Simmering</h2>
      <p class="projects-section-lede">
        Live projects kept warm—maintained and open, but not the current focus.
      </p>
      <FeaturedProjectGrid projects={maintainedProjects} preserveOrder variant="work" />
    </>
  )}

  {pausedProjects.length > 0 && (
    <>
      <h2 class="projects-section-title" id="back-burner">Back Burner</h2>
      <p class="projects-section-lede">
        {`${pausedProjects.length} ${pausedProjects.length === 1 ? 'project' : 'projects'} on the back burner—they may still continue.`}
      </p>
      <FeaturedProjectGrid projects={pausedProjects} preserveOrder variant="work" />
    </>
  )}

  {retiredProjects.length > 0 && (
    <>
      <h2 class="projects-section-title" id="retired">Retired</h2>
      <p class="projects-section-lede">
        {retiredProjects.length} past {retiredProjects.length === 1 ? 'project' : 'projects'} from the archive.
      </p>
      <ProjectList projects={retiredProjects} variant="row" startedOrder="desc" />
    </>
  )}
</Base>

<style>
  .projects-section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-top: var(--space-6);
    margin-bottom: var(--space-1);
    scroll-margin-top: var(--space-3);
  }

  .projects-section-title:first-of-type {
    margin-top: var(--space-5);
  }

  .projects-section-lede {
    margin: 0 0 var(--space-3);
    font-size: var(--size-meta);
    color: var(--fg-soft);
  }
</style>
