---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import FeaturedProjectGrid from '../../components/FeaturedProjectGrid.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import ProjectArchive from '../../components/ProjectArchive.astro';
import { getProjectsByTier, TIER_LABELS } from '../../lib/projectTiers';

const { focus, building, paused, archive } = await getProjectsByTier();
---
<Base title="Projects — Derek Castelli" description="Apps and sites built by Derek Castelli.">
  <PageTitle path="/projects" />
  <p style="color: var(--fg-soft); max-width: var(--max-prose);">
    Apps and experiments—design, code, and AI. Most of my time goes to the first two.
  </p>

  {focus.length > 0 && (
    <>
      <h2 class="projects-section-title" id="focus">{TIER_LABELS.focus}</h2>
      <p class="projects-section-lede">Where most of my time goes right now.</p>
      <FeaturedProjectGrid projects={focus} />
    </>
  )}

  {building.length > 0 && (
    <>
      <h2 class="projects-section-title" id="building">{TIER_LABELS.building}</h2>
      <p class="projects-section-lede">Live, shipping, and still getting attention.</p>
      <FeaturedProjectGrid projects={building} />
    </>
  )}

  {paused.length > 0 && (
    <>
      <h2 class="projects-section-title" id="more">{TIER_LABELS.more}</h2>
      <p class="projects-section-lede">Shipped and paused.</p>
      <ProjectRows projects={paused} />
    </>
  )}

  {archive.length > 0 && (
    <>
      <h2 class="projects-section-title" id="archive">{TIER_LABELS.archive}</h2>
      <p class="projects-section-lede">
        {archive.length} earlier projects, blogs, and shops—going back to {archive[archive.length - 1].data.started?.getUTCFullYear()}.
      </p>
      <ProjectArchive projects={archive} />
    </>
  )}
</Base>

<!-- Old section anchors (Front Burner era) still land somewhere sensible. -->
<script is:inline>
  (function () {
    var map = { 'front-burner': 'focus', simmering: 'building', 'back-burner': 'more', retired: 'archive' };
    var h = location.hash.slice(1);
    if (map[h]) {
      history.replaceState(null, '', '#' + map[h]);
      var el = document.getElementById(map[h]);
      if (el) el.scrollIntoView();
    }
  })();
</script>

<style>
  .projects-section-title {
    font-size: var(--size-h2);
    font-weight: 600;
    margin-top: var(--space-6);
    margin-bottom: var(--space-1);
    scroll-margin-top: var(--space-3);
  }

  .projects-section-title:first-of-type {
    margin-top: var(--space-5);
  }

  .projects-section-lede {
    margin: 0 0 var(--space-3);
    font-size: var(--size-meta);
    color: var(--fg-soft);
  }
</style>
