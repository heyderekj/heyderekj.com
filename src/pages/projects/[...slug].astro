---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaStepper from '../../components/MediaStepper.astro';
import { formatProjectStartLabel, formatProjectUpdatedLabel } from '../../lib/projectStart';
import { displayProjectStatus } from '../../lib/projectStatus';
import { schemaPersonId } from '../../lib/schemaIds';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

const startLabel = formatProjectStartLabel(project);
const updatedLabel = formatProjectUpdatedLabel(project);
const status = project.data.status;
const showMeta = Boolean(startLabel || updatedLabel || status);

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const pageUrl = new URL(`/projects/${project.slug}/`, `${siteOrigin}/`).toString();
const metaDesc = project.data.summary ?? project.data.tagline;
const projectJsonLd: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: project.data.name,
  description: metaDesc,
  url: project.data.url ?? pageUrl,
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
};
if (project.data.url) {
  projectJsonLd.sameAs = [project.data.url];
}

const media = project.data.media ?? [];
/** Detail-page hero: `hero` wins; cards elsewhere keep using `image`. */
const heroSrc = project.data.hero ?? project.data.image;
const showHero = Boolean(heroSrc) && !media.some((m) => m.src === heroSrc);
const heroPosition = project.data.heroPosition ?? 'center center';
const heroZoom = project.data.heroZoom ?? 1;
const heroImgStyle = [
  `object-position: ${heroPosition}`,
  heroZoom > 1
    ? `transform: scale(${heroZoom}); transform-origin: ${heroPosition}; --pfig-zoom: scale(${heroZoom})`
    : null,
]
  .filter(Boolean)
  .join('; ');
/** Solo tour video — no stepper chrome when there's only one clip */
const soloVideo = media.length === 1 && media[0]?.type === 'video' ? media[0] : null;
/** Match Customer.io proof clips: browser chrome vs native app window */
const soloVideoRadius =
  project.slug === 'dinky' ? 0.028 : project.slug === 'harvous' ? 0.007 : 0.01;
const soloVideoAr =
  project.slug === 'dinky'
    ? '440 / 492'
    : project.slug === 'harvous'
      ? '1240 / 770'
      : undefined;
---
<Base title={`${project.data.name} — Derek Castelli`} description={metaDesc} jsonLd={projectJsonLd}>
  <article class="prose">
    <header class="post-header project-detail-header">
      {project.data.url ? (
        <div class="project-header-title-row">
          <h1>{project.data.name}</h1>
          <a href={project.data.url} target="_blank" rel="noopener" class="cta project-header-cta">
            {project.data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      ) : (
        <h1>{project.data.name}</h1>
      )}
      {showMeta && (
        <div class="meta project-meta">
          {(startLabel || updatedLabel || status) && (
            <span class="project-meta-lead">
              {status && (
                <span class={`detail-status detail-status--${status}`}>
                  {displayProjectStatus(status)}
                </span>
              )}
              {startLabel && <span class="project-meta-start">Started {startLabel}</span>}
              {updatedLabel && (
                <>
                  {startLabel && <span class="project-meta-gap">·</span>}
                  <span class="project-meta-updated">Updated {updatedLabel}</span>
                </>
              )}
            </span>
          )}
        </div>
      )}
    </header>

    {project.data.summary && (
      <p class="project-summary">{project.data.summary}</p>
    )}

    {showHero && (
      <figure class="pfig pfig--hero zoomable" data-zoomed={heroZoom > 1 ? '' : undefined}>
        <button
          type="button"
          class="zoom-trigger"
          aria-label="Zoom image"
          aria-expanded="false"
        >
          <img
            src={heroSrc}
            alt={project.data.name}
            loading="eager"
            decoding="async"
            style={heroImgStyle}
          />
        </button>
      </figure>
    )}

    {media.length >= 2 && (
      <MediaStepper
        items={media}
        label={`${project.data.name} screenshots`}
        mat={project.slug === 'dinky' ? 'macos-dark' : undefined}
      />
    )}

    {soloVideo && (
      <figure class="pvideo zoomable">
        <div
          class="zoom-trigger pvideo-shell"
          role="button"
          tabindex="0"
          aria-label="Zoom video"
          aria-expanded="false"
          style={[
            soloVideoAr ? `--pvideo-ar: ${soloVideoAr}` : null,
            `--pvideo-window-radius: ${soloVideoRadius}`,
          ]
            .filter(Boolean)
            .join('; ')}
        >
          <span class="pvideo-clip">
            <video
              class="pvideo-el"
              data-plyr
              data-autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={soloVideo.poster}
              aria-label={soloVideo.alt ?? soloVideo.caption ?? `${project.data.name} tour`}
            >
              <source
                src={soloVideo.src}
                type={soloVideo.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'}
              />
            </video>
          </span>
        </div>
        {soloVideo.caption && <figcaption>{soloVideo.caption}</figcaption>}
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <p class="back-link"><a href="/projects/"><span class="arrow">&larr;</span> all projects</a></p>
  </article>

  <script is:inline>
    // Make body images zoomable. zoom.ts (delegated) handles the interaction.
    // - Pair figures: each <img> becomes its own `.pfig-cell.zoomable` grid item,
    //   so zooming one spans the row and the rest reflow below it.
    // - Solo figures: the figure itself is the `.zoomable`, image wrapped in a trigger.
    // - Bare markdown images: wrapped in a full `figure.zoomable.pfig`.
    const triggerFor = (img) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'zoom-trigger';
      btn.setAttribute('aria-label', 'Zoom image');
      btn.setAttribute('aria-expanded', 'false');
      img.parentNode.insertBefore(btn, img);
      btn.appendChild(img);
      return btn;
    };
    document.querySelectorAll('.post-content .pfig').forEach((fig) => {
      const imgs = [...fig.querySelectorAll(':scope > img')];
      if (fig.classList.contains('pfig--pair')) {
        imgs.forEach((img) => {
          const cell = document.createElement('div');
          cell.className = 'pfig-cell zoomable';
          img.parentNode.insertBefore(cell, img);
          cell.appendChild(img);
          triggerFor(img);
        });
      } else {
        fig.classList.add('zoomable');
        imgs.forEach(triggerFor);
      }
    });
    document.querySelectorAll('.post-content img').forEach((img) => {
      if (img.closest('.pfig')) return;
      const fig = document.createElement('figure');
      fig.className = 'pfig zoomable';
      img.parentNode.insertBefore(fig, img);
      fig.appendChild(img);
      triggerFor(img);
    });

    // Muted video loops autoplay unless the visitor prefers reduced motion,
    // in which case they get a poster + controls instead.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('video[data-autoplay]').forEach((video) => {
      if (reduceMotion) {
        video.controls = true;
      } else {
        video.autoplay = true;
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
      }
    });
  </script>
</Base>

<style>
  .project-header-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .project-header-title-row h1 {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.15;
  }

  .project-header-cta {
    flex-shrink: 0;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.4rem;
    row-gap: 0.2rem;
  }

  .project-meta-lead {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  /* Neutral pill + a small colored status dot (orange survives only as the dot) */
  .detail-status {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    line-height: 1.2;
    color: var(--muted-strong);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border: 1px solid var(--border);
  }

  .detail-status::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
  }

  .detail-status--active::before { background: var(--accent); }
  .detail-status--paused::before { background: #eab308; }
  .detail-status--maintained::before { background: #c4a574; }

  .project-meta-start,
  .project-meta-updated {
    font-variant-numeric: tabular-nums;
  }

  .project-meta-gap {
    color: var(--muted);
    user-select: none;
  }

  .project-summary {
    margin: var(--space-3) 0 0;
    font-size: var(--size-body);
    color: var(--fg-soft);
    line-height: 1.6;
    max-width: 52em;
  }

</style>

<!-- Figure system for process-story pages. Global because body figures arrive
     as raw HTML inside markdown (no Astro scoping), and the lightbox enhancer
     wraps their <img> in trigger buttons at runtime. -->
<style is:global>
  .pfig {
    margin: var(--space-4) 0;
  }

  /* Mat lives on the trigger so crop-in transforms can't widen past the column */
  .pfig .zoom-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    cursor: zoom-in;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    box-sizing: border-box;
  }

  /* Expanded: mat is 4:3 (resting stays 1:1). Same sheet so it beats the rule above. */
  .pfig.zoomable.is-zoomed > .zoom-trigger,
  .pfig .pfig-cell.is-zoomed > .zoom-trigger {
    aspect-ratio: 4 / 3;
    height: auto;
  }

  /* Contained on the mat — never wider than the figure */
  .pfig img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    box-sizing: border-box;
    padding: 14px 28px;
    background: none;
    border: none;
    border-radius: 0;
    transition: none;
  }

  .pfig.zoomable.is-zoomed img,
  .pfig .pfig-cell.is-zoomed img {
    height: 100%;
    aspect-ratio: auto;
    padding: clamp(1.25rem, 3.5vw, 2rem);
  }

  /* Markdown images before the zoom enhancer wraps them */
  .pfig > img {
    aspect-ratio: 1 / 1;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .pfig > figcaption {
    margin: var(--space-2) 0 0;
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--muted-strong);
    text-align: center;
    text-wrap: pretty;
  }

  /* .pvideo styles live in global.css (shared with work case studies) */

  /* Embedded canvases (Figma, etc.) — full column width, 16:10 frame */
  .pembed {
    margin: var(--space-4) 0;
  }

  .pembed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    min-height: 280px;
    max-height: min(70dvh, 640px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .pembed > figcaption {
    margin: var(--space-2) 0 0;
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--muted-strong);
    text-align: center;
    text-wrap: pretty;
  }

  /* Two-up detail pairs; each cell is its own zoomable, caption spans both */
  .pfig--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .pfig-cell {
    margin: 0;
    min-width: 0;
  }

  .pfig--pair > figcaption {
    grid-column: 1 / -1;
    margin-top: 0;
  }

  @media (max-width: 480px) {
    .pfig--pair {
      grid-template-columns: 1fr;
    }
  }

  /* Tools & process accordion (em-dash lists → details/summary) */
  .pacc {
    margin: 0 0 var(--space-4);
    max-width: var(--max-text);
    border-top: 1px solid var(--border);
  }

  .pacc-item {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  /* JS wraps panel content + toggles [data-open] so close can finish animating
     before the native `open` attribute is cleared. Transitions only after
     `.is-ready` so the default-open row doesn't animate in on load. */
  .pacc-body {
    display: grid;
    grid-template-rows: 0fr;
  }

  .pacc-item[data-open] > .pacc-body {
    grid-template-rows: 1fr;
  }

  .pacc.is-ready .pacc-body {
    transition: grid-template-rows 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pacc-body-inner {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transform: translateY(-6px);
  }

  .pacc-item[data-open] > .pacc-body > .pacc-body-inner {
    opacity: 1;
    transform: none;
  }

  .pacc.is-ready .pacc-body-inner {
    transition:
      opacity 0.2s ease,
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pacc.is-ready .pacc-item[data-open] > .pacc-body > .pacc-body-inner {
    transition-delay: 0.05s, 0s;
  }

  .pacc.is-ready .pacc-item:not([data-open]) > .pacc-body > .pacc-body-inner {
    transition-delay: 0s;
    transition-duration: 0.16s, 0.28s;
  }

  .pacc-item > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.7em 0;
    list-style: none;
    cursor: pointer;
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.35;
    user-select: none;
    transition: color 0.15s ease;
  }

  .pacc-item > summary::-webkit-details-marker {
    display: none;
  }

  /* Square hit box so rotate(45deg) spins around the glyph center */
  .pacc-item > summary::after {
    content: '+';
    box-sizing: border-box;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.25em;
    height: 1.25em;
    font-size: 1.15em;
    font-weight: 500;
    color: var(--muted);
    line-height: 1;
    transform-origin: center center;
    transition: color 0.15s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pacc-item[data-open] > summary::after {
    transform: rotate(45deg);
  }

  .pacc-item > summary:hover {
    color: var(--fg);
  }

  .pacc-item > summary:hover::after {
    color: var(--muted-strong);
  }

  .pacc-item > summary:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .pacc-body-inner > p {
    margin: 0 0 var(--space-3);
    padding: 0 1.5em 0 0;
    font-size: var(--size-meta);
    line-height: 1.55;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .pacc-body,
    .pacc-body-inner,
    .pacc-item > summary::after {
      transition: none;
    }

    .pacc-body-inner {
      transform: none;
    }
  }
</style>

<script>
  // Exclusive accordion with animated open/close. We keep `open` true until the
  // close transition ends so the panel isn't snapped shut by the UA stylesheet.
  function initProjectAccordions() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 340;
    const closers = new WeakMap<HTMLDetailsElement, (animate: boolean) => void>();

    document.querySelectorAll('.pacc').forEach((rootEl) => {
      const root = rootEl as HTMLElement;
      if (root.dataset.paccInit) return;
      root.dataset.paccInit = '1';

      const items = [...root.querySelectorAll('details.pacc-item')] as HTMLDetailsElement[];

      items.forEach((details) => {
        if (!details.querySelector(':scope > .pacc-body')) {
          const body = document.createElement('div');
          body.className = 'pacc-body';
          const inner = document.createElement('div');
          inner.className = 'pacc-body-inner';
          [...details.children]
            .filter((el) => el.tagName !== 'SUMMARY')
            .forEach((el) => inner.appendChild(el));
          body.appendChild(inner);
          details.appendChild(body);
        }

        if (details.open) details.setAttribute('data-open', '');
        else details.removeAttribute('data-open');

        let closingTimer = 0;

        const closeItem = (animate: boolean) => {
          if (closingTimer) window.clearTimeout(closingTimer);
          if (!details.hasAttribute('data-open') && !details.open) return;
          details.removeAttribute('data-open');
          if (!animate || reduceMotion) {
            details.open = false;
            closingTimer = 0;
            return;
          }
          details.open = true;
          closingTimer = window.setTimeout(() => {
            details.open = false;
            closingTimer = 0;
          }, DURATION);
        };

        const openItem = () => {
          if (closingTimer) {
            window.clearTimeout(closingTimer);
            closingTimer = 0;
          }
          items.forEach((other) => {
            if (other !== details) closers.get(other)?.(true);
          });
          details.open = true;
          requestAnimationFrame(() => details.setAttribute('data-open', ''));
        };

        closers.set(details, closeItem);

        details.querySelector('summary')?.addEventListener('click', (e) => {
          e.preventDefault();
          if (details.hasAttribute('data-open')) closeItem(true);
          else openItem();
        });
      });

      requestAnimationFrame(() => root.classList.add('is-ready'));
    });
  }
  initProjectAccordions();
  document.addEventListener('astro:page-load', initProjectAccordions);
</script>
