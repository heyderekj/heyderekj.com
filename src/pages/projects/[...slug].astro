---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaStepper from '../../components/MediaStepper.astro';
import { formatProjectStartLabel, formatProjectUpdatedLabel } from '../../lib/projectStart';
import { displayProjectStatus } from '../../lib/projectStatus';
import { schemaPersonId } from '../../lib/schemaIds';
import { imgAttrs, imgSrc, imgVariant } from '../../lib/img';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

const startLabel = formatProjectStartLabel(project);
const updatedLabel = formatProjectUpdatedLabel(project);
const status = project.data.status;
const showMeta = Boolean(startLabel || updatedLabel);

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const pageUrl = new URL(`/projects/${project.slug}/`, `${siteOrigin}/`).toString();
const metaDesc = project.data.summary ?? project.data.tagline;
const projectJsonLd: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: project.data.name,
  description: metaDesc,
  url: project.data.url ?? pageUrl,
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
};
if (project.data.url) {
  projectJsonLd.sameAs = [project.data.url];
}

const media = project.data.media ?? [];
/** Detail-page hero: `hero` wins; cards elsewhere keep using `image`. */
const heroSrc = project.data.hero ?? project.data.image;
const showHero = Boolean(heroSrc) && !media.some((m) => m.src === heroSrc);
const heroPosition = project.data.heroPosition ?? 'center center';
const heroZoom = project.data.heroZoom ?? 1;
const heroImgStyle = [
  `object-position: ${heroPosition}`,
  heroZoom > 1
    ? `transform: scale(${heroZoom}); transform-origin: ${heroPosition}; --pfig-zoom: scale(${heroZoom})`
    : null,
]
  .filter(Boolean)
  .join('; ');
/** Solo tour video — no stepper chrome when there's only one clip */
const soloVideo = media.length === 1 && media[0]?.type === 'video' ? media[0] : null;
/** Match Customer.io proof clips: browser chrome vs native app window */
const soloVideoRadius =
  project.slug === 'dinky' ? 0.028 : project.slug === 'harvous' ? 0.007 : 0.01;
const soloVideoAr =
  project.slug === 'dinky'
    ? '440 / 492'
    : project.slug === 'harvous'
      ? '1240 / 770'
      : undefined;

/** First paint media — hero / poster / first still. */
const RAIL_SIZES = '(max-width: 560px) 100vw, 530px';
const posterOf = (p?: string) => (p ? imgSrc(p, 1280) : undefined);
const firstStill = media.find((m) => m.type !== 'video')?.src;
const preloadImages = [
  showHero && heroSrc ? imgVariant(heroSrc, { sizes: RAIL_SIZES }) : undefined,
  posterOf(soloVideo?.poster),
  firstStill ? imgVariant(firstStill, { sizes: RAIL_SIZES }) : undefined,
  posterOf(media.find((m) => m.type === 'video')?.poster),
].filter(Boolean);
---
<Base
  title={`${project.data.name} — Derek Castelli`}
  description={metaDesc}
  jsonLd={projectJsonLd}
  preloadImages={preloadImages.slice(0, 2)}
>
  <article class="prose">
    <header class="post-header project-detail-header">
      {project.data.url ? (
        <div class="project-header-title-row">
          <h1>{project.data.name}</h1>
          <a href={project.data.url} target="_blank" rel="noopener" class="cta project-header-cta">
            {project.data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      ) : (
        <h1>{project.data.name}</h1>
      )}
      {showMeta && (
        <div class="meta project-meta">
          <span class="project-meta-lead">
            {startLabel && <span class="project-meta-start">Started {startLabel}</span>}
            {updatedLabel && (
              <>
                {startLabel && <span class="project-meta-gap">·</span>}
                <span class="project-meta-updated">Updated {updatedLabel}</span>
              </>
            )}
          </span>
        </div>
      )}
    </header>

    {project.data.summary && (
      <p class="project-summary">{project.data.summary}</p>
    )}

    {showHero && (
      <figure class="pfig pfig--hero zoomable" data-zoomed={heroZoom > 1 ? '' : undefined}>
        <button
          type="button"
          class="zoom-trigger"
          aria-label="Zoom image"
          aria-expanded="false"
        >
          <img
            {...imgAttrs(heroSrc!, { sizes: RAIL_SIZES, dims: false })}
            alt={project.data.name}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={heroImgStyle}
          />
        </button>
      </figure>
    )}

    {media.length >= 2 && (
      <MediaStepper
        items={media}
        label={`${project.data.name} screenshots`}
        mat={project.slug === 'dinky' ? 'macos-dark' : undefined}
      />
    )}

    {soloVideo && (
      <figure class="pvideo zoomable">
        <div
          class="zoom-trigger pvideo-shell"
          role="button"
          tabindex="0"
          aria-label="Zoom video"
          aria-expanded="false"
          style={[
            soloVideoAr ? `--pvideo-ar: ${soloVideoAr}` : null,
            `--pvideo-window-radius: ${soloVideoRadius}`,
          ]
            .filter(Boolean)
            .join('; ')}
        >
          <span class="pvideo-clip">
            <video
              class="pvideo-el"
              data-plyr
              data-autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={posterOf(soloVideo.poster)}
              aria-label={soloVideo.alt ?? soloVideo.caption ?? `${project.data.name} tour`}
            >
              <source
                src={soloVideo.src}
                type={soloVideo.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'}
              />
            </video>
          </span>
        </div>
        {soloVideo.caption && <figcaption>{soloVideo.caption}</figcaption>}
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <div class="project-footer">
      <div class="back-link">
        <a href="/projects/"><span class="arrow">&larr;</span> all projects</a>
      </div>
      {status && (
        <span class={`detail-status detail-status--${status}`}>
          {displayProjectStatus(status)}
        </span>
      )}
    </div>
  </article>

</Base>

<style>
  .project-detail-header {
    margin-bottom: var(--space-4);
  }

  .project-header-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .project-header-title-row h1 {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.15;
  }

  .project-header-cta {
    flex-shrink: 0;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.4rem;
    row-gap: 0.2rem;
  }

  .project-meta-lead {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .project-meta-start,
  .project-meta-updated {
    font-variant-numeric: tabular-nums;
  }

  .project-footer {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .project-footer .back-link {
    margin: 0;
    max-width: none;
    flex: 0 1 auto;
  }

  /* Burner chip — colored status dot, sits opposite “all projects” */
  .detail-status {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    line-height: 1.2;
    color: var(--muted-strong);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border: 1px solid var(--border);
  }

  .detail-status::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
  }

  .detail-status--active::before { background: var(--accent); }
  .detail-status--paused::before { background: #eab308; }
  .detail-status--maintained::before { background: #c4a574; }

  .project-meta-gap {
    color: var(--muted);
    user-select: none;
  }

  .project-summary {
    margin: 0;
    font-size: var(--size-body);
    color: var(--fg-soft);
    line-height: 1.6;
    max-width: 52em;
  }

</style>

