---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import MediaStepper from '../../components/MediaStepper.astro';
import { formatProjectStartLabel, formatProjectUpdatedLabel } from '../../lib/projectStart';
import { displayProjectStatus } from '../../lib/projectStatus';
import { schemaPersonId } from '../../lib/schemaIds';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

const startLabel = formatProjectStartLabel(project);
const updatedLabel = formatProjectUpdatedLabel(project);
const status = project.data.status;
const showMeta = Boolean(startLabel || updatedLabel || status);

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const pageUrl = new URL(`/projects/${project.slug}/`, `${siteOrigin}/`).toString();
const metaDesc = project.data.summary ?? project.data.tagline;
const projectJsonLd: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: project.data.name,
  description: metaDesc,
  url: project.data.url ?? pageUrl,
  author: { '@type': 'Person', '@id': schemaPersonId(siteOrigin), name: 'Derek Castelli' },
};
if (project.data.url) {
  projectJsonLd.sameAs = [project.data.url];
}

const media = project.data.media ?? [];
/** Detail-page hero: `hero` wins; cards elsewhere keep using `image`. */
const heroSrc = project.data.hero ?? project.data.image;
const showHero = Boolean(heroSrc) && !media.some((m) => m.src === heroSrc);
const heroPosition = project.data.heroPosition ?? 'top center';
const heroZoom = project.data.heroZoom ?? 1;
const heroImgStyle = [
  `object-position: ${heroPosition}`,
  heroZoom > 1
    ? `transform: scale(${heroZoom}); transform-origin: ${heroPosition}; --pfig-zoom: scale(${heroZoom})`
    : null,
]
  .filter(Boolean)
  .join('; ');
---
<Base title={`${project.data.name} — Derek Castelli`} description={metaDesc} jsonLd={projectJsonLd}>
  <article class="prose">
    <header class="post-header project-detail-header">
      {project.data.url ? (
        <div class="project-header-title-row">
          <h1>{project.data.name}</h1>
          <a href={project.data.url} target="_blank" rel="noopener" class="cta project-header-cta">
            {project.data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      ) : (
        <h1>{project.data.name}</h1>
      )}
      {showMeta && (
        <div class="meta project-meta">
          {(startLabel || updatedLabel || status) && (
            <span class="project-meta-lead">
              {status && (
                <span class={`detail-status detail-status--${status}`}>
                  {displayProjectStatus(status)}
                </span>
              )}
              {startLabel && <span class="project-meta-start">Started {startLabel}</span>}
              {updatedLabel && (
                <>
                  {startLabel && <span class="project-meta-gap">·</span>}
                  <span class="project-meta-updated">Updated {updatedLabel}</span>
                </>
              )}
            </span>
          )}
        </div>
      )}
    </header>

    {project.data.summary && (
      <p class="project-summary">{project.data.summary}</p>
    )}

    {showHero && (
      <figure class="pfig pfig--hero" data-zoomed={heroZoom > 1 ? '' : undefined}>
        <button
          type="button"
          class="work-lightbox-trigger"
          aria-label="View image at full size"
          data-lb-src={heroSrc}
        >
          <img
            src={heroSrc}
            alt={project.data.name}
            loading="eager"
            decoding="async"
            style={heroImgStyle}
          />
        </button>
      </figure>
    )}

    {media.length >= 2 && (
      <MediaStepper items={media} label={`${project.data.name} screenshots`} />
    )}

    <div class="post-content">
      <Content />
    </div>

    <p class="back-link"><a href="/projects/"><span class="arrow">&larr;</span> all projects</a></p>
  </article>

  <script is:inline>
    // Make markdown body images zoomable: wrap them in lightbox triggers before
    // the Lightbox script (below) collects triggers in DOM order.
    document.querySelectorAll('.post-content img').forEach((img) => {
      if (img.closest('.work-lightbox-trigger')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'work-lightbox-trigger';
      btn.setAttribute('aria-label', 'View image at full size');
      img.parentNode.insertBefore(btn, img);
      btn.appendChild(img);
    });

    // Muted video loops autoplay unless the visitor prefers reduced motion,
    // in which case they get a poster + controls instead.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('video[data-autoplay]').forEach((video) => {
      if (reduceMotion) {
        video.controls = true;
      } else {
        video.autoplay = true;
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
      }
    });
  </script>

  <Lightbox />
</Base>

<style>
  .project-header-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .project-header-title-row h1 {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.15;
  }

  .project-header-cta {
    flex-shrink: 0;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.4rem;
    row-gap: 0.2rem;
  }

  .project-meta-lead {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .detail-status {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    line-height: 1.2;
  }

  .detail-status--active {
    color: #9a3412;
    background: rgba(249, 115, 22, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.38);
  }

  .detail-status--paused {
    color: var(--muted-strong);
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.4);
  }

  .detail-status--maintained {
    color: var(--muted-strong);
    background: rgba(0, 0, 0, 0.035);
    border: 1px solid var(--border);
  }

  .detail-status--retired {
    color: var(--muted);
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border);
  }

  @media (prefers-color-scheme: dark) {
    .detail-status--maintained {
      background: rgba(255, 255, 255, 0.05);
    }

    .detail-status--retired {
      background: rgba(255, 255, 255, 0.035);
    }
  }

  .project-meta-start,
  .project-meta-updated {
    font-variant-numeric: tabular-nums;
  }

  .project-meta-gap {
    color: var(--muted);
    user-select: none;
  }

  .project-summary {
    margin: var(--space-3) 0 0;
    font-size: var(--size-body);
    color: var(--fg-soft);
    line-height: 1.6;
    max-width: 52em;
  }

</style>

<!-- Figure system for process-story pages. Global because body figures arrive
     as raw HTML inside markdown (no Astro scoping), and the lightbox enhancer
     wraps their <img> in trigger buttons at runtime. -->
<style is:global>
  .pfig {
    margin: var(--space-4) 0;
  }

  .pfig .work-lightbox-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .pfig img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: top center;
    box-sizing: border-box;
    padding: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: none;
  }

  /* Keep per-hero crop zoom under the global lightbox hover lift */
  .pfig[data-zoomed] .work-lightbox-trigger:hover img,
  .pfig[data-zoomed] .work-lightbox-trigger:focus-visible img {
    transform: var(--pfig-zoom, none);
  }

  /* Opt into letterboxed framing when a shot shouldn't crop */
  .pfig[data-fit='contain'] img {
    object-fit: contain;
    padding: 14px;
  }

  .pfig > figcaption {
    margin: var(--space-2) 0 0;
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--muted-strong);
    text-wrap: pretty;
  }

  /* Two-up detail pairs; caption spans both cells */
  .pfig--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .pfig--pair img {
    aspect-ratio: 3 / 2;
  }

  .pfig--pair[data-fit='contain'] img {
    padding: 10px;
  }

  .pfig--pair.pfig--tall img {
    aspect-ratio: 3 / 4;
  }

  .pfig--pair > figcaption {
    grid-column: 1 / -1;
    margin-top: 0;
  }

  @media (max-width: 480px) {
    .pfig--pair {
      grid-template-columns: 1fr;
    }
  }

  /* Tools & process accordion (em-dash lists → details/summary) */
  .pacc {
    margin: 0 0 var(--space-4);
    max-width: var(--max-text);
    border-top: 1px solid var(--border);
  }

  .pacc-item {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  .pacc-item > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.7em 0;
    list-style: none;
    cursor: pointer;
    font-size: var(--size-body);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.35;
    user-select: none;
    transition: color 0.15s ease;
  }

  .pacc-item > summary::-webkit-details-marker {
    display: none;
  }

  .pacc-item > summary::after {
    content: '+';
    flex: 0 0 auto;
    font-size: 1.1em;
    font-weight: 500;
    color: var(--muted);
    line-height: 1;
    transition: color 0.15s ease, transform 0.2s var(--easing);
  }

  .pacc-item[open] > summary::after {
    content: '−';
  }

  .pacc-item > summary:hover {
    color: var(--fg);
  }

  .pacc-item > summary:hover::after {
    color: var(--muted-strong);
  }

  .pacc-item > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .pacc-item > p {
    margin: 0 0 var(--space-3);
    padding: 0 1.5em 0 0;
    font-size: var(--size-meta);
    line-height: 1.55;
    color: var(--fg-soft);
    text-wrap: pretty;
  }
</style>

<script>
  // Exclusive accordion: opening one row closes the others in the same group.
  function initProjectAccordions() {
    document.querySelectorAll('.pacc').forEach((root) => {
      if ((root as HTMLElement).dataset.paccInit) return;
      (root as HTMLElement).dataset.paccInit = '1';
      root.querySelectorAll('details.pacc-item').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!(item as HTMLDetailsElement).open) return;
          root.querySelectorAll('details.pacc-item').forEach((other) => {
            if (other !== item) (other as HTMLDetailsElement).open = false;
          });
        });
      });
    });
  }
  initProjectAccordions();
  document.addEventListener('astro:page-load', initProjectAccordions);
</script>
