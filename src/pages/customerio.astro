---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import ApplicationToc from '../components/ApplicationToc.astro';
import FeaturedWorkGrid from '../components/FeaturedWorkGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { testimonials } from '../data/about';
import {
  customerioMeta,
  customerioIntro,
  customerioLetter,
  customerioLetterAiNotes,
  customerioProofLead,
  customerioProofBlocks,
  customerioFoundationsLead,
  customerioFoundationsParagraphs,
  customerioWhyParagraphs,
} from '../data/customerio';

const letter = customerioLetter;
const letterBeforeAiNotes = letter.paragraphs.slice(0, 4);
const letterAfterAiNotes = letter.paragraphs.slice(4);

const workSlugs = ['claimable', 'care-continuity'] as const;
const allWork = await getCollection('work', ({ data }) => !data.draft);
const foundationWork = workSlugs
  .map((slug) => allWork.find((entry) => entry.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry != null);

const tocItems = [
  { id: 'letter', label: 'Letter to Matt' },
  { id: 'proof', label: 'Proof' },
  { id: 'foundations', label: 'Foundations' },
  { id: 'why-customerio', label: 'Why Customer.io' },
  { id: 'recommendations', label: 'Recommendations' },
  { id: 'connect', label: 'Connect' },
];
---

<Base
  title={customerioMeta.title}
  description={customerioMeta.description}
  ogImage={customerioMeta.ogImage}
  noindex={true}
>
  <PageTitle path="/customerio" />

  <ApplicationToc items={tocItems} />

  <p class="cio-intro">
    Hey, I'm <span class="cio-chip"><img class="cio-chip__avatar" src={customerioIntro.photoSrc} alt={customerioIntro.photoAlt} width={18} height={18} decoding="async" /><span class="cio-chip__label">Derek</span></span>, a designer in Des Moines, IA. I've made websites full-time since 2018 and been designing apps on the side for the past 5 years. I'm applying for <strong>Senior Product Designer</strong> at <span class="cio-chip cio-chip--brand"><i class="ph-bold ph-lightning" aria-hidden="true"></i><span class="cio-chip__label">Customer.io</span></span>
  </p>

  <section id="letter" class="cio-letter" aria-label="Cover letter">
    <div class="cio-letter__sheet">
      <header class="cio-letter__address">
        <p>
          <span class="cio-letter__label">To:</span>
          {letter.to}
        </p>
        <p>
          <span class="cio-letter__label">From:</span>
          {letter.from}
        </p>
      </header>

      <hr class="cio-letter__rule" aria-hidden="true" />

      <p class="cio-letter__salutation">{letter.salutation}</p>

      {letterBeforeAiNotes.map((paragraph) => (
        <p class="cio-letter__paragraph">{paragraph}</p>
      ))}

      <aside class="cio-letter__ai-notes" aria-label="Writing on AI">
        <p class="cio-letter__ai-notes-lead">{customerioLetterAiNotes.lead}</p>
        <ol class="cio-letter__ai-notes-list">
          {customerioLetterAiNotes.posts.map((post) => (
            <li>
              <a href={post.href}>
                <span>{post.title}</span>
                <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ol>
      </aside>

      {letterAfterAiNotes.map((paragraph) => (
        <p class="cio-letter__paragraph">{paragraph}</p>
      ))}

      <p class="cio-letter__signoff">{letter.signoff}</p>
    </div>
  </section>

  <section id="proof" class="cio-proof" aria-labelledby="cio-proof-heading">
    <h2 id="cio-proof-heading" class="section-title"><a href="/projects/">/ proof</a></h2>
    <p class="cio-section-lead">{customerioProofLead}</p>

    {customerioProofBlocks.map((block) => (
      <article class="cio-proof-block">
        {(Array.isArray(block.html) ? block.html : [block.html]).map((p) => (
          <p class="cio-body" set:html={p} />
        ))}

        <figure class:list={['cio-shots', block.mat === 'macos-dark' && 'cio-shots--macos-dark']}>
          {block.shots.map((shot) =>
            shot.type === 'video' ? (
              <div class="zoomable zoom-cell zoom-cell--video">
                {/*
                  Div trigger (not <button>): native video controls are invalid
                  / broken inside a button once expanded.
                */}
                <div
                  class:list={[
                    'zoom-trigger',
                    'cio-shot-video-shell',
                    block.mat === 'macos-dark' && 'mat-wallpaper--macos-dark',
                  ]}
                  role="button"
                  tabindex="0"
                  aria-label="Zoom video"
                  aria-expanded="false"
                  style={[
                    shot.width && shot.height
                      ? `--cio-video-ar: ${shot.width} / ${shot.height}`
                      : null,
                    shot.width != null ? `--cio-video-w: ${shot.width}` : null,
                    shot.windowRadius != null
                      ? `--cio-window-radius: ${shot.windowRadius}`
                      : null,
                  ]
                    .filter(Boolean)
                    .join('; ')}
                >
                  {/*
                    Clip wrapper: overflow+radius is more reliable on <video>
                    than border-radius on the media element itself (WebKit).
                    Radius is width-based (cqw) so corners stay circular.
                  */}
                  <span class="cio-shot-video-clip">
                    <video
                      class="cio-shot-video"
                      data-plyr
                      data-autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster={shot.poster}
                      width={shot.width}
                      height={shot.height}
                      aria-label={shot.alt}
                    >
                      <source src={shot.src} type="video/mp4" />
                    </video>
                  </span>
                </div>
              </div>
            ) : (
              <div class="zoomable zoom-cell">
                <button
                  type="button"
                  class="zoom-trigger"
                  aria-label="Zoom image"
                  aria-expanded="false"
                >
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
            ),
          )}
          <figcaption>{block.caption}</figcaption>
        </figure>

        <a href={block.href} class="cio-more">
          More on {block.label}
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </article>
    ))}
  </section>

  <section id="foundations" class="cio-foundations" aria-labelledby="cio-foundations-heading">
    <h2 id="cio-foundations-heading" class="section-title">/ foundations</h2>
    <p class="cio-section-lead">{customerioFoundationsLead}</p>
    {customerioFoundationsParagraphs.map((p) => (
      <p class="cio-body" set:html={p} />
    ))}
    {foundationWork.length > 0 && <FeaturedWorkGrid work={foundationWork} preserveOrder />}
  </section>

  <section id="why-customerio" class="cio-why" aria-labelledby="cio-why-heading">
    <h2 id="cio-why-heading" class="section-title">/ why customer.io</h2>
    {customerioWhyParagraphs.map((p) => (
      <p class="cio-body" set:html={p} />
    ))}
  </section>

  <div id="recommendations">
    <TestimonialCarousel testimonials={testimonials} headingId="cio-testimonials-heading" />
  </div>

  <nav id="connect" class="cio-footer intro-links" aria-label="More on this site">
    <a href="mailto:derekj@hey.com" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      derekj@hey.com
    </a>
    <a href="/work/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Work
    </a>
    <a href="/projects/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Projects
    </a>
    <a href="/posts/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Posts
    </a>
  </nav>

  <script is:inline>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('video[data-autoplay]').forEach((video) => {
      if (reduceMotion) {
        video.controls = true;
      } else {
        video.autoplay = true;
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
      }
    });
  </script>
</Base>

<style is:global>
  /* Chips must be global: proof-section chips arrive via set:html and never get
     Astro's scoped attribute. One definition covers intro + proof chips. */
  .cio-chip,
  main.main a.cio-chip {
    /* Customer.io brand: evergreen teal + verdant mint (logo accent) */
    --cio-brand: #1f6f78;
    --cio-verdant: #abffae;
    --cio-chip-pad-y: 0.32em;
    display: inline-flex;
    /* Baseline from the label text — not the avatar (replaced elems baseline
       at their bottom edge and lift the whole chip vs surrounding copy). */
    align-items: baseline;
    gap: 0.28em;
    padding: var(--cio-chip-pad-y) 0.65em var(--cio-chip-pad-y) 0.45em;
    /* Pull the taller chip out of the line box so paragraph leading stays put */
    margin-block: calc(var(--cio-chip-pad-y) * -1);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-size: 0.94em;
    font-weight: 600;
    line-height: 1.15;
    color: var(--fg);
    white-space: nowrap;
    text-decoration: none;
    vertical-align: baseline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Beat `main.main a` hairline / color: inherit on linked chips */
  main.main a.cio-chip {
    border: 1px solid var(--border);
    border-bottom-style: solid;
    color: var(--chip-color, var(--fg));
  }

  main.main a.cio-chip:hover {
    border-color: color-mix(in srgb, var(--chip-color, var(--fg)) 55%, var(--border));
    background: color-mix(in srgb, var(--chip-color, var(--fg)) 12%, var(--bg-elevated));
  }

  .cio-chip[href] {
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cio-chip__label {
    display: inline;
    line-height: 1.15;
  }

  .cio-chip i {
    font-size: 0.85em;
    margin: 0;
    line-height: 1;
    align-self: center;
    transform: translateY(0.06em);
  }

  .cio-chip__avatar {
    display: block;
    width: 1em;
    height: 1em;
    margin: 0;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    align-self: center;
  }

  .cio-chip--brand,
  main.main a.cio-chip--brand {
    --chip-color: var(--cio-brand);
    padding-left: 0.5em;
    color: var(--cio-brand);
    border-color: color-mix(in srgb, var(--cio-brand) 40%, var(--border));
    background: color-mix(in srgb, var(--cio-verdant) 28%, var(--bg-elevated));
  }

  .cio-chip--harvous,
  main.main a.cio-chip--harvous {
    --chip-color: #006eff;
  }

  .cio-chip--dinky,
  main.main a.cio-chip--dinky {
    --chip-color: #3b82f6;
  }

  .cio-chip--hmc,
  main.main a.cio-chip--hmc {
    --chip-color: #a855f7;
  }

  .cio-chip--revisemy,
  main.main a.cio-chip--revisemy {
    --chip-color: #fb7185;
  }

  .cio-chip--harvous,
  .cio-chip--dinky,
  .cio-chip--hmc,
  .cio-chip--revisemy,
  main.main a.cio-chip--harvous,
  main.main a.cio-chip--dinky,
  main.main a.cio-chip--hmc,
  main.main a.cio-chip--revisemy {
    color: var(--chip-color);
    border-color: color-mix(in srgb, var(--chip-color) 35%, var(--border));
    background: color-mix(in srgb, var(--chip-color) 12%, var(--bg-elevated));
  }

  @media (prefers-color-scheme: dark) {
    .cio-chip--harvous,
    main.main a.cio-chip--harvous {
      --chip-color: #60a5fa;
    }

    .cio-chip--dinky,
    main.main a.cio-chip--dinky {
      --chip-color: #93c5fd;
    }

    .cio-chip--hmc,
    main.main a.cio-chip--hmc {
      --chip-color: #d8b4fe;
    }

    .cio-chip--revisemy,
    main.main a.cio-chip--revisemy {
      --chip-color: #fda4af;
    }

    .cio-chip--brand,
    main.main a.cio-chip--brand {
      --chip-color: var(--cio-verdant);
      color: var(--cio-verdant);
      border-color: color-mix(in srgb, var(--cio-verdant) 35%, var(--border));
      background: color-mix(in srgb, var(--cio-verdant) 10%, var(--bg-elevated));
    }
  }
</style>

<style>
  .cio-intro {
    margin: 0 0 var(--space-4);
    max-width: 93%;
    font-size: var(--size-lead);
    line-height: 1.75;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cio-intro strong {
    color: var(--fg);
    font-weight: 600;
  }

  .cio-letter {
    --letter-frame: color-mix(in srgb, #1f6f78 14%, var(--border-strong));
    --letter-rule: color-mix(in srgb, #1f6f78 10%, var(--border));
    --letter-surface-top: color-mix(in srgb, #abffae 8%, var(--bg-elevated));
    --letter-surface-bottom: color-mix(in srgb, #e4eceb 40%, var(--bg));
    /* Secondary ink pulled toward the brand teal so it matches the green surface temperature */
    --letter-ink-soft: color-mix(in srgb, #1f6f78 26%, var(--fg-soft));
    --letter-ink-muted: color-mix(in srgb, #1f6f78 32%, var(--muted));
    margin-bottom: var(--space-5);
    max-width: 100%;
  }

  .cio-letter__sheet {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--letter-surface-top), var(--letter-surface-bottom));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 1px 3px color-mix(in srgb, var(--fg) 5%, transparent);
  }

  .cio-letter__sheet::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--letter-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.35;
    z-index: 1;
  }

  .cio-letter__address {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    line-height: 1.65;
    color: var(--letter-ink-soft);
  }

  .cio-letter__address p {
    margin: 0;
  }

  .cio-letter__address p + p {
    margin-top: 0.15em;
  }

  .cio-letter__label {
    display: inline-block;
    min-width: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--letter-ink-muted);
  }

  .cio-letter__rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--letter-rule);
  }

  .cio-letter__salutation,
  .cio-letter__paragraph {
    margin: 0 0 var(--space-3);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--letter-ink-soft);
    text-wrap: pretty;
  }

  .cio-letter__salutation {
    margin-bottom: var(--space-2);
  }

  .cio-letter__ai-notes {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--letter-rule);
    border-bottom: 1px solid var(--letter-rule);
  }

  .cio-letter__ai-notes-lead {
    margin: 0 0 var(--space-1);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 0.9375rem;
    line-height: 1.55;
    font-style: italic;
    color: var(--letter-ink-muted);
  }

  .cio-letter__ai-notes-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: cio-ai-note;
  }

  .cio-letter__ai-notes-list li {
    margin: 0;
    counter-increment: cio-ai-note;
  }

  .cio-letter__ai-notes-list a {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.2em 0;
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--letter-ink-soft);
    text-decoration: none;
    border-bottom: none;
  }

  .cio-letter__ai-notes-list a::before {
    content: counter(cio-ai-note) '.';
    flex: 0 0 auto;
    min-width: 1.4em;
    color: var(--letter-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .cio-letter__ai-notes-list a span {
    flex: 1 1 auto;
  }

  .cio-letter__ai-notes-list a i {
    flex: 0 0 auto;
    font-size: 0.8em;
    color: var(--letter-ink-muted);
    transform: translateY(0.05em);
  }

  .cio-letter__ai-notes-list a:hover {
    color: var(--fg);
    border-bottom: none;
  }

  .cio-letter__ai-notes-list a:hover i {
    color: var(--fg);
  }

  .cio-letter__signoff {
    margin: var(--space-4) 0 0;
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--letter-ink-soft);
  }

  @media (prefers-color-scheme: dark) {
    .cio-letter {
      --letter-frame: color-mix(in srgb, #abffae 12%, var(--border-strong));
      --letter-rule: color-mix(in srgb, #abffae 8%, var(--border));
      --letter-surface-top: color-mix(in srgb, #0e464d 18%, var(--bg-elevated));
      --letter-surface-bottom: color-mix(in srgb, #0e464d 12%, #0a0a0a);
      --letter-ink-soft: color-mix(in srgb, #abffae 14%, var(--fg-soft));
      --letter-ink-muted: color-mix(in srgb, #abffae 18%, var(--muted));
    }
  }

  .cio-proof,
  .cio-foundations,
  .cio-why {
    margin-bottom: var(--space-5);
  }

  .cio-section-lead,
  .cio-body {
    margin: 0 0 var(--space-3);
    max-width: 93%;
    font-size: 16px;
    line-height: 1.8;
    color: var(--fg);
    text-wrap: pretty;
  }

  .cio-body:last-of-type {
    margin-bottom: 0;
  }

  /* Each project reads as one unit: story, its own two money shots, a way in. */
  .cio-proof-block {
    margin: 0 0 var(--space-6);
  }

  .cio-proof-block:last-of-type {
    margin-bottom: 0;
  }

  .cio-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-items: start;
    margin: var(--space-3) 0 0;
  }

  .cio-shots .zoom-cell {
    margin: 0;
    min-width: 0;
  }

  .cio-shots .zoom-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cio-shots .zoom-cell.is-zoomed > .zoom-trigger {
    cursor: zoom-out;
  }

  .cio-shots .zoom-cell.is-zoomed .cio-shot-video,
  .cio-shots .zoom-cell.is-zoomed .cio-shot-video-clip,
  .cio-shots .zoom-cell.is-zoomed .cio-shot-video-clip :global(.plyr) {
    cursor: default;
  }

  .cio-shots img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    padding: 14px;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .cio-shots .cio-shot-video-shell {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 18px 22px;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .cio-shots .cio-shot-video-clip {
    display: block;
    /* Cap at native encode width so we don't soft-upscale past the source */
    width: min(100%, calc(var(--cio-video-w, 9999) * 1px));
    max-height: min(70dvh, 640px);
    aspect-ratio: var(--cio-video-ar, auto);
    container-type: inline-size;
    overflow: hidden;
    /* Circular corners from video width — per-shot --cio-window-radius */
    border-radius: calc(var(--cio-window-radius, 0.01) * 100cqw);
  }

  .cio-shots .cio-shot-video-clip :global(.plyr),
  .cio-shots .cio-shot-video {
    display: block;
    width: 100%;
    height: 100%;
    background: none;
    border: none;
    border-radius: 0;
  }

  .cio-shots .cio-shot-video {
    /* contain (not fill): avoid upscaling/stretch soft-blur past native pixels */
    object-fit: contain;
    object-position: center;
  }

  /* Dark wallpaper only behind the video shell — stills use the normal elevated mat */
  .cio-shots--macos-dark .cio-shot-video-shell {
    /* Extra side inset so the portrait window floats on the wallpaper */
    padding: 28px clamp(48px, 14%, 88px);
    background-color: #07090f;
    background-image:
      radial-gradient(ellipse 90% 70% at 18% 22%, rgba(88, 128, 210, 0.42), transparent 58%),
      radial-gradient(ellipse 70% 55% at 88% 78%, rgba(48, 78, 160, 0.38), transparent 55%),
      radial-gradient(ellipse 55% 40% at 55% 108%, rgba(28, 48, 110, 0.55), transparent 50%),
      linear-gradient(165deg, #141824 0%, #0a0c14 42%, #06070c 100%);
    border-color: rgba(255, 255, 255, 0.06);
  }

  /* Tour video leads full-width; stills sit as the pair below */
  .cio-shots > .zoom-cell:has(.cio-shot-video) {
    grid-column: 1 / -1;
  }

  /* Expanded: span the row, then break out toward the rails like project figures */
  .cio-shots > .zoom-cell.is-zoomed {
    grid-column: 1 / -1;
    width: auto;
    max-width: none;
    margin-inline: calc(-1 * var(--z-bleed));
  }

  .cio-shots > .zoom-cell.is-zoomed img {
    aspect-ratio: auto;
    height: 100%;
    max-height: none;
