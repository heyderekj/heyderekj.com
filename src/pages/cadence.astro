---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import FeaturedWorkGrid from '../components/FeaturedWorkGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { testimonials } from '../data/about';
import { cadenceMeta, cadenceLetter } from '../data/cadence';

const letter = cadenceLetter;
const cadenceWorkSlugs = ['care-continuity', 'claimable'] as const;
const allWork = await getCollection('work', ({ data }) => !data.draft);
const cadenceWork = cadenceWorkSlugs
  .map((slug) => allWork.find((entry) => entry.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry != null);
---

<Base
  title={cadenceMeta.title}
  description={cadenceMeta.description}
  ogImage={cadenceMeta.ogImage}
  noindex={true}
>
  <PageTitle path="/cadence" />

  <section class="cadence-letter" aria-label="Cover letter">
    <div class="cadence-letter__frame">
      <div class="cadence-letter__scroll">
        <header class="cadence-letter__address">
          <p>
            <span class="cadence-letter__label">To:</span>
            {letter.to}
          </p>
          <p>
            <span class="cadence-letter__label">From:</span>
            {letter.from}
          </p>
        </header>

        <hr class="cadence-letter__rule" aria-hidden="true" />

        <p class="cadence-letter__salutation">{letter.salutation}</p>

        {letter.paragraphs.map((paragraph) => (
          <p class="cadence-letter__paragraph">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <h2 class="section-title"><a href="/work/">/ related work</a></h2>
  {cadenceWork.length > 0 && <FeaturedWorkGrid work={cadenceWork} preserveOrder />}

  <TestimonialCarousel testimonials={testimonials} headingId="cadence-testimonials-heading" />

  <nav class="cadence-footer intro-links" aria-label="More on this site">
    <a href="/work/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Work
    </a>
    <a href="/projects/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Projects
    </a>
    <a href="/posts/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Posts
    </a>
  </nav>
</Base>

<style>
  .cadence-letter {
    --letter-frame: color-mix(in srgb, #6b5a45 10%, var(--border-strong));
    --letter-rule: color-mix(in srgb, #6b5a45 8%, var(--border));
    --letter-surface-top: color-mix(in srgb, #f7f3ea 55%, var(--bg-elevated));
    --letter-surface-bottom: color-mix(in srgb, #e8e0d4 35%, var(--bg));
    --letter-scroll-max: calc(27rem - 12px);
    margin-bottom: var(--space-5);
    max-width: 100%;
  }

  .cadence-letter__frame {
    position: relative;
    border: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--letter-surface-top), var(--letter-surface-bottom));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 1px 3px color-mix(in srgb, var(--fg) 5%, transparent);
  }

  .cadence-letter__frame::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--letter-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.65;
    z-index: 1;
  }

  .cadence-letter__scroll {
    position: relative;
    z-index: 0;
    padding: var(--space-4) var(--space-4) var(--space-5);
    max-height: var(--letter-scroll-max);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .cadence-letter__address {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    line-height: 1.65;
    color: var(--fg-soft);
  }

  .cadence-letter__address p {
    margin: 0;
  }

  .cadence-letter__address p + p {
    margin-top: 0.15em;
  }

  .cadence-letter__label {
    display: inline-block;
    min-width: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cadence-letter__rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--letter-rule);
  }

  .cadence-letter__salutation,
  .cadence-letter__paragraph {
    margin: 0 0 var(--space-3);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cadence-letter__salutation {
    margin-bottom: var(--space-2);
  }

  .cadence-letter__paragraph:last-of-type {
    margin-bottom: 0;
  }

  @media (prefers-color-scheme: dark) {
    .cadence-letter {
      --letter-frame: color-mix(in srgb, #c9a86c 8%, var(--border-strong));
      --letter-rule: color-mix(in srgb, #c9a86c 6%, var(--border));
      --letter-surface-top: color-mix(in srgb, #c9a86c 4%, var(--bg-elevated));
      --letter-surface-bottom: color-mix(in srgb, #6b5a45 6%, #0a0a0a);
    }
  }

  .cadence-footer {
    margin-top: var(--space-5);
    margin-bottom: var(--space-4);
  }
</style>
