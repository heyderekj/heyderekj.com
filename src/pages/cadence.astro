---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import CadenceToc from '../components/CadenceToc.astro';
import FeaturedWorkGrid from '../components/FeaturedWorkGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { testimonials } from '../data/about';
import { cadenceMeta, cadenceIntro, cadenceLetter, cadenceWhyParagraphs } from '../data/cadence';

const letter = cadenceLetter;
const cadenceWorkSlugs = ['care-continuity', 'claimable', 'mantle'] as const;
const allWork = await getCollection('work', ({ data }) => !data.draft);
const cadenceWork = cadenceWorkSlugs
  .map((slug) => allWork.find((entry) => entry.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry != null);
---

<Base
  title={cadenceMeta.title}
  description={cadenceMeta.description}
  ogImage={cadenceMeta.ogImage}
  noindex={true}
>
  <PageTitle path="/cadence" />

  <CadenceToc />

  <p class="cadence-intro">
    Hey, I'm <span class="cadence-chip"><img class="cadence-chip__avatar" src={cadenceIntro.photoSrc} alt={cadenceIntro.photoAlt} width={20} height={20} decoding="async" />Derek</span>, a full-time designer in Des Moines, Iowa since 2018. Primarily working with startups and non-profits, lately focused on <span class="cadence-chip cadence-chip--health"><i class="ph-bold ph-heartbeat" aria-hidden="true"></i>healthcare</span>. I'm applying for <strong>Brand Designer</strong>, so here's my work and why I want in.
  </p>

  <section id="letter" class="cadence-letter" aria-label="Cover letter">
    <div class="cadence-letter__sheet">
      <header class="cadence-letter__address">
        <p>
          <span class="cadence-letter__label">To:</span>
          {letter.to}
        </p>
        <p>
          <span class="cadence-letter__label">From:</span>
          {letter.from}
        </p>
      </header>

      <hr class="cadence-letter__rule" aria-hidden="true" />

      <p class="cadence-letter__salutation">{letter.salutation}</p>

      {letter.paragraphs.map((paragraph) => (
        <p class="cadence-letter__paragraph">{paragraph}</p>
      ))}
    </div>
  </section>

  <h2 id="healthcare-work" class="section-title"><a href="/work/">/ healthcare work</a></h2>
  {cadenceWork.length > 0 && <FeaturedWorkGrid work={cadenceWork} preserveOrder />}

  <section id="why-cadence" class="cadence-why" aria-labelledby="cadence-why-heading">
    <h2 id="cadence-why-heading" class="section-title">/ why cadence</h2>
    {cadenceWhyParagraphs.map((p) => (
      <p class="cadence-why__paragraph" set:html={p} />
    ))}
    <p class="cadence-why__paragraph">
      I also ship my own products. <a href="/projects/harvous/" class="cadence-chip cadence-chip--harvous"><i class="ph-bold ph-book-open-text" aria-hidden="true"></i>Harvous</a> is a Bible notes app I designed and built with Claude. <a href="/projects/dinky/" class="cadence-chip cadence-chip--dinky"><i class="ph-bold ph-file-arrow-down" aria-hidden="true"></i>Dinky</a> is a macOS compression app. <a href="/projects/heres-my-church/" class="cadence-chip cadence-chip--church"><i class="ph-bold ph-church" aria-hidden="true"></i>Here's My Church</a> maps every Christian church in the US—designed in Figma, built in 48 hours with AI. I'm not waiting for an engineering team. I design it, then I ship it.
    </p>
    <p class="cadence-why__paragraph">
      That same energy is what I'd bring to Cadence.
    </p>
  </section>

  <div id="recommendations">
    <TestimonialCarousel testimonials={testimonials} headingId="cadence-testimonials-heading" />
  </div>

  <nav id="connect" class="cadence-footer intro-links" aria-label="More on this site">
    <a href="mailto:derekj@hey.com" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      derekj@hey.com
    </a>
    <a href="/work/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Work
    </a>
    <a href="/projects/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Projects
    </a>
    <a href="/posts/" class="intro-pill">
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      Posts
    </a>
  </nav>
</Base>

<style is:global>
  [id="why-cadence"] .cadence-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    vertical-align: middle;
    translate: 0 -1px;
    text-decoration: none;
  }

  [id="why-cadence"] .cadence-chip[href] {
    border-bottom: 1px solid color-mix(in srgb, var(--chip-color, var(--border)) 30%, var(--border));
  }

  [id="why-cadence"] .cadence-chip[href]:hover {
    border-bottom: 1px solid var(--chip-color, var(--border));
  }

  [id="why-cadence"] .cadence-chip--cc {
    --chip-color: #65a30d;
    color: var(--chip-color);
    border-color: color-mix(in srgb, var(--chip-color) 30%, var(--border));
    background: color-mix(in srgb, var(--chip-color) 6%, var(--bg-elevated));
  }

  [id="why-cadence"] .cadence-chip--cc i { font-size: 0.85em; }

  [id="why-cadence"] .cadence-chip--claimable {
    --chip-color: #9f62bf;
    color: var(--chip-color);
    border-color: color-mix(in srgb, var(--chip-color) 30%, var(--border));
    background: color-mix(in srgb, var(--chip-color) 6%, var(--bg-elevated));
  }

  [id="why-cadence"] .cadence-chip--claimable i { font-size: 0.85em; }
</style>

<style>
  .cadence-intro {
    margin: 0 0 var(--space-4);
    font-size: var(--size-lead);
    line-height: 1.55;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cadence-intro strong {
    color: var(--fg);
    font-weight: 600;
  }

  .cadence-chip {
    --cadence-blue: #4462ec;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px 2px 4px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    vertical-align: middle;
    translate: 0 -1px;
  }

  .cadence-chip__avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
  }

  .cadence-chip--health {
    padding: 2px 10px 2px 8px;
    color: var(--cadence-blue);
    border-color: color-mix(in srgb, var(--cadence-blue) 30%, var(--border));
    background: color-mix(in srgb, var(--cadence-blue) 6%, var(--bg-elevated));
  }

  .cadence-chip--health i {
    font-size: 0.85em;
  }

  .cadence-chip[href] {
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--chip-color, var(--border)) 30%, var(--border));
  }

  .cadence-chip[href]:hover {
    border-bottom: 1px solid var(--chip-color, var(--border));
  }

  .cadence-chip--harvous,
  .cadence-chip--dinky,
  .cadence-chip--church {
    padding: 2px 10px 2px 8px;
  }

  .cadence-chip--harvous i,
  .cadence-chip--dinky i,
  .cadence-chip--church i { font-size: 0.85em; }


  .cadence-letter {
    --letter-frame: color-mix(in srgb, #5a5a5a 10%, var(--border-strong));
    --letter-rule: color-mix(in srgb, #5a5a5a 8%, var(--border));
    --letter-surface-top: color-mix(in srgb, #f2f2f2 55%, var(--bg-elevated));
    --letter-surface-bottom: color-mix(in srgb, #e0e0e0 35%, var(--bg));
    margin-bottom: var(--space-5);
    max-width: 100%;
  }

  .cadence-letter__sheet {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--letter-frame);
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--letter-surface-top), var(--letter-surface-bottom));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      0 1px 3px color-mix(in srgb, var(--fg) 5%, transparent);
  }

  .cadence-letter__sheet::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--letter-frame);
    border-radius: calc(var(--radius-sm) - 3px);
    pointer-events: none;
    opacity: 0.35;
    z-index: 1;
  }

  .cadence-letter__address {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    line-height: 1.65;
    color: var(--fg-soft);
  }

  .cadence-letter__address p {
    margin: 0;
  }

  .cadence-letter__address p + p {
    margin-top: 0.15em;
  }

  .cadence-letter__label {
    display: inline-block;
    min-width: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cadence-letter__rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--letter-rule);
  }

  .cadence-letter__salutation,
  .cadence-letter__paragraph {
    margin: 0 0 var(--space-3);
    font-family: ui-serif, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cadence-letter__salutation {
    margin-bottom: var(--space-2);
  }

  .cadence-letter__paragraph:last-of-type {
    margin-bottom: 0;
  }

  @media (prefers-color-scheme: dark) {
    .cadence-letter {
      --letter-frame: color-mix(in srgb, #a8a8a8 8%, var(--border-strong));
      --letter-rule: color-mix(in srgb, #a8a8a8 6%, var(--border));
      --letter-surface-top: color-mix(in srgb, #a8a8a8 4%, var(--bg-elevated));
      --letter-surface-bottom: color-mix(in srgb, #5a5a5a 6%, #0a0a0a);
    }

  }

  .cadence-why {
    margin-top: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .cadence-why__paragraph {
    margin: 0 0 var(--space-3);
    font-size: var(--size-lead);
    line-height: 1.55;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  .cadence-why__paragraph:last-of-type {
    margin-bottom: 0;
  }

  .cadence-footer {
    margin-top: var(--space-5);
    margin-bottom: var(--space-4);
  }
</style>
