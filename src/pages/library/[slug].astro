---
/**
 * One route for both `/library/<kind>/` (e.g. /library/books/) and
 * `/library/<item-slug>/` (items with notes). Item files are prefixed with
 * their kind (`book-…`, `tool-…`) so the two never collide.
 */
import Site from '../../layouts/Site.astro';
import PageHead from '../../components/site/PageHead.astro';
import LibraryChips from '../../components/site/LibraryChips.astro';
import LibraryList from '../../components/site/LibraryList.astro';
import Signature from '../../components/Signature.astro';
import TagChips from '../../components/TagChips.astro';
import { postComponents } from '../../components/post';
import { imgSrc } from '../../lib/img';
import {
  byKind,
  getLibrary,
  hasPage,
  hostOf,
  itemCodes,
  KIND_META,
  KINDS,
  kindHref,
  type LibraryItem,
  type LibraryKind,
} from '../../lib/library';

export async function getStaticPaths() {
  const items = await getLibrary();
  const kindPaths = KINDS.filter((k) => byKind(items, k).length > 0).map((kind) => ({
    params: { slug: KIND_META[kind].path },
    props: { mode: 'kind' as const, kind },
  }));
  const itemPaths = items.filter(hasPage).map((item) => ({
    params: { slug: item.slug },
    props: { mode: 'item' as const, item },
  }));
  return [...kindPaths, ...itemPaths];
}

type Props =
  | { mode: 'kind'; kind: LibraryKind }
  | { mode: 'item'; item: LibraryItem };

const props = Astro.props;
const items = await getLibrary();
const codes = itemCodes(items);
const counts = Object.fromEntries(KINDS.map((k) => [k, byKind(items, k).length])) as Record<LibraryKind, number>;

const item = props.mode === 'item' ? props.item : undefined;
const rendered = item ? await item.render() : undefined;
const Content = rendered?.Content;
const d = item?.data;
const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const READING = { reading: 'Reading', read: 'Read', want: 'Want to read' } as const;
const specRows: [string, string | undefined, string?][] = d
  ? [
      ['Catalog', codes.get(item!.id)],
      ['Kind', KIND_META[d.kind].one],
      ['Group', d.group],
      [d.kind === 'podcast' ? 'Host' : d.kind === 'book' ? 'Author' : 'By', d.by],
      ['Status', d.reading ? READING[d.reading] : undefined],
      ['Saved', d.date ? fmt(d.date) : undefined],
      ['Source', hostOf(d.url), d.url],
    ]
  : [];
---
{props.mode === 'kind' ? (
  <Site
    noindex
    title={`${KIND_META[props.kind].many} — Library — Derek Castelli`}
    description={KIND_META[props.kind].intro}
    bar={{ kind: 'page', title: KIND_META[props.kind].many }}
  >
    <main class="home">
      <PageHead title={KIND_META[props.kind].many} meta={`Library · ${counts[props.kind]} ${KIND_META[props.kind].many.toLowerCase()}`} lede={KIND_META[props.kind].intro}>
        <LibraryChips counts={counts} total={items.length} active={props.kind} />
      </PageHead>
      <LibraryList kind={props.kind} items={byKind(items, props.kind)} heading={false} />
    </main>
    <div class="peek sq" id="peek" aria-hidden="true"></div>
    <script src="../../client/peek.ts"></script>
  </Site>
) : (
  <Site noindex title={`${d!.title} — Library — Derek Castelli`} description={d!.note ?? KIND_META[d!.kind].intro} bar={{ kind: 'page', title: d!.title }}>
    <article class="essay" data-select>
      <div class="essay__meta">
        <a href="/library/">Library</a><span>·</span><a href={kindHref(d!.kind)}>{KIND_META[d!.kind].many}</a>
        {specRows.filter(([k, v]) => v && k !== 'Kind').map(([k, v, href]) => <><span>·</span>{href ? <a href={href} target="_blank" rel="noopener">{v}</a> : <span>{k === 'Catalog' ? v : `${k} ${v}`}</span>}</>)}
      </div>
      <h1>{d!.url ? <a href={d!.url} target="_blank" rel="noopener">{d!.title} ↗</a> : d!.title}</h1>
      {d!.note && <p class="lede">{d!.note}</p>}
      <div class="prose post-content">
        {d!.image && (
          <figure class="fig sq">
            <div class="fig__head"><span class="fig__no">{codes.get(item!.id)}</span><span class="fig__title">{d!.title}</span></div>
            <div class="fig__stage"><img class="lib__art" src={imgSrc(d!.image, 960)} alt="" decoding="async" /></div>
          </figure>
        )}
        {Content && <Content components={postComponents} />}
      </div>
      <TagChips tags={d!.tags} />
      <div class="essay__sign"><Signature /></div>
    </article>
    <div class="selbar" id="selbar" hidden></div>
    <script src="../../client/select-menu.ts"></script>
  </Site>
)}
