---
import Site from '../../layouts/Site.astro';
import PageHead from '../../components/site/PageHead.astro';
import LibraryChips from '../../components/site/LibraryChips.astro';
import LibraryList from '../../components/site/LibraryList.astro';
import Elsewhere from '../../components/site/Elsewhere.astro';
import { byKind, getLibrary, KINDS, type LibraryKind } from '../../lib/library';

const items = await getLibrary();
const counts = Object.fromEntries(KINDS.map((k) => [k, byKind(items, k).length])) as Record<LibraryKind, number>;
---
<Site
  noindex
  title="Library — Derek Castelli"
  description="Things Derek has saved and collected: books, podcasts, bookmarks, posts, interests, and tools."
  bar={{ kind: 'page', title: 'Library' }}
>
  <main class="home">
    <PageHead title="Library" meta={`Library · ${items.length} things`} lede="Things I've saved and collected. Books, podcasts, bookmarks, posts worth keeping, the stuff I'm into, and the tools I use every day.">
      <LibraryChips counts={counts} total={items.length} />
    </PageHead>
    {KINDS.filter((k) => counts[k] > 0).map((kind) => (
      <LibraryList kind={kind} items={byKind(items, kind)} limit={kind === 'post' ? 4 : kind === 'tool' ? 8 : 6} />
    ))}
    <Elsewhere />
  </main>
  <div class="peek sq" id="peek" aria-hidden="true"></div>
  <script src="../../client/peek.ts"></script>
  <script src="../../client/chips.ts"></script>
</Site>
