---
/**
 * Work with me: who I am, whether I'm free, what I do as Derek J Design, and an estimate you build
 * one step at a time, beside a proposal set like the ones I send (client/hire.ts). Requests are saved
 * and emailed to me (functions/api/hire.ts). Prices, extras, timing and availability live in src/data/hire.ts.
 */
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Said from '../components/site/Said.astro';
import Signature from '../components/Signature.astro';
import { availability, EXAMPLES, EXTRAS, PRICES, SERVICES, TIMELINE } from '../data/hire';
import { getPublishedWork } from '../lib/work';
import { appPicture, comingSoon, frameAttrs, getApps, pageOf, shotsOf, workDate } from '../lib/deck';
import { imgSrc } from '../lib/img';
import { workTestimonials } from '../data/about';
import '../styles/hire.css';

const work = await getPublishedWork();

// Each service's examples, in a chosen order: a write-up's first shot, or one of my apps (its icon or picture)
const apps = await getApps();
type Layer = { src: string; title: string; href: string; at: number; frame?: { class?: string; style?: string }; icon?: boolean; mesh?: string };
const stacks = Object.fromEntries(await Promise.all(SERVICES.map(async (s) => {
  const layers = (await Promise.all(EXAMPLES[s.id].map(async (ex): Promise<Layer | null> => {
    if ('work' in ex) {
      const w = work.find((x) => x.slug === ex.work); const first = w && shotsOf(w)[0];
      if (!w || !first) return null;
      const page = await pageOf(first, 480);
      return 'src' in page ? { src: page.src, title: w.data.title, href: `/work/${w.slug}/`, at: workDate(w).valueOf(), frame: frameAttrs(page) } : null;
    }
    const a = apps.find((x) => x.slug === ex.app); if (!a) return null;
    const icon = ex.show === 'icon' || comingSoon(a), src = icon ? a.data.icon : appPicture(a);
    return src ? { src: imgSrc(src, icon ? 240 : 640), title: a.data.name, href: a.data.url || '/projects/', at: Date.UTC(a.data.year ?? new Date().getUTCFullYear(), 0), icon, mesh: a.slug } : null;
  }))).filter((l): l is Layer => Boolean(l)); // in the order the data file gives, strongest first
  return [s.id, layers] as const;
})));

const photo = imgSrc('/assets/about/derek-photo.jpeg', 240);
const GEAR = 'M265.211 124.541C272.306 134.304 272.321 147.522 265.248 157.301L183.357 270.523C176.262 280.333 163.65 284.449 152.134 280.713L19.4531 237.675C7.9591 233.947 0.170298 223.245 0.156758 211.161L1.7679e-05 71.2763C-0.0135219 59.1928 7.7512 48.4732 19.2368 44.7191L151.821 1.38292C163.329 -2.3785 175.949 1.70923 183.067 11.5032L265.211 124.541ZM96.1302 94.6653C84.6447 98.4195 76.88 109.139 76.8935 121.222L76.938 161.004C76.9516 173.087 84.7404 183.79 96.2345 187.518L133.88 199.729C145.397 203.464 158.008 199.348 165.103 189.539L188.372 157.368C195.445 147.589 195.43 134.37 188.335 124.607L164.995 92.4893C157.877 82.6954 145.257 78.6078 133.749 82.3693L96.1302 94.6653Z';
const extrasFor = (id: string) => EXTRAS.filter((x) => x.service === id);
const STEPS = [['services', 'What'], ['details', 'Details'], ['timing', 'When'], ['you', 'You'], ['review', 'Send']];
---
<Site
  title="Work with me — Derek Castelli"
  description="Websites, logos, rebrands, feedback, and AI workflows and apps, from Derek J Design. See what it costs before we talk."
  ogImage="/og/hire.png"
  bar={{ kind: 'page', title: 'Work with me' }}
>
  <main class="home hire">
    <header class="hire-me">
      <img class="hire-me__photo sq" src={photo} alt="Derek Castelli" width="104" height="104" />
      <div class="hire-me__name">
        <span class="essay__meta"><span>Derek J Design · Testament Made, LLC</span></span>
        <h1>Work with me</h1>
        <p class:list={['hire-status', !availability.open && 'is-closed']}><i aria-hidden="true"></i>{availability.open ? 'Open for work' : 'Booked up for now'}{availability.open && <span> · <span data-avail="small">{availability.from === 'now' ? 'open now' : `from ${availability.from}`}</span></span>}</p>
      </div>
    </header>
    <p class="lede hire-lede">I’m Derek, a self-taught designer in Des Moines, designing since 2010. I make sites, logos and brands, give honest feedback, and help put AI to work where it helps. You’ll work with me directly, from the first call to launch.</p>

    <section class="hire-said" aria-label="What people say" aria-roledescription="carousel">
      <Said />
      <div class="hire-said__nav">
        <button type="button" class="sq" data-said="-1" aria-label="Previous"><Icon name="arrow-left" loop={false} /></button>
        <span class="hire-said__dots" aria-hidden="true">{workTestimonials.map((_, i) => <i class:list={[!i && 'is-on']}></i>)}</span>
        <button type="button" class="sq" data-said="1" aria-label="Next"><Icon name="arrow-right" loop={false} /></button>
      </div>
    </section>

    <h2 class="h">What I do</h2>
    <div class="hire-caps">
      {SERVICES.filter((s) => stacks[s.id].length).map((s) => (
        <div class="hire-cap sq">
          <span class="row__shots hire-cap__stack" aria-hidden="true">{stacks[s.id].slice(0, 4).map((l, i) => (
            <span class:list={['row__shot sq', l.icon && 'is-icon']} style={`--i:${i}`}>{l.icon ? <span class="mesh" data-mesh={l.mesh}><img src={l.src} alt="" loading="lazy" decoding="async" /></span> : <img src={l.src} alt="" class={l.frame?.class} style={l.frame?.style} loading="lazy" decoding="async" />}</span>
          ))}</span>
          <span class="hire-cap__text">
            <b><Icon name={s.icon as never} loop={false} /> {s.name}</b>
            <span>{s.line}</span>
            <small>{stacks[s.id].length} examples</small>
          </span>
          <div class="hire-cap__strip" aria-label={`${s.name}: examples`}>
            {stacks[s.id].map((l, i) => (
              <a class:list={['hire-ex sq', l.icon && 'is-icon']} href={l.href} style={`--n:${i}`} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.icon ? <span class="mesh" data-mesh={l.mesh}><img src={l.src} alt="" loading="lazy" decoding="async" /></span> : <img src={l.src} alt="" class={l.frame?.class} style={l.frame?.style} loading="lazy" decoding="async" />}<i>{l.title}</i>
              </a>
            ))}
          </div>
          <button type="button" class="hire-cap__go" data-pick={s.id}>Get an estimate <Icon name="arrow-right" loop={false} /></button>
        </div>
      ))}
    </div>
    <div class="hire-consult">
      {SERVICES.filter((s) => !stacks[s.id].length).map((s) => (
        <button type="button" class="hire-mini sq" data-pick={s.id}>
          <span class="hire-mini__icon sq" aria-hidden="true"><Icon name={s.icon as never} /></span>
          <b>{s.name}</b>
          <span>{s.line}</span>
        </button>
      ))}
    </div>

    <section class="hire-app" id="estimate" aria-label="Get an estimate">
      <div class="est sq">
        <header class="est__top">
          <b class="est__title">Get an estimate</b>
          <ol class="est__steps" aria-hidden="true">{STEPS.map(([k, l]) => <li data-dot={k}><i></i>{l}</li>)}</ol>
          <span class="est__count" aria-live="polite">Step 1</span>
          <span class="est__bar"><i></i></span>
        </header>
        <div class="est__body">
          <form class="est__panel" id="hireForm" novalidate>
            <div class="est__screens">
              <section class="est__screen is-on" data-screen="services">
                <h3>What can I help with?<small>Pick as many as you like.</small></h3>
                <div class="hire-picks">
                  {SERVICES.map((s) => (
                    <button type="button" class="hire-pick sq" data-service={s.id} aria-pressed="false"><Icon name={s.icon as never} /><b>{s.name}</b><small>{s.from}</small></button>
                  ))}
                  <button type="button" class="hire-pick sq" data-service="unsure" aria-pressed="false"><Icon name="message" /><b>Not sure yet</b><small>Let’s talk it through</small></button>
                </div>
              </section>

              <section class="est__screen" data-screen="site">
                <h3><Icon name="laptop" loop={false} /> Your website</h3>
                <div class="hire-row"><span>Is it</span><div class="hire-seg" data-k="site.kind"><button type="button" data-v="new">New</button><button type="button" data-v="redesign">A redesign</button></div></div>
                <label class="hire-row hire-slider"><span>Pages</span><output data-out="site.pages">5</output><input type="range" min="1" max={PRICES.site.maxPages} step="1" value="5" data-k="site.pages" aria-label="How many pages" /></label>
                <div class="hire-row"><span>From me</span><div class="hire-seg" data-k="site.scope"><button type="button" data-v="both">Design + build</button><button type="button" data-v="design">Design</button><button type="button" data-v="build">Build</button></div></div>
                <label class="hire-row hire-switch"><span>Content your team updates<small>Posts, listings, a team page (a CMS)</small></span><input type="checkbox" data-k="site.cms" /><i aria-hidden="true"></i></label>
                <div class="hire-row"><span>Built in</span><div class="hire-seg" data-k="site.platform"><button type="button" data-v="webflow">Webflow</button><button type="button" data-v="open">You tell me</button></div></div>
                <div class="hire-extras"><span class="hire-extras__h">Add to it</span>{extrasFor('site').map((x) => <label class="hire-extra sq"><input type="checkbox" data-extra={x.id} /><span><b>{x.name}</b><small>{x.desc}</small></span><em>+${x.price.toLocaleString()}</em></label>)}</div>
              </section>

              <section class="est__screen" data-screen="logo">
                <h3><Icon name="pencil" loop={false} /> Your logo</h3>
                <div class="hire-row"><span>Is it</span><div class="hire-seg" data-k="logo.kind"><button type="button" data-v="new">New</button><button type="button" data-v="refresh">A refresh</button></div></div>
                <div class="hire-row" data-when="logo.kind=new"><span>Kind</span><div class="hire-seg" data-k="logo.type"><button type="button" data-v="wordmark">Wordmark</button><button type="button" data-v="mark">Mark</button><button type="button" data-v="both">Both</button></div></div>
                <div class="hire-extras"><span class="hire-extras__h">Add to it</span>{extrasFor('logo').map((x) => <label class="hire-extra sq"><input type="checkbox" data-extra={x.id} /><span><b>{x.name}</b><small>{x.desc}</small></span><em>+${x.price.toLocaleString()}</em></label>)}</div>
              </section>

              <section class="est__screen" data-screen="rebrand">
                <h3><Icon name="palette" loop={false} /> Your rebrand</h3>
                <div class="hire-row"><span>The logo</span><div class="hire-seg" data-k="rebrand.has"><button type="button" data-v="full">A new one too</button><button type="button" data-v="keepLogo">Keep it</button></div></div>
                <label class="hire-row hire-switch"><span>Carry it through to the website<small>Adds the website to your estimate</small></span><input type="checkbox" data-also="site" /><i aria-hidden="true"></i></label>
                <div class="hire-extras"><span class="hire-extras__h">Add to it</span>{extrasFor('rebrand').map((x) => <label class="hire-extra sq"><input type="checkbox" data-extra={x.id} /><span><b>{x.name}</b><small>{x.desc}</small></span><em>+${x.price.toLocaleString()}</em></label>)}</div>
              </section>

              <section class="est__screen" data-screen="feedback">
                <h3><Icon name="eye" loop={false} /> Feedback</h3>
                <div class="hire-row"><span>On your</span><div class="hire-seg" data-k="feedback.on"><button type="button" data-v="site">Site</button><button type="button" data-v="app">App</button><button type="button" data-v="brand">Brand</button></div></div>
                <div class="hire-row"><span>As</span><div class="hire-seg" data-k="feedback.how"><button type="button" data-v="notes">Written notes</button><button type="button" data-v="call">A call</button></div></div>
                <div class="hire-extras"><span class="hire-extras__h">Add to it</span>{extrasFor('feedback').map((x) => <label class="hire-extra sq"><input type="checkbox" data-extra={x.id} /><span><b>{x.name}</b><small>{x.desc}</small></span><em>+${x.price.toLocaleString()}</em></label>)}</div>
              </section>

              <section class="est__screen" data-screen="ai">
                <h3><Icon name="branch" loop={false} /> Your AI project</h3>
                <div class="hire-row"><span>What</span><div class="hire-seg" data-k="ai.kind"><button type="button" data-v="workflow">A workflow</button><button type="button" data-v="tool">A tool</button><button type="button" data-v="prototype">An app</button></div></div>
                <div class="hire-row"><span>Size</span><div class="hire-seg" data-k="ai.size"><button type="button" data-v="small">Small</button><button type="button" data-v="medium">Medium</button><button type="button" data-v="large">Large</button></div></div>
                <div class="hire-extras"><span class="hire-extras__h">Add to it</span>{extrasFor('ai').map((x) => <label class="hire-extra sq"><input type="checkbox" data-extra={x.id} /><span><b>{x.name}</b><small>{x.desc}</small></span><em>+${x.price.toLocaleString()}</em></label>)}</div>
              </section>

              <section class="est__screen" data-screen="timing">
                <h3>When would you like to start?<small>Prices move with timing, scope and what’s included.</small></h3>
                <div class="hire-when" data-k="timeline">
                  {Object.entries(TIMELINE).map(([k, t]) => <button type="button" class="hire-pick sq" data-v={k}><b>{t.short}</b><small>{t.rush ? `+${Math.round(t.rush * 100)}% rush` : t.label}</small></button>)}
                </div>
                <label class="hire-row hire-switch" data-when-any="site"><span>Keep me on after launch<small>${PRICES.retainer.monthly}/mo for {PRICES.retainer.hours} hours of updates and fixes</small></span><input type="checkbox" data-k="retainer" /><i aria-hidden="true"></i></label>
                <div class="hire-row"><span>Budget in mind</span><div class="hire-seg" data-k="budget"><button type="button" data-v="">Not sure</button><button type="button" data-v="Under $2k">&lt;$2k</button><button type="button" data-v="$2–5k">$2–5k</button><button type="button" data-v="$5–10k">$5–10k</button><button type="button" data-v="$10k+">$10k+</button></div></div>
              </section>

              <section class="est__screen" data-screen="you">
                <h3>Who am I talking to?</h3>
                <div class="hire-fields">
                  <label><span>Name</span><input name="name" autocomplete="name" required maxlength="80" /></label>
                  <label><span>Email</span><input name="email" type="email" autocomplete="email" required maxlength="120" /></label>
                  <label><span>Organization</span><input name="org" autocomplete="organization" maxlength="100" placeholder="Optional" /></label>
                  <label><span>Your site</span><input name="link" type="url" inputmode="url" maxlength="200" placeholder="Optional" /></label>
                  <label class="hire-fields__wide"><span>Anything else</span><textarea name="message" rows="4" maxlength="3000" placeholder="What you’re hoping for, what’s not working, who it’s for…"></textarea></label>
                </div>
                <input class="hire-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              </section>

              <section class="est__screen" data-screen="review">
                <h3>Look right?<small>It comes straight to my inbox. I’ll reply within two business days.</small></h3>
                <dl class="hire-review" data-review></dl>
              </section>

              <section class="est__screen" data-screen="sent">
                <div class="hire-note">
                  <img class="hire-note__photo sq" src={photo} alt="" width="56" height="56" />
                  <h3>Thanks, <span data-thanks>friend</span>.</h3>
                  <p>Your request is in my inbox. I read every one myself and will reply within two business days, usually sooner.</p>
                  <ol class="hire-next">
                    <li><b>A short call</b><span>About what you need and why.</span></li>
                    <li><b>A proposal</b><span>Like the one beside this, with real numbers.</span></li>
                    <li><b>We get to work</b><span>Design, build, and launch together.</span></li>
                  </ol>
                  <div class="hire-note__sign" data-sign></div>
                  <template id="hireSign"><Signature variant="draw" /></template>
                  <div class="hire-note__acts">
                    <button type="button" class="est__btn sq" data-print><Icon name="file-down" /> Save the estimate</button>
                    <button type="button" class="est__btn est__btn--quiet sq" data-again>Start another</button>
                  </div>
                </div>
              </section>
            </div>
            <footer class="est__nav">
              <button type="button" class="est__btn est__btn--quiet sq" data-back hidden><Icon name="arrow-left" loop={false} /> Back</button>
              <small class="est__hint" aria-live="polite"></small>
              <button type="button" class="est__btn est__btn--go sq" data-next>Continue <Icon name="arrow-right" /></button>
            </footer>
          </form>

          <aside class="est__side">
            <article class="prop sq" id="proposal" aria-label="Your estimate">
              <header class="prop__head">
                <div>
                  <b class="prop__title"><span data-p="org">Your project</span><i class="prop__mark" aria-hidden="true"><Icon name="arrow-right" loop={false} /></i>Derek J Design</b>
                  <small>Project estimate</small>
                  <small class="prop__tags" data-p="tags"></small>
                </div>
                <time data-p="date"></time>
              </header>
              <section><h4><i class="prop__mark" aria-hidden="true"><Icon name="arrow-right" loop={false} /></i>Overview</h4><p class="prop__overview" data-p="overview">Pick what you need and your estimate builds here, line by line.</p></section>
              <section data-p="scope-wrap" hidden><h4><i class="prop__mark" aria-hidden="true"><Icon name="arrow-right" loop={false} /></i>Scope</h4><ul class="prop__lines" data-p="lines"></ul></section>
              <section data-p="total-wrap" hidden><h4><i class="prop__mark" aria-hidden="true"><Icon name="arrow-right" loop={false} /></i>Proposed Total</h4><ul class="prop__lines prop__lines--totals" data-p="totals"></ul></section>
              <section data-p="pay-wrap" hidden><h4><i class="prop__mark" aria-hidden="true"><Icon name="arrow-right" loop={false} /></i>Payment</h4><ul class="prop__pay" data-p="pay"></ul></section>
              <footer class="prop__foot">
                <svg class="prop__gear" viewBox="0 0 271 283" aria-hidden="true"><path d={GEAR} /></svg>
                <span><b>Derek J Design</b>Testament Made, LLC</span>
                <p>A starting point. Price and payment follow scope, timing and what’s included; I’ll confirm after we talk.</p>
              </footer>
            </article>
          </aside>
        </div>
      </div>
      <div class="hire-sum sq" id="hireSum" hidden><span>Estimate</span><b data-p="sum">$0</b><a href="#proposal">See it <Icon name="arrow-down" loop={false} /></a></div>
    </section>

    <p class="hire-close">Rather just talk? Email me at <button type="button" class="hire-mail sq" data-copy="derekj@hey.com">derekj@hey.com <small>Copy</small></button></p>
  </main>
  <div class="peek sq" id="peek" aria-hidden="true"></div>
  <script src="../client/peek.ts"></script>
  <script src="../client/hire.ts"></script>
</Site>
