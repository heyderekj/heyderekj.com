---
import Site from '../layouts/Site.astro';
import Hello from '../components/site/Hello.astro';
import WorkDeck from '../components/site/WorkDeck.astro';
import PostIndex from '../components/site/PostIndex.astro';
import Elsewhere from '../components/site/Elsewhere.astro';
import { schemaPersonId, schemaWebsiteId } from '../lib/schemaIds';

const siteOrigin = (Astro.site?.toString() ?? 'https://heyderekj.com/').replace(/\/$/, '');
const defaultDesc =
  'Agentic design engineer, still making websites full-time. Writing on faith and technology.';
const homeJsonLd = [
  {
    '@type': 'WebSite',
    '@id': schemaWebsiteId(siteOrigin),
    url: `${siteOrigin}/`,
    name: 'Derek Castelli',
    description: defaultDesc,
    inLanguage: 'en-US',
    publisher: { '@id': schemaPersonId(siteOrigin) },
  },
  {
    '@type': 'Person',
    '@id': schemaPersonId(siteOrigin),
    name: 'Derek Castelli',
    url: siteOrigin,
    jobTitle: 'Agentic design engineer',
    sameAs: ['https://github.com/heyderekj', 'https://twitter.com/heyderekj'],
  },
];
---
<Site jsonLd={homeJsonLd} bar={{ kind: 'home' }}>
  <main class="home">
    <Hello />
    <WorkDeck />
    <PostIndex />
    <Elsewhere />
  </main>
  <script src="../client/chips.ts"></script>
  <script src="../client/deck.ts"></script>
  <script src="../client/peek.ts"></script>
  <script src="../client/dsm-sketch.ts"></script>
</Site>
