---
/**
 * Square-media project cards (homepage + /projects tiers). Order is preserved —
 * callers sort (see lib/projectTiers.ts).
 */
import type { CollectionEntry } from 'astro:content';
import { imgAttrs, imgFixed } from '../lib/img';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---
<ul class="project-grid">
  {projects.map((project) => {
    const thumbSrc = project.data.image ?? project.data.icon;
    const isIconOnly = !project.data.image && Boolean(project.data.icon);
    const isFramed = !isIconOnly && project.data.imageFit === 'contain';
    return (
      <li class="project-grid-item">
        <a href={`/projects/${project.slug}/`} class="project-grid-card">
          <div class="project-grid-visual">
            {thumbSrc ? (
              <img
                {...imgAttrs(thumbSrc, { sizes: '(max-width: 540px) 92vw, 260px', w: 640 })}
                alt={project.data.name}
                class={`project-grid-img${isIconOnly ? ' project-grid-img--icon' : ''}${isFramed ? ' project-grid-img--framed' : ''}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="project-grid-placeholder" aria-hidden="true">
                {project.data.name[0]}
              </div>
            )}
          </div>
          <div class="project-grid-footer">
            <div class="project-grid-info">
              <span class="project-grid-name">
                {project.data.icon && (
                  <img
                    class="project-grid-icon"
                    {...imgFixed(project.data.icon, 22)}
                    alt=""
                    width="22"
                    height="22"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {project.data.name}
              </span>
              <span class="project-grid-tagline">{project.data.tagline}</span>
            </div>
            <span class="project-grid-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      </li>
    );
  })}
</ul>

<style>
  /* Cadence / work-style media grid */
  .project-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .project-grid-item {
    margin: 0;
    padding: 0;
  }

  :global(main.main) .project-grid-card {
    display: block;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
  }

  .project-grid-visual {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    position: relative;
    transition: background-color 0.2s ease;
  }

  /* Square canvas: image centered and scaled down on the mat (same as work gallery).
     Logos/icons get a bit more breathing room via --icon. */
  .project-grid-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    box-sizing: border-box;
    padding: 10%;
    display: block;
  }

  .project-grid-img--icon {
    padding: 20%;
  }

  .project-grid-img--framed {
    padding: 10%;
  }

  :global(main.main) .project-grid-card:hover .project-grid-visual {
    background: color-mix(in srgb, var(--fg) 3%, var(--bg-elevated));
  }

  .project-grid-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--bg-elevated);
    user-select: none;
  }

  .project-grid-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    font-size: var(--size-body);
  }

  .project-grid-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .project-grid-icon {
    width: 22px;
    height: 22px;
    border-radius: 22%;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px var(--border);
  }

  .project-grid-name {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: inherit;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.25;
    transition: color 0.15s ease;
  }

  :global(main.main) .project-grid-card:hover .project-grid-name {
    color: var(--fg);
  }

  .project-grid-tagline {
    font-size: var(--size-meta);
    color: var(--fg-soft);
    line-height: 1.55;
  }

  .project-grid-date {
    font-size: var(--size-meta);
    color: var(--muted-strong);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .project-grid-arrow {
    color: var(--muted);
    font-size: 16px;
    flex-shrink: 0;
    line-height: 1.4;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  :global(main.main) .project-grid-card:hover .project-grid-arrow {
    color: var(--fg);
    transform: translateX(2px);
  }

  :global(main.main) .project-grid-card:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }

  @media (max-width: 540px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
