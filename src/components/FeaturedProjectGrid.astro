---
import type { CollectionEntry } from 'astro:content';
import { formatProjectStartLabel, formatProjectUpdatedLabel, projectStartTime } from '../lib/projectStart';
import { displayProjectStatus } from '../lib/projectStatus';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const sorted = [...projects].sort((a, b) => projectStartTime(b) - projectStartTime(a));
---
<ul class="project-cards">
  {sorted.map((project) => {
    const startStr = formatProjectStartLabel(project);
    const updatedStr = formatProjectUpdatedLabel(project);
    const stackStr = project.data.stack?.length ? project.data.stack.join(', ') : '';
    const thumbSrc = project.data.icon ?? project.data.image;
    return (
      <li class="project-card">
        <a href={`/projects/${project.slug}/`} class="project-card-link">
          <div class="card-thumb">
            {thumbSrc ? (
              <img
                src={thumbSrc}
                alt={project.data.name}
                class={`card-thumb-img${project.data.icon ? ' card-thumb-img--icon' : ''}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="card-thumb-placeholder" aria-hidden="true">
                {project.data.name[0]}
              </div>
            )}
          </div>
          <div class="card-body">
            <span class="card-name">{project.data.name}</span>
            <p class="card-tagline">{project.data.tagline}</p>
            <p class="card-foot">
              <span class="card-foot-lead">
                {project.data.status && (
                  <span class={`card-status card-status--${project.data.status}`}>
                    {displayProjectStatus(project.data.status)}
                  </span>
                )}
                {startStr && (
                  <span class="card-foot-date">
                    {updatedStr ? `Started ${startStr}` : startStr}
                  </span>
                )}
                {updatedStr && (
                  <>
                    {startStr && <span class="card-foot-gap">·</span>}
                    <span class="card-foot-date">Updated {updatedStr}</span>
                  </>
                )}
              </span>
              {stackStr && (startStr || updatedStr || project.data.status) && (
                <span class="card-foot-gap">·</span>
              )}
              {stackStr && <span class="card-foot-stack">{stackStr}</span>}
            </p>
          </div>
          <span class="card-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
.project-cards {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.project-card {
  margin: 0;
  padding: 0;
}

:global(main.main) .project-card-link {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  text-decoration: none;
  color: inherit;
  box-sizing: border-box;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

:global(main.main) .project-card-link:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

:global(main.main) .project-card-link:hover {
  background-color: var(--glass-active-bg);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-color: transparent;
  box-shadow: var(--glass-inset), 0 1px 6px rgba(0, 0, 0, 0.06);
}

/* Thumbnail — matches content height, stays square */
.card-thumb {
  flex-shrink: 0;
  align-self: stretch;
  aspect-ratio: 1 / 1;
  height: auto;
  width: auto;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-elevated);
}

.card-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.3s ease;
}

.card-thumb-img--icon {
  object-fit: contain;
  padding: 12%;
  background: var(--bg-elevated);
}

:global(main.main) .project-card-link:hover .card-thumb-img {
  transform: scale(1.05);
}

.card-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--muted);
  user-select: none;
}

/* Content */
.card-body {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.card-name {
  font-size: var(--size-body);
  font-weight: 600;
  color: var(--fg);
  transition: color 0.15s ease;
  line-height: 1.25;
}

:global(main.main) .project-card-link:hover .card-name {
  color: var(--accent);
}

.card-tagline {
  margin: 0;
  font-size: var(--size-meta);
  color: var(--fg-soft);
  line-height: 1.45;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-foot {
  margin: 0;
  font-size: var(--size-meta);
  color: var(--muted-strong);
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 0.4rem;
  row-gap: 0.2rem;
}

.card-foot-lead {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
}

.card-foot-date {
  font-variant-numeric: tabular-nums;
}

.card-foot-gap {
  color: var(--muted);
  user-select: none;
}

.card-foot-stack {
  min-width: 0;
}

/* Status chips */
.card-status {
  flex-shrink: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: var(--radius-pill);
  line-height: 1.2;
}

.card-status--active {
  color: var(--muted-strong);
  background: rgba(249, 115, 22, 0.14);
}

.card-status--paused {
  color: var(--muted-strong);
  background: rgba(234, 179, 8, 0.12);
}

.card-status--maintained {
  color: var(--muted-strong);
  background: rgba(0, 0, 0, 0.035);
}

/* Arrow */
.card-arrow {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1;
  align-self: center;
  transition: color 0.15s ease, transform 0.15s ease;
}

:global(main.main) .project-card-link:hover .card-arrow {
  color: var(--accent);
  transform: translateX(2px);
}
</style>
