---
import { bragSummaryHtml, type BragClipping, type BragPreview } from '../data/brag';

interface Props {
  clippings: BragClipping[];
}

const { clippings } = Astro.props;

const previewsFor = (clip: BragClipping): BragPreview[] => {
  if (!clip.preview) return [];
  return Array.isArray(clip.preview) ? clip.preview : [clip.preview];
};

const imagePreviews = (previews: BragPreview[]) =>
  previews.filter((p) => !p.variant || p.variant === 'image');

const imagePreviewCount = (previews: BragPreview[]) => imagePreviews(previews).length;
---

<ol class="brag-feed" role="list">
  {
    clippings.map((clip) => {
      const previews = imagePreviews(previewsFor(clip));
      return (
        <li class="brag-item">
          <div class="brag-item-copy">
            <p class="brag-item-kicker">
              <span class="brag-item-pub">{clip.publication}</span>
              {clip.dateline ? (
                <>
                  <span class="brag-item-kicker-dot" aria-hidden="true">·</span>
                  <time class="brag-item-date" datetime={clip.dateline}>{clip.dateline}</time>
                </>
              ) : null}
            </p>

            {clip.href ? (
              <h2 class="brag-item-title">
                <a href={clip.href}>{clip.headline}</a>
              </h2>
            ) : (
              <h2 class="brag-item-title">{clip.headline}</h2>
            )}

            {clip.summaryLinks?.length ? (
              <p class="brag-item-summary" set:html={bragSummaryHtml(clip.summary, clip.summaryLinks)} />
            ) : (
              <p class="brag-item-summary">{clip.summary}</p>
            )}
          </div>

          {previews.length > 0 && (
            <div
              class:list={[
                'brag-item-previews',
                imagePreviewCount(previewsFor(clip)) > 1 && 'brag-item-previews--multi',
              ]}
              aria-label="Related work preview"
            >
              {previews.map((preview) => {
                const href = preview.href ?? clip.href;
                const media = preview.src ? (
                  <div class="brag-preview-media">
                    <img
                      class="brag-preview-img"
                      src={preview.src}
                      alt={preview.alt}
                      width={320}
                      height={200}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : null;
                const caption = preview.caption ? (
                  <span class="brag-preview-caption">{preview.caption}</span>
                ) : null;

                return href ? (
                  <a class="brag-preview" href={href}>
                    {media}
                    {caption}
                  </a>
                ) : (
                  <div class="brag-preview">
                    {media}
                    {caption}
                  </div>
                );
              })}
            </div>
          )}

          {clip.testimonial && (
            <figure class="brag-item-testimonial">
              <blockquote class="work-testimonial-quote">{clip.testimonial.quote}</blockquote>
              <figcaption class="work-testimonial-footer">
                <p class="work-testimonial-name">{clip.testimonial.author}</p>
                <p class="work-testimonial-role">{clip.testimonial.role}</p>
                <p class="work-testimonial-context">{clip.testimonial.context}</p>
              </figcaption>
            </figure>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .brag-feed {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: brag;
  }

  .brag-item {
    counter-increment: brag;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-3);
    align-items: start;
  }

  .brag-item::before {
    content: counter(brag, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-weight: 700;
    color: var(--muted);
    line-height: 1.6;
    padding-top: 2px;
  }

  .brag-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .brag-item-copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .brag-item-previews {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    min-width: 0;
    overflow: visible;
  }

  .brag-item-previews--multi {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .brag-item-testimonial {
    grid-column: 2;
    margin: 0;
    min-width: 0;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    padding: var(--space-3);
    box-sizing: border-box;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .brag-item-testimonial:hover {
    background: var(--glass-active-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-color: transparent;
    box-shadow: var(--glass-inset), 0 1px 6px rgba(0, 0, 0, 0.06);
  }

  .brag-item-testimonial .work-testimonial-quote {
    margin: 0 0 var(--space-3);
    padding: 0;
    border: none;
    font-size: var(--size-meta);
    color: var(--fg-soft);
    line-height: 1.6;
  }

  .brag-item-testimonial .work-testimonial-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .brag-preview {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: visible;
    border: 1px solid transparent;
    background: transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .brag-preview:hover {
    transform: translateY(-1px);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }

  .brag-preview-media {
    overflow: hidden;
    border-radius: calc(var(--radius-md) - 1px) calc(var(--radius-md) - 1px) 0 0;
    background: var(--bg-elevated);
    flex-shrink: 0;
  }

  .brag-preview-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    vertical-align: middle;
  }

  .brag-preview-caption {
    flex-shrink: 0;
    padding: var(--space-2) var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--size-meta);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--fg-soft);
    border-radius: 0 0 calc(var(--radius-md) - 1px) calc(var(--radius-md) - 1px);
  }

  :global(main.main) .brag-preview:hover .brag-preview-caption {
    color: var(--accent);
  }

  .brag-item-kicker {
    margin: 0 0 var(--space-2);
    font-size: var(--size-micro);
    line-height: 1.4;
    color: var(--muted);
  }

  .brag-item-pub {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .brag-item-kicker-dot {
    margin-inline: 0.35em;
    color: var(--muted);
  }

  .brag-item-date {
    font-variant-numeric: tabular-nums;
  }

  .brag-item-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--size-lead);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  :global(main.main) .brag-item-title a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: none;
  }

  :global(main.main) .brag-item-title a:hover {
    color: var(--accent);
  }

  .brag-item-summary {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
    color: var(--fg-soft);
    text-wrap: pretty;
  }
</style>
