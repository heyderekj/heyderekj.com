---
import type { CollectionEntry } from 'astro:content';
import { formatProjectStartLabel, formatProjectUpdatedLabel, projectStartTime } from '../lib/projectStart';
import { displayProjectStatus } from '../lib/projectStatus';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** `default` = thumb + tagline; `compact` = thumb + meta; `row` = condensed inline row. */
  variant?: 'default' | 'compact' | 'row';
  /** `desc` = newest first (default); `asc` = oldest first. */
  startedOrder?: 'asc' | 'desc';
}

const { projects, variant = 'default', startedOrder = 'desc' } = Astro.props;
const compact = variant === 'compact';
const isRow = variant === 'row';
const showThumb = !isRow;

const sorted = [...projects].sort((a, b) => {
  const ta = projectStartTime(a);
  const tb = projectStartTime(b);
  return startedOrder === 'asc' ? ta - tb : tb - ta;
});
---
<ul class={`project-cards${isRow ? ' project-cards--row' : ''}`}>
  {sorted.map((project) => {
    const startStr = formatProjectStartLabel(project);
    const updatedStr = formatProjectUpdatedLabel(project);
    const stackStr =
      project.data.stack && project.data.stack.length > 0 ? project.data.stack.join(', ') : '';
    const thumbSrc = project.data.icon ?? project.data.image;
    const isIcon = Boolean(project.data.icon);
    const showFoot = compact
      ? Boolean(startStr || updatedStr || project.data.status)
      : Boolean(startStr || updatedStr || project.data.status || stackStr);

    if (isRow) {
      return (
        <li class="project-card">
          <a href={`/projects/${project.slug}/`} class="project-card-link project-card-link--row">
            <span class="card-name">{project.data.name}</span>
            {startStr && <span class="card-row-date">{startStr}</span>}
          </a>
        </li>
      );
    }

    return (
      <li class="project-card">
        <a href={`/projects/${project.slug}/`} class="project-card-link project-card-link--media">
          {showThumb && (
            <div class="card-thumb">
              {thumbSrc ? (
                <img
                  src={thumbSrc}
                  alt={project.data.name}
                  class={`card-thumb-img${isIcon ? ' card-thumb-img--icon' : ''}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="card-thumb-placeholder" aria-hidden="true">
                  {project.data.name[0]}
                </div>
              )}
            </div>
          )}
          <div class="card-body">
            <span class="card-name">{project.data.name}</span>
            {!compact && <p class="card-tagline">{project.data.tagline}</p>}
            {showFoot && (
              <p class="card-foot">
                {(startStr || updatedStr || project.data.status) && (
                  <span class="card-foot-lead">
                    {project.data.status && (
                      <span class={`card-status card-status--${project.data.status}`}>
                        {displayProjectStatus(project.data.status)}
                      </span>
                    )}
                    {startStr && (
                      <span class="card-foot-date">
                        {updatedStr ? `Started ${startStr}` : startStr}
                      </span>
                    )}
                    {updatedStr && (
                      <>
                        {startStr && <span class="card-foot-gap">·</span>}
                        <span class="card-foot-date">Updated {updatedStr}</span>
                      </>
                    )}
                  </span>
                )}
                {!compact && stackStr && (startStr || updatedStr || project.data.status) && (
                  <span class="card-foot-gap">·</span>
                )}
                {!compact && stackStr && <span class="card-foot-stack">{stackStr}</span>}
              </p>
            )}
          </div>
        </a>
      </li>
    );
  })}
</ul>

<style>
.project-cards {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.project-card {
  display: block;
  margin: 0;
  padding: 0;
}

/* :global(main) beats `main.main a` hairline so full card border (incl. bottom) wins. */
:global(main.main) .project-card-link {
  display: flex;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  text-decoration: none;
  color: inherit;
  box-sizing: border-box;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

/* Media card: thumbnail + body (front / back / simmering) */
:global(main.main) .project-card-link--media {
  flex-direction: row;
  align-items: stretch;
  gap: var(--space-3);
  padding: var(--space-3);
  min-height: 100%;
}

:global(main.main) .project-card-link:focus-visible {
  outline: 2px solid var(--fg);
  outline-offset: 2px;
}

/* Match .entries li:hover (post list above) */
:global(main.main) .project-card-link:hover {
  background-color: var(--glass-active-bg);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-color: transparent;
  box-shadow: var(--glass-inset), 0 1px 6px rgba(0, 0, 0, 0.06);
}

/* Thumbnail — matches content height, stays square, capped */
.card-thumb {
  flex-shrink: 0;
  align-self: stretch;
  aspect-ratio: 1 / 1;
  height: auto;
  width: auto;
  min-width: 56px;
  min-height: 56px;
  max-width: 80px;
  max-height: 80px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-elevated);
}

.card-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
  box-sizing: border-box;
  padding: 10%;
  display: block;
  transition: transform 0.3s ease;
}

.card-thumb-img--icon {
  padding: 12%;
  background: var(--bg-elevated);
}

:global(main.main) .project-card-link:hover .card-thumb-img {
  transform: scale(1.05);
}

.card-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--muted);
  user-select: none;
}

.card-body {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.card-name {
  font-size: var(--size-body);
  font-weight: 600;
  color: var(--fg);
  transition: color 0.15s ease;
  min-width: 0;
  line-height: 1.25;
}

:global(main.main) .project-card-link:hover .card-name {
  color: var(--fg);
}

/* Condensed inline row (retired) — bleed like .entries so text aligns with headings */
.project-cards--row {
  gap: 0;
}

.project-cards--row .project-card {
  margin: 0 calc(var(--space-2) * -1);
}

:global(main.main) .project-card-link--row {
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  padding: 6px var(--space-2);
}

.project-card-link--row .card-name {
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-row-date {
  flex-shrink: 0;
  font-size: var(--size-meta);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.card-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  line-height: 1.2;
  color: var(--muted-strong);
  background: color-mix(in srgb, var(--fg) 4%, transparent);
  border: 1px solid var(--border);
}

.card-status::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--muted);
  flex-shrink: 0;
}

.card-status--active::before { background: var(--accent); }
.card-status--paused::before { background: #eab308; }
.card-status--maintained::before { background: #c4a574; }

.card-status--retired::before { background: var(--muted); }

.card-tagline {
  margin: 0;
  font-size: var(--size-meta);
  color: var(--fg-soft);
  line-height: 1.45;
  max-width: 42em;
}

.card-foot {
  margin: 0;
  margin-top: 2px;
  font-size: var(--size-meta);
  color: var(--muted-strong);
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 0.4rem;
  row-gap: 0.2rem;
}

.card-foot-lead {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
}

.card-foot-date {
  font-variant-numeric: tabular-nums;
}

.card-foot-gap {
  color: var(--muted);
  user-select: none;
}

.card-foot-stack {
  min-width: 0;
}
</style>
