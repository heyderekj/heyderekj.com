---
/**
 * Pasito-style media stepper (joshpuckett.me/pasito, vanilla).
 *
 * A fixed-aspect frame with stacked slides and a dot stepper whose active dot
 * expands into a pill. Click to jump, ←/→ (hover or focus) to step, swipe on
 * touch, optional autoplay with a progress fill. Respects prefers-reduced-motion.
 *
 * The whole frame is a `.zoomable`; each slide's `.zoom-trigger` expands the
 * frame to rail width via zoom.ts. Autoplay pauses (kills) while zoomed, via
 * the `zoomchange` event.
 */
interface MediaItem {
  type?: 'image' | 'video';
  src: string;
  poster?: string;
  caption?: string;
  alt?: string;
  /** Per-slide object-fit; falls back to the stepper `fit` prop. */
  fit?: 'contain' | 'cover';
  /** CSS object-position, e.g. `left top`. */
  position?: string;
  /** Extra crop-in for slides with too much negative space (e.g. `1.2`). */
  zoom?: number;
}

interface Props {
  items: MediaItem[];
  /** aria-label for the carousel region. */
  label?: string;
  /** false (default) | true (5000ms) | ms per slide. */
  autoplay?: number | boolean;
  /** CSS aspect-ratio for the frame. */
  aspect?: string;
  /** How images fill the frame. Prefer crops with built-in margin when using `cover`. */
  fit?: 'contain' | 'cover';
  /** Wrap image slides in zoom triggers (click to expand the frame). */
  zoomable?: boolean;
  /** Backdrop behind contained media (transparent window shots). */
  mat?: 'macos-dark';
}

const {
  items,
  label = 'Screenshots',
  autoplay = false,
  aspect = '4 / 3',
  fit = 'contain',
  zoomable = true,
  mat,
} = Astro.props;

const autoplayMs = autoplay === true ? 5000 : typeof autoplay === 'number' ? autoplay : null;
const count = items.length;
---
<figure
  class:list={['ms', 'zoomable', fit === 'cover' && 'ms--cover', mat === 'macos-dark' && 'ms--macos-dark']}
  data-stepper
  data-autoplay-ms={autoplayMs ?? undefined}
  aria-roledescription="carousel"
  aria-label={label}
  data-captions={JSON.stringify(items.map((item) => item.caption ?? ''))}
  style={`--ms-aspect: ${aspect};`}
>
  <div class="ms-frame" data-frame>
    {items.map((item, i) => {
      const slideFit = item.fit ?? fit;
      const zoom = item.zoom && item.zoom !== 1 ? item.zoom : null;
      const origin = item.position ?? 'center center';
      const mediaStyle = [
        `object-fit: ${slideFit === 'cover' ? 'contain' : slideFit}`,
        `object-position: ${origin}`,
        zoom
          ? `--ms-zoom: scale(${zoom}); transform: scale(${zoom}); transform-origin: ${origin}`
          : null,
      ]
        .filter(Boolean)
        .join('; ');
      return (
        <div class="ms-slide" data-slide data-active={i === 0 ? 'true' : undefined} aria-hidden={i === 0 ? 'false' : 'true'}>
          {item.type === 'video' ? (
            <div
              class="ms-video-shell zoom-trigger ms-trigger"
              role="button"
              tabindex={i === 0 ? 0 : -1}
              aria-label="Zoom video"
              aria-expanded="false"
            >
              <span class="ms-video-clip">
                <video
                  class="ms-video"
                  data-slide-video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={item.poster}
                  aria-label={item.alt ?? item.caption}
                  style={mediaStyle}
                >
                  <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
                </video>
              </span>
            </div>
          ) : zoomable ? (
            <button
              type="button"
              class="zoom-trigger ms-trigger"
              tabindex={i === 0 ? 0 : -1}
              aria-label="Zoom image"
              aria-expanded="false"
            >
              <img
                src={item.src}
                alt={item.alt ?? ''}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                style={mediaStyle}
              />
            </button>
          ) : (
            <img
              src={item.src}
              alt={item.alt ?? ''}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              style={mediaStyle}
            />
          )}
        </div>
      );
    })}

    {count > 1 && (
      <div class="ms-controls">
        <button type="button" class="ms-arrow" data-prev aria-label="Previous slide">
          <i class="ph-bold ph-caret-left" aria-hidden="true"></i>
        </button>

        <div class="ms-stepper" role="tablist" aria-label="Choose slide">
          {items.map((_, i) => (
            <button
              type="button"
              class="ms-dot"
              role="tab"
              data-dot
              data-index={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              aria-label={`Slide ${i + 1} of ${count}`}
            >
              <span class="ms-dot-fill" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <button type="button" class="ms-arrow" data-next aria-label="Next slide">
          <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
        </button>
      </div>
    )}
  </div>

  <figcaption class="ms-caption" data-caption aria-live="polite">{items[0]?.caption ?? ''}</figcaption>
</figure>

<style>
  .ms {
    /* Inline margins come from `.zoomable` / `.is-zoomed` — don't set them here.
       No width:100% either: that locks the box and stops negative-margin breakout. */
    margin-block: var(--space-4);
  }

  .ms-frame {
    position: relative;
    display: grid;
    aspect-ratio: var(--ms-aspect, 4 / 3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: pan-y;
    box-sizing: border-box;
  }

  /* Expanded: keep contain + center with mat padding */
  .ms.is-zoomed .ms-frame {
    aspect-ratio: 4 / 3;
    padding: clamp(1.25rem, 3.5vw, 2rem);
  }

  .ms.is-zoomed .ms-slide img,
  .ms.is-zoomed .ms-slide :global(.ms-trigger img),
  .ms.is-zoomed .ms-video {
    object-fit: contain;
    object-position: center center !important;
  }

  .ms-slide {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
    display: grid;
    opacity: 0;
    visibility: hidden;
    transform: translateX(var(--dir, 12px));
    transition:
      opacity 500ms var(--easing),
      transform 500ms var(--easing),
      visibility 0s 500ms;
  }

  .ms-slide[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 500ms var(--easing),
      transform 500ms var(--easing),
      visibility 0s 0s;
  }

  /* Slide content fills the frame, contained on the elevated mat */
  .ms-slide :global(.ms-trigger) {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 0;
  }

  .ms-slide img,
  .ms-slide :global(.ms-trigger img),
  .ms-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    background: none;
    border-radius: 0;
    transition: none;
  }

  /* Shell sizes to the letterboxed video so radius clips the window, not the mat */
  .ms-video-shell {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    padding: 18px 24px;
    box-sizing: border-box;
  }

  .ms.is-zoomed .ms-video-shell {
    padding: 0;
  }

  .ms-video-clip {
    display: block;
    max-width: 100%;
    max-height: 100%;
    line-height: 0;
    overflow: hidden;
    /* Browser-window-ish; Dinky (macos-dark) uses a larger app-window radius */
    border-radius: 0.7%;
  }

  .ms--macos-dark .ms-video-clip {
    /* Soft clip for square-cropped Dinky window */
    border-radius: 2.8%;
  }

  .ms-video-clip .ms-video {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: 0;
  }

  .ms--cover .ms-slide img,
  .ms--cover .ms-slide :global(.ms-trigger img),
  .ms--cover .ms-video {
    object-fit: contain;
    object-position: center center;
  }

  /* Don't let global lightbox hover lift override per-slide crop zoom */
  .ms-slide :global(.ms-trigger:hover img),
  .ms-slide :global(.ms-trigger:focus-visible img) {
    transform: var(--ms-zoom, none);
  }

  .ms-slide :global(.ms-trigger:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: -2px;
  }

  .ms-caption {
    margin: var(--space-2) 0 0;
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--muted-strong);
    text-align: center;
    text-wrap: pretty;
    min-height: 2.9em;
  }

  /* ---------- Pasito stepper — glass pill overlaid on the frame ---------- */
  .ms-controls {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow: var(--glass-shadow);
  }

  .ms-stepper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
  }

  .ms-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted-strong);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .ms-arrow:hover {
    color: var(--fg);
  }

  .ms-arrow:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .ms-dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 22%, transparent);
    cursor: pointer;
    overflow: hidden;
    transition:
      width 500ms var(--easing),
      background-color 300ms var(--easing);
  }

  /* ≥24px hit area without growing the visual dot */
  .ms-dot::after {
    content: '';
    position: absolute;
    inset: -9px;
  }

  .ms-dot:hover {
    background: color-mix(in srgb, var(--fg) 40%, transparent);
  }

  .ms-dot:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .ms-dot[aria-selected='true'] {
    width: 28px;
    background: color-mix(in srgb, var(--fg) 20%, transparent);
  }

  .ms-dot-fill {
    position: absolute;
    inset: 0;
    background: var(--fg);
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0);
  }

  .ms-dot[aria-selected='true'] .ms-dot-fill {
    transform: scaleX(1);
    transition: transform 300ms var(--easing);
  }

  .ms-dot[aria-selected='true'] .ms-dot-fill[data-filling] {
    transform: scaleX(0);
    transition: none;
    animation: ms-fill var(--ms-interval, 5000ms) linear forwards;
  }

  @keyframes ms-fill {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-slide,
    .ms-slide[data-active],
    .ms-dot,
    .ms-dot[aria-selected='true'] .ms-dot-fill {
      transition-duration: 0.01ms;
      animation: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initStepper(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const captionEl = root.querySelector<HTMLElement>('[data-caption]');
    const frame = root.querySelector<HTMLElement>('[data-frame]');
    if (slides.length < 2 || !frame) return;

    let slideCaptions: string[] = [];
    try {
      slideCaptions = JSON.parse(root.dataset.captions ?? '[]');
    } catch {
      slideCaptions = [];
    }

    let index = 0;
    let timer: number | null = null;
    let remaining = 0;
    let cycleStart = 0;
    let autoplayDead = false;

    const autoplayMs = reduceMotion ? null : Number(root.dataset.autoplayMs) || null;

    // Zooming the frame (zoom.ts) fires `zoomchange`; kill autoplay for good so
    // it never advances underneath an expanded frame.
    const zoomed = () => root.classList.contains('is-zoomed');

    function setSlideActive(slide: HTMLElement, active: boolean, dir: number) {
      slide.style.setProperty('--dir', `${dir * 12}px`);
      if (active) {
        slide.setAttribute('data-active', 'true');
        slide.setAttribute('aria-hidden', 'false');
      } else {
        slide.removeAttribute('data-active');
        slide.setAttribute('aria-hidden', 'true');
      }
      const trigger = slide.querySelector<HTMLElement>('.zoom-trigger');
      if (trigger) trigger.tabIndex = active ? 0 : -1;
      const video = slide.querySelector<HTMLVideoElement>('video');
      if (video) {
        if (active && !reduceMotion) {
          const p = video.play();
          if (p && p.catch) p.catch(() => {});
        } else {
          video.pause();
          if (reduceMotion) video.controls = true;
        }
      }
    }

    function goTo(next: number, opts: { focusDot?: boolean } = {}) {
      const n = slides.length;
      const target = ((next % n) + n) % n;
      if (target === index) return;
      const dir = target > index ? 1 : -1;
      setSlideActive(slides[index], false, -dir);
      setSlideActive(slides[target], true, dir);
      dots[index].setAttribute('aria-selected', 'false');
      dots[index].tabIndex = -1;
      dots[target].setAttribute('aria-selected', 'true');
      dots[target].tabIndex = 0;
      if (opts.focusDot) dots[target].focus();
      if (captionEl) captionEl.textContent = slideCaptions[target] ?? '';
      index = target;
      restartCycle();
    }

    /* ---------- autoplay (opt-in) ---------- */
    const activeFill = () => dots[index].querySelector<HTMLElement>('.ms-dot-fill');

    function startFill(ms: number) {
      const fill = activeFill();
      if (!fill) return;
      fill.removeAttribute('data-filling');
      void fill.offsetWidth;
      root.style.setProperty('--ms-interval', `${ms}ms`);
      fill.setAttribute('data-filling', 'true');
    }

    function restartCycle() {
      if (!autoplayMs || autoplayDead) return;
      if (timer) window.clearTimeout(timer);
      remaining = autoplayMs;
      cycleStart = Date.now();
      startFill(autoplayMs);
      timer = window.setTimeout(tick, autoplayMs);
    }

    function tick() {
      goTo(index + 1);
    }

    function pauseCycle() {
      if (!autoplayMs || autoplayDead || !timer) return;
      window.clearTimeout(timer);
      timer = null;
      remaining -= Date.now() - cycleStart;
      const fill = activeFill();
      if (fill) fill.style.animationPlayState = 'paused';
    }

    function resumeCycle() {
      if (!autoplayMs || autoplayDead || timer) return;
      cycleStart = Date.now();
      const fill = activeFill();
      if (fill) fill.style.animationPlayState = '';
      timer = window.setTimeout(tick, Math.max(remaining, 250));
    }

    function killAutoplay() {
      autoplayDead = true;
      if (timer) window.clearTimeout(timer);
      timer = null;
      const fill = activeFill();
      if (fill) fill.removeAttribute('data-filling');
    }

    /* ---------- events ---------- */
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        killAutoplay();
        goTo(i);
      });
    });

    root.querySelector<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => {
      killAutoplay();
      goTo(index - 1);
    });

    root.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => {
      killAutoplay();
      goTo(index + 1);
    });

    /* Arrow keys while this stepper is hovered, or (if none are) while focus
       is inside it — no need to tab to the dots first. */
    const editable = (el: Element | null) =>
      !!el?.closest('input, textarea, select, [contenteditable="true"]');

    const onArrowKey = (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (editable(document.activeElement)) return;

      const hoveredStepper = document.querySelector<HTMLElement>('[data-stepper]:hover');
      const focusInside = root.contains(document.activeElement);
      if (hoveredStepper) {
        if (hoveredStepper !== root) return;
      } else if (!focusInside) {
        return;
      }

      e.preventDefault();
      killAutoplay();
      goTo(index + (e.key === 'ArrowRight' ? 1 : -1), {
        focusDot: focusInside && !!document.activeElement?.closest('[role="tablist"]'),
      });
    };
    document.addEventListener('keydown', onArrowKey);

    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Home') {
        e.preventDefault();
        killAutoplay();
        goTo(0, { focusDot: true });
      } else if (key === 'End') {
        e.preventDefault();
        killAutoplay();
        goTo(slides.length - 1, { focusDot: true });
      }
    });

    /* Swipe: simple delta check, no drag-follow */
    let startX = 0;
    let startY = 0;
    frame.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    frame.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        killAutoplay();
        goTo(index + (dx < 0 ? 1 : -1));
      }
    });

    // Expanding the frame inline kills autoplay (matches "any interaction stops it").
    root.addEventListener('zoomchange', () => { if (zoomed()) killAutoplay(); });

    if (autoplayMs) {
      root.addEventListener('mouseenter', pauseCycle);
      root.addEventListener('mouseleave', resumeCycle);
      root.addEventListener('focusin', pauseCycle);
      root.addEventListener('focusout', (e) => {
        if (!root.contains((e as FocusEvent).relatedTarget as Node)) resumeCycle();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pauseCycle();
        else resumeCycle();
      });
      restartCycle();
    }

    // Videos in the initial slide state
    slides.forEach((slide, i) => setSlideActive(slide, i === 0, 1));
  }

  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach(initStepper);
</script>
