---
import Icon from '../Icon.astro';
/**
 * Framed aside above or inside a post.
 * - `audience` — "Assumed audience" (who this is for)
 * - `note` — general aside
 * - `update` — dated addendum after publication
 * - `outdated` — this post has been superseded
 */
interface Props {
  kind?: 'audience' | 'note' | 'update' | 'outdated';
  title?: string;
}

const { kind = 'note', title } = Astro.props;

const defaults = {
  audience: { title: 'Assumed audience', icon: 'users' },
  note: { title: 'Note', icon: 'note' },
  update: { title: 'Update', icon: 'refresh' },
  outdated: { title: 'Outdated', icon: 'history' },
} as const;

const { icon } = defaults[kind];
const label = title ?? defaults[kind].title;
---
<aside class={`callout callout--${kind}`} role="note">
  <p class="callout__label"><Icon name={icon} />{label}</p>
  <div class="callout__body"><slot /></div>
</aside>
