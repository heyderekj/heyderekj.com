---
/**
 * A moment from a YouTube video, as a small inline card: the speaker's face,
 * name and role, the show and episode, and a "Play from …" pill. Playing opens a lightbox with the player (youtube-nocookie) that
 * starts — and stops — on the moment; closing it stops the video. Without JS
 * the pill is a link to that time on YouTube.
 *
 * The face is cropped from one of the video's stills
 * (i.ytimg.com/vi/<id>/<frame>.jpg) with `face` = [width %, left %, top %].
 *
 *   <Clip id="u4DgD7C4F7A" start="24:07" end="27:38" date="2026-10-07"
 *     speaker="Corey Moen" role="Brand Designer, Anthropic"
 *     show="Restock" episode="Ep. 13: Packaging Matters"
 *     frame="hq1" face={[340, -55.4, -86.425]} />
 */
import Icon from '../Icon.astro';
import VideoBox from '../VideoBox.astro';

interface Props {
  /** YouTube video id. */
  id: string;
  /** "m:ss" or "h:mm:ss". */
  start: string;
  end?: string;
  speaker: string;
  role?: string;
  show: string;
  episode: string;
  /** When the video came out, YYYY-MM-DD. */
  date?: string;
  /** Which still to crop the face from: hqdefault, hq1, hq2, hq3. */
  frame?: string;
  /** Crop of that still: [width %, left %, top %]. */
  face?: [number, number, number];
  /** A line under the card. */
  caption?: string;
}

const { id, start, end, speaker, role, show, episode, date, frame = 'hqdefault', face, caption } = Astro.props;
const secs = (t: string) => t.split(':').map(Number).reduce((a, n) => a * 60 + n, 0);
const s = secs(start);
const e = end ? secs(end) : undefined;
const watch = `https://www.youtube.com/watch?v=${id}&t=${s}s`;
const embed = `https://www.youtube-nocookie.com/embed/${id}?start=${s}${e ? `&end=${e}` : ''}&autoplay=1&rel=0&modestbranding=1`;
const when = date
  ? new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : undefined;
const title = `${speaker} on ${show}, ${episode}`;
/* A fixed waveform: decoration, not data. */
const wave = [24, 40, 64, 48, 80, 56, 32, 72, 96, 64, 40, 56, 88, 48, 32, 64, 80, 40, 24, 48, 72, 56, 32, 40];
const [fw, fl, ft] = face ?? [100, 0, 0];
---

<figure class="pclip" data-no-zoom>
    <div class="pclip__card">
      <div class="pclip__head">
        <span class="pclip__face" aria-hidden="true">
          <img
            src={`https://i.ytimg.com/vi/${id}/${frame}.jpg`}
            alt=""
            loading="lazy"
            decoding="async"
            style={`width:${fw}%;left:${fl}%;top:${ft}%`}
          />
        </span>
        <span class="pclip__id">
          <span class="pclip__who">{speaker}</span>
          {role && <span class="pclip__role">{role}</span>}
        </span>
      </div>
      <p class="pclip__show">
        <span class="pclip__kicker">{show}{when && <> · <time datetime={date}>{when}</time></>}</span>
        {episode}
      </p>
      <a class="pclip__play" href={watch} target="_blank" rel="noopener" data-clip={embed} data-clip-title={title}>
        <span class="pclip__btn" aria-hidden="true"><Icon name="play" loop={false} /></span>
        <span class="pclip__label">Play from {start}</span>
        <span class="pclip__wave" aria-hidden="true">{wave.map((h) => <i style={`height:${h}%`}></i>)}</span>
        <span class="visually-hidden">: {title}</span>
      </a>
    </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<VideoBox />

<style>
  .pclip { margin: var(--space-4) 0; }

  .pclip__card {
    max-width: 26rem;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    corner-shape: squircle;
    background: var(--bg-elevated);
  }

  .pclip__head { display: flex; align-items: center; gap: 12px; }
  .pclip__face {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: 30%;
    corner-shape: squircle;
    background: var(--border-strong);
  }
  .pclip__face img {
    position: absolute;
    max-width: none;
    height: auto;
    margin: 0;
    border-radius: 0;
    filter: grayscale(1) contrast(1.05);
  }
  .pclip__id { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .pclip__who { font-size: var(--size-body); font-weight: 600; color: var(--fg); }
  .pclip__role { font-size: var(--size-meta); color: var(--muted-strong); }

  .pclip .pclip__show {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 14px 0 12px;
    font-size: var(--size-body);
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }
  .pclip__kicker {
    font-size: var(--size-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  main.main a.pclip__play,
  .pclip__play {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    color: var(--fg);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .pclip__play:hover { background: color-mix(in srgb, var(--fg) 10%, transparent); }
  .pclip__play:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .pclip__btn {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    font-size: 13px;
    transition: background-color 0.18s ease;
  }
  .pclip__btn :global(.icon) { transform: translateX(1px); }
  .pclip__play:hover .pclip__btn { background: var(--accent); }
  .pclip__label { font-size: var(--size-meta); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pclip__wave {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    height: 20px;
    min-width: 0;
    overflow: hidden;
  }
  .pclip__wave i {
    flex-shrink: 0;
    width: 3px;
    border-radius: 2px;
    background: var(--muted);
    opacity: 0.55;
    transition: background-color 0.18s ease, opacity 0.18s ease;
  }
  .pclip__play:hover .pclip__wave i { background: var(--accent); opacity: 0.8; }

  .pclip figcaption {
    max-width: 26rem;
    margin-top: var(--space-2);
    font-size: var(--size-meta);
    color: var(--muted-strong);
  }

  /* ---- Lightbox ---- */
</style>
