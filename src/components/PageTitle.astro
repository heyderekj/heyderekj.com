---
interface Props {
  /** Path-style title from the old layout, e.g. "/posts"; shown only when there's no `title`. */
  path: string;
  /** The page's name as a reader would say it, e.g. "About". */
  title?: string;
}

const { path, title } = Astro.props;
---
<div class="page-title">
  <h1 class="page-h">{title ?? path}</h1>
  <slot />
</div>
