---
import type { Testimonial } from '../data/about';

interface Props {
  testimonials: Testimonial[];
  heading?: string;
  headingId?: string;
}

const {
  testimonials,
  heading = 'Recommendations',
  headingId = 'testimonials-heading',
} = Astro.props;

const count = testimonials.length;
---

{
  count > 0 && (
    <section
      class="testimonial-carousel work-testimonials"
      aria-labelledby={headingId}
      data-testimonial-carousel
    >
      <div class="testimonial-carousel__header">
        <h2 id={headingId} class="section-title">
          {heading}
        </h2>
        {count > 1 && (
          <div class="testimonial-carousel__controls">
            <button
              type="button"
              class="testimonial-carousel__arrow"
              data-testimonial-prev
              aria-label="Previous recommendation"
            >
              <i class="ph-bold ph-caret-left" aria-hidden="true"></i>
            </button>

            <div
              class="testimonial-carousel__stepper"
              role="tablist"
              aria-label="Choose recommendation"
            >
              {testimonials.map((t, i) => (
                <button
                  type="button"
                  class="testimonial-carousel__dot"
                  role="tab"
                  data-testimonial-dot={i}
                  aria-label={`Show recommendation from ${t.author}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="testimonial-carousel__dot-fill" aria-hidden="true"></span>
                </button>
              ))}
            </div>

            <button
              type="button"
              class="testimonial-carousel__arrow"
              data-testimonial-next
              aria-label="Next recommendation"
            >
              <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
            </button>
          </div>
        )}
      </div>

      <div class="testimonial-carousel__viewport">
        <ul class="testimonial-carousel__track" role="list">
          {testimonials.map((t, i) => (
            <li
              class="work-testimonial-card testimonial-carousel__slide"
              data-testimonial-slide
              hidden={i !== 0}
            >
              <p class="work-testimonial-quote">{t.quote}</p>
              <footer class="work-testimonial-footer">
                <p class="work-testimonial-name">{t.author}</p>
                <p class="work-testimonial-role">{t.role}</p>
                <p class="work-testimonial-context">{t.context}</p>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  function initTestimonialCarousels() {
    document.querySelectorAll('[data-testimonial-carousel]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.testimonialInit) return;
      root.dataset.testimonialInit = '1';

      const slides = [...root.querySelectorAll<HTMLElement>('[data-testimonial-slide]')];
      if (slides.length < 2) return;

      const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')];
      const prev = root.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-testimonial-next]');

      let index = slides.findIndex((s) => !s.hidden);
      if (index < 0) index = 0;

      const show = (nextIndex: number, opts: { focusDot?: boolean } = {}) => {
        index = ((nextIndex % slides.length) + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.hidden = i !== index;
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
          dot.tabIndex = active ? 0 : -1;
        });
        if (opts.focusDot) dots[index]?.focus();
      };

      prev?.addEventListener('click', () => show(index - 1));
      next?.addEventListener('click', () => show(index + 1));

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => show(i));
      });

      root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'ArrowLeft') {
          e.preventDefault();
          show(index - 1, { focusDot: true });
        } else if (key === 'ArrowRight') {
          e.preventDefault();
          show(index + 1, { focusDot: true });
        } else if (key === 'Home') {
          e.preventDefault();
          show(0, { focusDot: true });
        } else if (key === 'End') {
          e.preventDefault();
          show(slides.length - 1, { focusDot: true });
        }
      });

      // Same hover/focus ←/→ pattern as the image stepper
      const editable = (el: Element | null) =>
        !!el?.closest('input, textarea, select, [contenteditable="true"]');

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        if (editable(document.activeElement)) return;

        const hovered = document.querySelector<HTMLElement>('[data-testimonial-carousel]:hover');
        const focusInside = root.contains(document.activeElement);
        if (hovered) {
          if (hovered !== root) return;
        } else if (!focusInside) {
          return;
        }

        e.preventDefault();
        show(index + (e.key === 'ArrowRight' ? 1 : -1), {
          focusDot: focusInside && !!document.activeElement?.closest('[role="tablist"]'),
        });
      });
    });
  }

  initTestimonialCarousels();
  document.addEventListener('astro:page-load', initTestimonialCarousels);
</script>

<style>
  .testimonial-carousel {
    margin-top: var(--space-6);
  }

  /* Title stays full-width so the section-title rule/ticks (100cqw math)
     aren’t computed from a shrink-wrapped label beside the controls. */
  .testimonial-carousel__header {
    position: relative;
    display: block;
    margin-bottom: var(--space-3);
  }

  .testimonial-carousel.work-testimonials .testimonial-carousel__header .section-title {
    margin: 0;
    width: 100%;
    min-width: 0;
    /* Keep label clear of the pill */
    padding-right: 9.5rem;
    box-sizing: border-box;
  }

  /* Pasito-style glass pill — same language as MediaStepper controls.
     Sit in the label row (below the rule), vertically centered with the text. */
  .testimonial-carousel__controls {
    position: absolute;
    right: 0;
    top: var(--space-4);
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 4px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow: var(--glass-shadow);
  }

  .testimonial-carousel__stepper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
  }

  .testimonial-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted-strong);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .testimonial-carousel__arrow:hover {
    color: var(--fg);
  }

  .testimonial-carousel__arrow:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .testimonial-carousel__dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 22%, transparent);
    cursor: pointer;
    overflow: hidden;
    transition:
      width 500ms var(--easing),
      background-color 300ms var(--easing);
  }

  .testimonial-carousel__dot::after {
    content: '';
    position: absolute;
    inset: -9px;
  }

  .testimonial-carousel__dot:hover {
    background: color-mix(in srgb, var(--fg) 40%, transparent);
  }

  .testimonial-carousel__dot:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .testimonial-carousel__dot[aria-selected='true'] {
    width: 28px;
    background: color-mix(in srgb, var(--fg) 20%, transparent);
  }

  .testimonial-carousel__dot-fill {
    position: absolute;
    inset: 0;
    background: var(--fg);
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0);
  }

  .testimonial-carousel__dot[aria-selected='true'] .testimonial-carousel__dot-fill {
    transform: scaleX(1);
    transition: transform 300ms var(--easing);
  }

  .testimonial-carousel__track {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .testimonial-carousel__slide {
    margin: 0;
  }

  .testimonial-carousel__slide[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-carousel__dot,
    .testimonial-carousel__dot[aria-selected='true'] .testimonial-carousel__dot-fill {
      transition: none;
    }
  }
</style>
