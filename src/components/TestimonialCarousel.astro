---
import type { Testimonial } from '../data/about';

interface Props {
  testimonials: Testimonial[];
  heading?: string;
  headingId?: string;
}

const {
  testimonials,
  heading = 'Recommendations',
  headingId = 'testimonials-heading',
} = Astro.props;

const count = testimonials.length;
---

{
  count > 0 && (
    <section
      class="testimonial-carousel work-testimonials"
      aria-labelledby={headingId}
      data-testimonial-carousel
    >
      <div class="testimonial-carousel__header">
        <h2 id={headingId} class="section-title">
          {heading}
        </h2>
        {count > 1 && (
          <div class="testimonial-carousel__controls">
            <button
              type="button"
              class="testimonial-carousel__btn"
              data-testimonial-prev
              aria-label="Previous recommendation"
            >
              <i class="ph-bold ph-caret-left" aria-hidden="true"></i>
            </button>
            <p class="testimonial-carousel__status" data-testimonial-status aria-live="polite">
              <span data-testimonial-current>1</span> / {count}
            </p>
            <button
              type="button"
              class="testimonial-carousel__btn"
              data-testimonial-next
              aria-label="Next recommendation"
            >
              <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
            </button>
          </div>
        )}
      </div>

      <div class="testimonial-carousel__viewport">
        <ul class="testimonial-carousel__track" role="list">
          {testimonials.map((t, i) => (
            <li
              class="work-testimonial-card testimonial-carousel__slide"
              data-testimonial-slide
              hidden={i !== 0}
            >
              <p class="work-testimonial-quote">{t.quote}</p>
              <footer class="work-testimonial-footer">
                <p class="work-testimonial-name">{t.author}</p>
                <p class="work-testimonial-role">{t.role}</p>
                <p class="work-testimonial-context">{t.context}</p>
              </footer>
            </li>
          ))}
        </ul>
      </div>

      {count > 1 && (
        <div class="testimonial-carousel__dots" role="tablist" aria-label="Recommendation slides">
          {testimonials.map((t, i) => (
            <button
              type="button"
              class="testimonial-carousel__dot"
              role="tab"
              data-testimonial-dot={i}
              aria-label={`Show recommendation from ${t.author}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            />
          ))}
        </div>
      )}
    </section>
  )
}

<script>
  function initTestimonialCarousels() {
    document.querySelectorAll('[data-testimonial-carousel]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.testimonialInit) return;
      root.dataset.testimonialInit = '1';

      const slides = [...root.querySelectorAll<HTMLElement>('[data-testimonial-slide]')];
      if (slides.length < 2) return;

      const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')];
      const prev = root.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-testimonial-next]');
      const currentEl = root.querySelector('[data-testimonial-current]');

      let index = slides.findIndex((s) => !s.hidden);
      if (index < 0) index = 0;

      const show = (nextIndex: number) => {
        index = ((nextIndex % slides.length) + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.hidden = i !== index;
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
          dot.tabIndex = active ? 0 : -1;
        });
        if (currentEl) currentEl.textContent = String(index + 1);
      };

      prev?.addEventListener('click', () => show(index - 1));
      next?.addEventListener('click', () => show(index + 1));

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => show(i));
      });

      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          show(index - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          show(index + 1);
        }
      });
    });
  }

  initTestimonialCarousels();
  document.addEventListener('astro:page-load', initTestimonialCarousels);
</script>

<style>
  .testimonial-carousel {
    margin-top: var(--space-6);
  }

  .testimonial-carousel__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-3);
    row-gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .testimonial-carousel__header .section-title {
    margin: 0;
    min-width: 0;
  }

  .testimonial-carousel__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    align-self: center;
  }

  .testimonial-carousel__status {
    margin: 0;
    min-width: 2.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .testimonial-carousel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    color: var(--muted-strong);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .testimonial-carousel__btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: var(--accent-soft);
  }

  .testimonial-carousel__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .testimonial-carousel__btn i {
    font-size: 14px;
  }

  .testimonial-carousel__track {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .testimonial-carousel__slide {
    margin: 0;
  }

  .testimonial-carousel__slide[hidden] {
    display: none;
  }

  .testimonial-carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .testimonial-carousel__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--border-strong);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .testimonial-carousel__dot[aria-selected='true'] {
    background: var(--accent);
    transform: scale(1.15);
  }

  .testimonial-carousel__dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-color-scheme: dark) {
    .testimonial-carousel__btn {
      background: var(--bg-elevated);
    }
  }
</style>
