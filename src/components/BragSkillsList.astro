---
interface Props {
  skills: string[];
  /** Visually hidden heading for screen readers */
  label?: string;
}

const { skills, label = 'Skills' } = Astro.props;
---
<section class="brag-skills" aria-label={label}>
  <h2 class="sr-only">{label}</h2>
  <ul class="brag-skills__list" role="list">
    {skills.map((skill) => (
      <li class="brag-skills__item">
        <i class="ph-bold ph-check" aria-hidden="true"></i>
        <span>{skill}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .brag-skills {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .brag-skills__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .brag-skills__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--size-meta);
    line-height: 1.45;
    color: var(--fg-soft);
  }

  .brag-skills__item i {
    flex-shrink: 0;
    margin-top: 0.15em;
    font-size: 0.95em;
    color: var(--fg);
  }

  @media (max-width: 540px) {
    .brag-skills__list {
      grid-template-columns: 1fr;
    }
  }
</style>
