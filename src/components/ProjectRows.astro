---
/**
 * Compact project rows: small thumb, name, tagline, status chip (none for `paused`:
 * those are shipped apps, not necessarily stopped).
 * Used for "Also building" on the homepage and the more-projects apps on /projects.
 */
import type { CollectionEntry } from 'astro:content';
import { imgAttrs } from '../lib/img';
import { displayProjectStatus } from '../lib/projectStatus';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---
<ul class="project-rows">
  {projects.map((project) => {
    const thumb = project.data.icon ?? project.data.image;
    return (
      <li>
        <a href={`/projects/${project.slug}/`} class="project-row">
          <span class="project-row__thumb">
            {thumb ? (
              <img
                {...imgAttrs(thumb, { sizes: '44px', widths: [96, 160], w: 96, dims: false })}
                alt=""
                class={project.data.icon ? 'is-icon' : undefined}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span aria-hidden="true">{project.data.name[0]}</span>
            )}
          </span>
          <span class="project-row__text">
            <span class="project-row__name">{project.data.name}</span>
            <span class="project-row__tagline">{project.data.tagline}</span>
          </span>
          {project.data.status !== 'paused' && (
            <span class="chip chip--status" data-status={project.data.status}>
              {displayProjectStatus(project.data.status)}
            </span>
          )}
        </a>
      </li>
    );
  })}
</ul>

<style>
  .project-rows {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    gap: 2px;
  }
  .project-rows li { margin: 0 calc(var(--space-2) * -1); }
  :global(main.main) .project-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  :global(main.main) .project-row:hover {
    background: var(--bg-elevated);
    border-color: var(--border);
  }
  .project-row__thumb {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--muted);
  }
  .project-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  .project-row__thumb img.is-icon { object-fit: contain; }
  .project-row__text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .project-row__name { font-weight: 600; color: var(--fg); line-height: 1.3; }
  .project-row__tagline {
    font-size: var(--size-meta);
    color: var(--fg-soft);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    :global(main.main) .project-row { grid-template-columns: 44px minmax(0, 1fr); }
    .project-row .chip { display: none; }
  }
</style>
