---
/** Everything in <head> for both layouts: SEO, social cards, JSON-LD, fonts, analytics. */
import type { ImgVariant } from '../lib/img';

export interface Props {
  title?: string;
  description?: string;
  /** Path under `public/` (~1200×630). Defaults to `/derekj-og.png`; override per page if needed. */
  ogImage?: string;
  canonical?: string;
  /** Open Graph type; use `article` for blog posts. */
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** Schema.org nodes (merged into a single JSON-LD `@graph`). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true, adds `noindex` so the page is omitted from search indexes (e.g. 404). */
  noindex?: boolean;
  /** When false, omits Fathom (e.g. 404s so non-existent URL hits do not pollute “top content”). */
  includeAnalytics?: boolean;
  /** High-priority images to `<link rel="preload">` (LCP / first media).
   *  Pass the same variant the `<img>` uses (src + srcset + sizes) so it isn't fetched twice. */
  preloadImages?: (string | ImgVariant | undefined)[];
}

const {
  title = 'Derek Castelli',
  description =
    'Agentic design engineer, still making sites full-time. Writing on faith and technology.',
  ogImage = '/derekj-og.png',
  canonical,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  jsonLd,
  noindex = false,
  includeAnalytics = true,
  preloadImages = [],
} = Astro.props;

const preloadVariants = [
  ...new Map(
    preloadImages
      .filter((p): p is string | ImgVariant => Boolean(p))
      .map((p) => (typeof p === 'string' ? { src: p } : p))
      .map((v) => [v.src, v] as const),
  ).values(),
];

const siteUrl = Astro.site?.toString() ?? 'https://heyderekj.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
/** The default card and the drawn ones (pages/og) are all 1200 × 630 */
const knownSize = ogImage === '/derekj-og.png' || ogImage.startsWith('/og/');

const ldExtra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldGraph = ldExtra.length > 0 ? { '@context': 'https://schema.org', '@graph': ldExtra } : null;
const ldJson = ldGraph ? JSON.stringify(ldGraph).replace(/</g, '\\u003c') : '';

---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content="Derek Castelli" />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Derek Castelli" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
{knownSize && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
<meta property="og:image:alt" content={title} />
{articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@heyderekj" />
<meta name="twitter:creator" content="@heyderekj" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" href="/brand/gear.svg" type="image/svg+xml" />
<link rel="icon" href="/brand/gear-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/brand/gear-touch.png" />
<link rel="alternate" type="application/rss+xml" title="Derek Castelli" href="/rss.xml" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

{ldJson && (
  <script type="application/ld+json" set:html={ldJson} />
)}

<!-- Figtree, one family for everything -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

{preloadVariants.map((v) => (
  <link
    rel="preload"
    as="image"
    href={v.src}
    imagesrcset={v.srcset}
    imagesizes={v.srcset ? v.sizes : undefined}
    fetchpriority="high"
  />
))}

{includeAnalytics && (
  <script src="https://cdn.usefathom.com/script.js" data-site="RILZSZAQ" defer is:inline></script>
)}
<slot />
