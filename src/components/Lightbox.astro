---
/**
 * Shared image lightbox. Drop one instance per page.
 *
 * Triggers are any `.work-lightbox-trigger` elements on the page — the URL list
 * is built from them in DOM order at init (`data-lb-src`, falling back to the
 * wrapped <img> src). Pass `srcs` to control the order explicitly; triggers can
 * then point into it with `data-lb-index`.
 */
interface Props {
  srcs?: string[];
}

const { srcs = null } = Astro.props;
---
<div
  id="work-lightbox"
  class="work-lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Image gallery"
>
  <div class="work-lightbox__backdrop" data-lb-backdrop tabindex="-1" />
  <div class="work-lightbox__content">
    <button type="button" class="work-lightbox__close" data-lb-close aria-label="Close">
      <span class="work-lightbox__close-icon" aria-hidden="true">×</span>
    </button>
    <button
      type="button"
      class="work-lightbox__nav work-lightbox__prev"
      data-lb-prev
      aria-label="Previous image"
    >
      ‹
    </button>
    <button
      type="button"
      class="work-lightbox__nav work-lightbox__next"
      data-lb-next
      aria-label="Next image"
    >
      ›
    </button>
    <p class="work-lightbox__count" data-lb-count aria-live="polite" />
    <div class="work-lightbox__frame">
      <img class="work-lightbox__img" data-lb-img src="" alt="Full size preview" width="1" height="1" />
    </div>
  </div>
</div>

<script define:vars={{ providedSrcs: srcs }}>
  (() => {
    const root = document.getElementById('work-lightbox');
    if (!root || root.dataset.lbReady) return;
    root.dataset.lbReady = 'true';

    const backdrop = root.querySelector('[data-lb-backdrop]');
    const closeBtn = root.querySelector('[data-lb-close]');
    const prevBtn = root.querySelector('[data-lb-prev]');
    const nextBtn = root.querySelector('[data-lb-next]');
    const img = root.querySelector('[data-lb-img]');
    const countEl = root.querySelector('[data-lb-count]');
    if (!img) return;

    const triggers = Array.from(document.querySelectorAll('.work-lightbox-trigger'));

    const triggerSrc = (btn) => {
      const explicit = btn.getAttribute('data-lb-src');
      if (explicit) return explicit;
      const inner = btn.querySelector('img');
      return inner ? inner.getAttribute('src') : null;
    };

    let urls;
    if (providedSrcs && providedSrcs.length) {
      urls = providedSrcs;
    } else {
      urls = [];
      triggers.forEach((btn) => {
        const src = triggerSrc(btn);
        if (src && !urls.includes(src)) urls.push(src);
      });
    }
    if (!urls.length) return;

    const multiple = urls.length > 1;
    if (!multiple) {
      if (prevBtn) prevBtn.hidden = true;
      if (nextBtn) nextBtn.hidden = true;
      if (countEl) countEl.hidden = true;
    }

    let index = 0;
    let lastActive = null;

    function setUrl(i) {
      index = (i + urls.length) % urls.length;
      img.src = urls[index];
      img.removeAttribute('srcset');
      if (countEl && multiple) countEl.textContent = `${index + 1} / ${urls.length}`;
    }

    function open(at) {
      lastActive = document.activeElement;
      setUrl(at);
      root.removeAttribute('hidden');
      document.body.classList.add('work-lightbox-open');
      setTimeout(function () {
        if (closeBtn && closeBtn.focus) closeBtn.focus();
      }, 0);
    }

    function close() {
      root.setAttribute('hidden', '');
      document.body.classList.remove('work-lightbox-open');
      if (lastActive && lastActive.focus) lastActive.focus();
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const explicit = btn.getAttribute('data-lb-index');
        let i = explicit == null ? NaN : parseInt(explicit, 10);
        if (Number.isNaN(i)) {
          const src = triggerSrc(btn);
          i = src ? urls.indexOf(src) : 0;
        }
        open(i < 0 ? 0 : i);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);
    if (prevBtn) prevBtn.addEventListener('click', function () { setUrl(index - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { setUrl(index + 1); });

    root.addEventListener('click', function (e) {
      if (e.target === root) close();
    });

    document.addEventListener('keydown', function (e) {
      if (root.hasAttribute('hidden')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowLeft' && multiple) {
        e.preventDefault();
        setUrl(index - 1);
      } else if (e.key === 'ArrowRight' && multiple) {
        e.preventDefault();
        setUrl(index + 1);
      }
    });
  })();
</script>
