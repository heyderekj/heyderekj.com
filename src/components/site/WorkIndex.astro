---
/**
 * Every website write-up by year, like the writing on the home page, each with a small thumbnail of
 * the site (cropped to its screen). Hover a row to see it bigger in the margin (client/peek.ts). Partner chips narrow it to the work done with a studio.
 */
import { getPublishedWork, partnerHref, partnersOf, type Work } from '../../lib/work';
import { frameAttrs, host, pageOf, shot, shotsOf, workDate } from '../../lib/deck';

interface Props { work: Work[]; active?: string }
const { work, active } = Astro.props;
const all = await getPublishedWork();
const partners = partnersOf(all);
const solo = all.filter((w) => !w.data.partnership?.trim()).length;
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const rows = await Promise.all([...work].sort((a, b) => workDate(b).valueOf() - workDate(a).valueOf()).map(async (w) => {
  const done = workDate(w), first = shotsOf(w)[0];
  return {
    thumb: first ? await pageOf(first, 320) : undefined,
    href: `/work/${w.slug}/`, title: w.data.title, year: done.getUTCFullYear(), date: `${MON[done.getUTCMonth()]}`,
    sub: [w.data.partnership ? `With ${w.data.partnership}` : 'Solo', w.data.workType].filter(Boolean).join(' · '),
    img: first ? shot(first, 640) : undefined, url: host(w.data.liveLink ?? w.data.waybackUrl),
  };
}));
const years = [...new Set(rows.map((r) => r.year))];
---
<nav class="work-chips" aria-label="Filter by studio">
  <a class:list={['wchip sq', !active && 'is-current']} href="/work/" aria-current={!active ? 'page' : undefined}>All <span>{all.length}</span></a>
  <a class:list={['wchip sq', active === 'solo' && 'is-current']} href="/work/solo/" aria-current={active === 'solo' ? 'page' : undefined} data-tip="Under Derek J Design" aria-describedby="soloTip">Solo <span>{solo}</span></a>
  {partners.map((p) => (
    <a class:list={['wchip sq', active === p.slug && 'is-current']} href={partnerHref(p.name)} aria-current={active === p.slug ? 'page' : undefined}>{p.name} <span>{p.count}</span></a>
  ))}
</nav>
<span id="soloTip" hidden>Under Derek J Design</span>
<div class="list">
  {years.map((y) => (
    <section class="list__year">
      <h2>{y}</h2>
      {rows.filter((r) => r.year === y).map((r) => (
        <a class="row row--thumb sq" href={r.href} data-peek-img={r.img} data-peek-url={r.url || undefined}>
          <span class="row__thumb sq" aria-hidden="true">{r.thumb && 'src' in r.thumb && <img src={r.thumb.src} alt="" class={frameAttrs(r.thumb).class} style={frameAttrs(r.thumb).style} loading="lazy" decoding="async" />}</span>
          <span class="row__title">{r.title}</span>
          <span class="row__date">{r.date}</span>
          <span class="row__desc">{r.sub}</span>
        </a>
      ))}
    </section>
  ))}
</div>
<div class="peek sq" id="peek" aria-hidden="true"></div>
<script src="../../client/peek.ts"></script>
