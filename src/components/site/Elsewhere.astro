---
/**
 * How to reach me, as one quiet line at the end of a page. The address copies on click
 * (client/bar.ts); the bar's menu has the same links.
 */
interface Props { linkedin?: boolean }
const { linkedin = false } = Astro.props;
const links = [
  { label: 'X', href: 'https://x.com/heyderekj' },
  { label: 'GitHub', href: 'https://github.com/heyderekj' },
  ...(linkedin ? [{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/heyderekj' }] : []),
  { label: 'RSS', href: '/rss.xml' },
];
---
<footer class="endnote">
  <a href="mailto:derekj@hey.com" data-copy-email title="Copy my email">derekj@hey.com</a>
  {links.map((l) => <><span aria-hidden="true">·</span><a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></>)}
</footer>
