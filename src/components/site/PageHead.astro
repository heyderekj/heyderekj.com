---
/** The top of a page, set like an essay: a small meta line (with a way back up, components/site/Back.astro), the
 *  title, and a lede. A slot goes after the lede. */
import Back from './Back.astro';
interface Props { meta?: string; title: string; lede?: string; back?: { href: string; label: string } }
const { meta, title, lede, back } = Astro.props;
---
<header class="page-head">
  <div class="essay__meta"><Back {...back} />{meta && <span>{meta}</span>}</div>
  <h1>{title}</h1>
  {(lede || Astro.slots.has('lede')) && <p class="lede">{lede}<slot name="lede" /></p>}
  <slot />
</header>
