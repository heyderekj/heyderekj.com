---
/**
 * "From websites to apps": one project per slide, a big preview with its pages on a rail beside it.
 * Projects stack in place and change with a staggered entrance; autoplay moves between them,
 * and the rail is yours to browse (client/deck.ts). The header runs down the side as a spine.
 */
import Icon from '../Icon.astro';
import Browser from './Browser.astro';
import { getDeck } from '../../lib/deck';

const { slides } = await getDeck();
---
<figure class="fig sq" id="fig-deck" data-bar-label="Work" tabindex="-1">
  <div class="fig__head">
    <span class="fig__no">WORK</span>
    <span class="fig__title deck__title" role="group" aria-label="Jump to">From <button data-jump="client" aria-pressed="true">websites</button> to <button data-jump="app" aria-pressed="false">apps</button></span>
    <span class="deck__nav">
      <button id="deckPlay" aria-label="Pause" aria-pressed="true">
        <svg class="deck__ring" viewBox="0 0 26 26" aria-hidden="true"><circle cx="13" cy="13" r="11.5" pathLength="100" id="deckBar" /></svg>
        <svg class="icon i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3.5" width="2.6" height="9" rx="1" /><rect x="9.4" y="3.5" width="2.6" height="9" rx="1" /></svg>
        <svg class="icon i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.2 3.6c0-.7.8-1.1 1.4-.7l6 4.4c.5.4.5 1.1 0 1.4l-6 4.4c-.6.4-1.4 0-1.4-.7z" /></svg>
      </button>
      <button id="deckPrev" aria-label="Previous project"><Icon name="chevron-left" /></button>
      <output id="deckCount">1 / {slides.length}</output>
      <button id="deckNext" aria-label="Next project"><Icon name="chevron-right" /></button>
    </span>
  </div>
  <div class="fig__stage">
    <div class="deck__track" id="deckTrack">
      {slides.map((s, i) => (
        <section class:list={['wslide', i === 0 && 'is-on']} data-kind={s.kind} data-title={s.title} data-partner={s.partner ?? ''} aria-label={`${i + 1} of ${slides.length}: ${s.title}`}>
          <Browser pages={s.pages} url={s.url} deck eager={i === 0} />
          {s.pages.length > 1 && (
            <div class="pages" role="group" aria-label={`${s.title} pages`}>
              {s.pages.map((p, n) => (
                <button class="sq" data-page-to={n} aria-current={n === 0 ? 'true' : 'false'} aria-label={`Page ${n + 1}`} style={`--n:${n}`}>
                  {'mesh' in p ? <span class="mesh" data-mesh={p.mesh}><img src={p.icon} alt="" /></span> : <img src={p.src} alt="" loading="lazy" decoding="async" />}
                </button>
              ))}
            </div>
          )}
          <div class="wslide__cap">
            <b>{s.title}</b><span>{s.sub}</span>
            <a href={s.link.href} {...(s.link.external ? { target: '_blank', rel: 'noopener' } : {})}>{s.link.label}</a>
          </div>
        </section>
      ))}
    </div>
  </div>
</figure>
